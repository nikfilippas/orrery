      "aliases": "global/claude-models.json",
      "summary": "Classifies every request, plans, delegates bounded work, inspects each diff itself, runs verification, and owns the outcome.",
      "selects": "The default Claude Code model for new sessions. Repositories can override it with claude-codex-init <alias>, and a running session with /model.",
