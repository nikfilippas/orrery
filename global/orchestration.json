      "title": "Mechanical worker",
      "provider": "openai",
      "model": "gpt-5.6-luna",
      "thinking": "low",
      "access": "workspace-write",
      "summary": "Handles narrow, repetitive, well-specified edits and boilerplate in a separate process.",
      "selects": "The provider, model, and thinking level used by orrery-agent --role mechanic."
    },
    {
      "id": "implementer",
      "title": "Implementation worker",
      "provider": "openai",
      "model": "gpt-5.6-terra",
      "thinking": "medium",
      "access": "workspace-write",
      "summary": "Handles contained features, real bug fixes, and coherent multi-file implementation tasks in a separate process.",
      "selects": "The provider, model, and thinking level used by orrery-agent --role implementer."
    },
    {
      "id": "plan-reviewer",
