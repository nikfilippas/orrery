    {
      "id": "luna",
      "title": "Mechanical worker",
      "provider": "openai",
      "kind": "codex-profile",
      "file": "global/codex/luna.config.toml",
      "expected_effort": "low",
      "summary": "The mechanical worker: narrow, repetitive, well-specified edits and boilerplate.",
      "selects": "The Codex model behind the luna profile. Its low reasoning effort defines the role and is not configurable.",
      "profile": "luna"
    },
    {
      "id": "terra",
      "title": "Implementer",
      "provider": "openai",
      "kind": "codex-profile",
      "file": "global/codex/terra.config.toml",
      "expected_effort": "medium",
      "summary": "The implementation worker: contained features, real bug fixes, multi-file changes, one bounded task per run.",
      "selects": "The Codex model behind the terra profile. Its medium reasoning effort defines the role and is not configurable.",
      "profile": "terra"
    },
    {
      "id": "vesta",
      "title": "Plan reviewer",
      "provider": "openai",
      "kind": "codex-profile",
      "file": "global/codex/vesta.config.toml",
      "expected_effort": "high",
      "summary": "The plan reviewer: challenges a plan before any code is written, when the work is complex or high-risk.",
      "selects": "The Codex model behind the vesta profile. Reviewing foundations is cheaper than reviewing consequences, so this may be set independently of the final reviewer.",
      "profile": "vesta"
    },
    {
      "id": "sol",
      "title": "Final reviewer",
      "provider": "openai",
      "kind": "codex-profile",
      "file": "global/codex/sol.config.toml",
      "expected_effort": "high",
      "summary": "The final reviewer: fresh read-only sessions that review completed work, and difficult diagnosis.",
      "selects": "The Codex model behind the sol profile, used for the review that gates completion.",
      "profile": "sol"
    }
  ],
