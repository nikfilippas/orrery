{
  "steps": [
    {
      "id": "orchestrator",
      "title": "Principal orchestrator",
      "provider": "anthropic",
      "model": "fable",
      "thinking": "max",
      "access": "principal",
      "summary": "Classifies every request, plans, delegates bounded work, inspects each diff itself, runs verification, and owns the outcome.",
      "selects": "The provider, model, and thinking level used when a new principal session is started with orrery.",
      "shared_note": "One continuous principal session runs every orchestrator step, so these nodes necessarily share a model."
    },
    {
      "id": "mechanic",
      "title": "Mechanical worker",
      "provider": "openai",
      "model": "gpt-5.6-luna",
      "thinking": "low",
      "access": "workspace-write",
      "summary": "Handles narrow, repetitive, well-specified edits and boilerplate in a separate process.",
      "selects": "The provider, model, and thinking level used by orrery-agent --role mechanic."
    },
    {
      "id": "implementer",
      "title": "Implementation worker",
      "provider": "openai",
      "model": "gpt-5.6-terra",
      "thinking": "medium",
      "access": "workspace-write",
      "summary": "Handles contained features, real bug fixes, and coherent multi-file implementation tasks in a separate process.",
      "selects": "The provider, model, and thinking level used by orrery-agent --role implementer."
    },
    {
      "id": "plan-reviewer",
      "title": "Plan reviewer",
      "provider": "openai",
      "model": "gpt-5.6-sol",
      "thinking": "ultra",
      "access": "read-only",
      "summary": "Challenges a complex or high-risk plan in a fresh, read-only process before code is written.",
      "selects": "The provider, model, and thinking level used by orrery-agent --role plan-reviewer."
    },
    {
      "id": "reviewer",
      "title": "Final reviewer",
      "provider": "openai",
      "model": "gpt-5.6-sol",
      "thinking": "ultra",
      "access": "read-only",
      "summary": "Reviews finished work or difficult diagnoses in a fresh, read-only process.",
      "selects": "The provider, model, and thinking level used by orrery-agent --role reviewer."
    }
  ],
