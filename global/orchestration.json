{
  "steps": [
    {
      "id": "orchestrator",
      "title": "Principal orchestrator",
      "provider": "anthropic",
      "kind": "claude-settings",
      "file": "global/claude-settings.json",
      "summary": "Classifies every request, plans, delegates bounded work, inspects each diff itself, runs verification, and owns the outcome.",
      "selects": "The default Claude Code model and thinking level for new sessions. Repositories can override the model with orrery-init <alias>, and a running session with /model.",
      "shared_note": "One continuous session runs every orchestrator step, so they necessarily share a model."
    },
    {
      "id": "mechanic",
      "title": "Mechanical worker",
      "provider": "openai",
      "kind": "codex-profile",
      "file": "global/codex/mechanic.config.toml",
      "summary": "The mechanical worker: narrow, repetitive, well-specified edits and boilerplate.",
      "selects": "The Codex model and thinking level behind the mechanic profile.",
      "profile": "mechanic"
    },
    {
      "id": "implementer",
      "title": "Implementer",
      "provider": "openai",
      "kind": "codex-profile",
      "file": "global/codex/implementer.config.toml",
      "summary": "The implementation worker: contained features, real bug fixes, multi-file changes, one bounded task per run.",
      "selects": "The Codex model and thinking level behind the implementer profile.",
      "profile": "implementer"
    },
    {
      "id": "plan-reviewer",
      "title": "Plan reviewer",
      "provider": "openai",
      "kind": "codex-profile",
      "file": "global/codex/plan-reviewer.config.toml",
      "summary": "The plan reviewer: challenges a plan before any code is written, when the work is complex or high-risk.",
      "selects": "The Codex model and thinking level behind the plan-reviewer profile. Reviewing foundations is cheaper than reviewing consequences, so this may be set independently of the final reviewer.",
      "profile": "plan-reviewer"
    },
    {
      "id": "reviewer",
      "title": "Final reviewer",
      "provider": "openai",
      "kind": "codex-profile",
      "file": "global/codex/reviewer.config.toml",
      "summary": "The final reviewer: fresh read-only sessions that review completed work, and difficult diagnosis.",
      "selects": "The Codex model and thinking level behind the reviewer profile, used for the review that gates completion.",
      "profile": "reviewer"
    }
  ],
