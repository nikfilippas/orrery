#!/usr/bin/env python3
"""Stand-in for the Codex CLI used by the kit regression tests.

Behaviour is selected with CODEX_FAKE_MODE so that the review wrapper can be
exercised without spending Codex credits or reaching the network.
"""

from __future__ import annotations

import os
import json
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path


def output_path(argv: list[str]) -> Path | None:
    for index, argument in enumerate(argv):
        if argument == "--output-last-message" and index + 1 < len(argv):
            return Path(argv[index + 1])
    return None


def effort(level: str) -> dict[str, str]:
    return {"reasoningEffort": level, "description": level}


def emit_usage() -> None:
    """Speak the `turn.completed` event the real CLI emits under --json.

    Suppressible, because a provider that reports nothing must leave a
    named gap rather than a zero, and that path needs a test too.
    """
    if "--json" not in sys.argv or os.environ.get("CODEX_FAKE_NO_USAGE"):
        return
    raw = os.environ.get("CODEX_FAKE_USAGE")
    usage = (
        json.loads(raw)
        if raw
        else {
            "input_tokens": 1200,
            "cached_input_tokens": 200,
            "output_tokens": 300,
            "reasoning_output_tokens": 50,
        }
    )
    print(json.dumps({"type": "turn.completed", "usage": usage}), flush=True)


def emit_loop() -> None:
    """Emit genuine-shaped failed command executions across poll turns."""
    delay = float(os.environ.get("CODEX_FAKE_LOOP_DELAY", "0.2"))
    for number in range(4):
        identifier = f"cmd-loop-{number}"
        item = {
            "id": identifier, "type": "command_execution", "command": "false",
            "aggregated_output": "command failed: loop failure", "exit_code": 1,
            "status": "failed",
        }
        print(json.dumps({"type": "item.started", "item": item}), flush=True)
        print(json.dumps({"type": "item.completed", "item": item}), flush=True)
        time.sleep(delay)


def emit_error_loop() -> None:
    """Different commands which retain one meaningful error class."""
    delay = float(os.environ.get("CODEX_FAKE_LOOP_DELAY", "0.08"))
    for number in range(4):
        item = {
            "id": f"cmd-error-{number}", "type": "command_execution",
            "command": f"probe-{number}",
            "aggregated_output": "permission denied: protected path",
            "exit_code": 1, "status": "failed",
        }
        print(json.dumps({"type": "item.completed", "item": item}), flush=True)
        time.sleep(delay)


def emit_no_progress() -> None:
    """Mixed failing commands, with no successful work item."""
    delay = float(os.environ.get("CODEX_FAKE_LOOP_DELAY", "0.03"))
    for number in range(13):
        item = {
            "id": f"cmd-no-progress-{number}", "type": "command_execution",
            "command": f"probe-{number}",
            "aggregated_output": f"specific failure {number}",
            "exit_code": 1, "status": "failed",
        }
        print(json.dumps({"type": "item.completed", "item": item}), flush=True)
        time.sleep(delay)


def emit_interleaved() -> None:
    """Concurrent piece-wise writers exercise the wrapper's line-framed tee.

    Every line is written as two separately flushed halves with a pause
    between them, so a tee that forwards raw chunks interleaves halves
    across the two streams and tears the merged log's lines. Whole-line
    writes cannot catch that: each chunk then already is a full line.
    """
    def writer(stream, label: str, stagger: float) -> None:
        time.sleep(stagger)
        for number in range(12):
            line = json.dumps({"stream": label, "number": number}) + "\n"
            half = len(line) // 2
            stream.write(line[:half])
            stream.flush()
            time.sleep(0.002)
            stream.write(line[half:])
            stream.flush()
    first = threading.Thread(target=writer, args=(sys.stdout, "stdout", 0.0))
    second = threading.Thread(target=writer, args=(sys.stderr, "stderr", 0.001))
    first.start()
    second.start()
    first.join()
    second.join()


def probe_writes() -> None:
    """Record whether confinement permits each requested write or rename.

    Renames matter separately from writes. A read-only mapping refuses
    every write inside a directory and makes it a mount point, but says
    nothing about that directory's ancestors: where one is renameable, a
    delegate can move the tree aside and recreate the path with content
    of its own, which anyone reading the path afterwards takes for the
    original.
    """
    requested = os.environ.get("CODEX_FAKE_PROBE_WRITES")
    renames = os.environ.get("CODEX_FAKE_PROBE_RENAMES")
    result_path = os.environ.get("CODEX_FAKE_PROBE_RESULT")
    if not (requested or renames) or not result_path:
        return
    results: dict[str, bool] = {}
    for name, value in json.loads(requested or "{}").items():
        try:
            Path(value).write_text("fake Codex confinement probe\n")
        except OSError:
            results[name] = False
        else:
            results[name] = True
    for name, value in json.loads(renames or "{}").items():
        target = Path(value)
        try:
            target.rename(target.with_name(target.name + ".moved"))
        except OSError:
            results[name] = False
        else:
            results[name] = True
    Path(result_path).write_text(json.dumps(results, sort_keys=True))


def serve_catalogue() -> int:
    """Speak the app-server initialization and paginated model/list subset."""
    pages = {
        None: (
            [
                {
                    "id": "gpt-5.6-sol",
                    "model": "gpt-5.6-sol",
                    "hidden": False,
                    "supportedReasoningEfforts": [
                        effort(level)
                        for level in (
                            "low", "medium", "high", "xhigh", "max", "ultra",
                        )
                    ],
                    "defaultReasoningEffort": "low",
                },
                {
                    "id": "gpt-5.6-terra",
                    "model": "gpt-5.6-terra",
                    "hidden": False,
                    "supportedReasoningEfforts": [
                        effort(level)
                        for level in (
                            "low", "medium", "high", "xhigh", "max", "ultra",
                        )
                    ],
                    "defaultReasoningEffort": "medium",
                },
                {
                    "id": "gpt-5.6-luna",
                    "model": "gpt-5.6-luna",
                    "hidden": False,
                    "supportedReasoningEfforts": [
                        effort(level)
                        for level in (
                            "low", "medium", "high", "xhigh", "max",
                        )
                    ],
                    "defaultReasoningEffort": "medium",
                },
                {
                    "id": "gpt-5.5",
                    "model": "gpt-5.5",
                    "hidden": False,
                    "supportedReasoningEfforts": [
                        effort(level)
                        for level in ("low", "medium", "high", "xhigh")
                    ],
                    "defaultReasoningEffort": "medium",
                },
            ],
            "page-2",
        ),
        "page-2": (
            [
                {
                    "id": "gpt-6-future",
                    "model": "gpt-6-future",
                    "hidden": False,
                    "supportedReasoningEfforts": [
                        effort(level)
                        for level in ("minimal", "standard", "deep")
                    ],
                    "defaultReasoningEffort": "standard",
                },
                {
                    "id": "gpt-hidden",
                    "model": "gpt-hidden",
                    "hidden": True,
                    "supportedReasoningEfforts": [effort("high")],
                    "defaultReasoningEffort": "high",
                },
            ],
            None,
        ),
    }
    for line in sys.stdin:
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        if message.get("method") == "initialize":
            print(
                json.dumps({"id": message.get("id"), "result": {}}),
                flush=True,
            )
        elif message.get("method") == "model/list":
            cursor = message.get("params", {}).get("cursor")
            data, next_cursor = pages.get(cursor, ([], None))
            hidden = os.environ.get("CODEX_FAKE_HIDE_MODEL")
            if hidden:
                data = [
                    model
                    for model in data
                    if model.get("model") != hidden
                    and model.get("id") != hidden
                ]
            print(
                json.dumps(
                    {
                        "id": message.get("id"),
                        "result": {
                            "data": data,
                            "nextCursor": next_cursor,
                        },
                    }
                ),
                flush=True,
            )
    return 0


def main() -> int:
    mode = os.environ.get("CODEX_FAKE_MODE", "success")
    marker = os.environ.get("CODEX_FAKE_MARKER")
    arguments_path = os.environ.get("CODEX_FAKE_ARGS")
    stdin_path = os.environ.get("CODEX_FAKE_STDIN")
    environment_path = os.environ.get("CODEX_FAKE_ENV")

    if sys.argv[1:2] == ["--version"]:
        print(os.environ.get("CODEX_FAKE_VERSION", "codex-cli 9.9.9"))
        return 0

    if sys.argv[1:3] == ["login", "status"]:
        if os.environ.get("CODEX_FAKE_AUTH", "ready") == "logged-out":
            print("Not logged in")
            return 1
        print("Logged in using test credentials")
        return 0

    if sys.argv[1:2] == ["app-server"]:
        return serve_catalogue()

    if marker:
        Path(marker).write_text(f"{os.getpid()}\n")

    # A review is asked for a document, not prose. The reply is supplied
    # by the test rather than invented here: a fake provider can show
    # that the pipeline carries findings, and cannot show that a model
    # finds a defect. Only the live corpus can do that.
    if first := os.environ.get("CODEX_FAKE_REVIEW_FIRST"):
        # One malformed reply, then the conforming one, so the retry that
        # carries the validator's complaint back can be exercised.
        marker_path = Path(os.environ["CODEX_FAKE_REVIEW_MARKER"])
        if not marker_path.exists():
            marker_path.write_text("used\n")
            destination = output_path(sys.argv[1:])
            if destination is not None:
                destination.write_text(first)
            return 0

    if review := os.environ.get("CODEX_FAKE_REVIEW"):
        destination = output_path(sys.argv[1:])
        if destination is not None:
            destination.write_text(review)
        schema = None
        for index, argument in enumerate(sys.argv):
            if argument == "--output-schema" and index + 1 < len(sys.argv):
                schema = Path(sys.argv[index + 1])
        if record := os.environ.get("CODEX_FAKE_SCHEMA_SEEN"):
            Path(record).write_text(schema.read_text() if schema else "")
        return 0

    if arguments_path:
        # One argument per line, so the tests can assert the exact
        # invocation contract the wrapper promises.
        Path(arguments_path).write_text(
            "\n".join(sys.argv[1:]) + "\n"
        )

    if "--json" in sys.argv and os.environ.get("CODEX_FAKE_EVENT_NOISE"):
        # Real JSONL carries many event types the accounting must ignore,
        # and diagnostics that are not JSON at all.
        print("codex: connecting", flush=True)
        print(json.dumps({"type": "item.started", "item": {"type": "reasoning"}}), flush=True)

    assignment = sys.stdin.read()
    if stdin_path:
        Path(stdin_path).write_text(assignment)
    if write_path := os.environ.get("CODEX_FAKE_WRITE"):
        Path(write_path).write_text("partial fake Codex edit\n")

    if environment_path:
        selected = {
            name: value
            for name, value in os.environ.items()
            if name.startswith(("ANTHROPIC_", "CLAUDE_", "OPENAI_", "CODEX_"))
            or name in {"DBUS_SESSION_BUS_ADDRESS", "SSH_AUTH_SOCK", "XDG_RUNTIME_DIR"}
        }
        Path(environment_path).write_text(json.dumps(selected, sort_keys=True))
    probe_writes()

    if mode in {"edit", "edit-fail"}:
        edit_path = Path(os.environ.get("CODEX_FAKE_EDIT_PATH", "edited.txt"))
        # The content matters when the diff itself has to carry a real
        # defect: a corpus that seeds only the reviewer's findings tests
        # the pipeline, not the code under review.
        edit_text = os.environ.get("CODEX_FAKE_EDIT_TEXT", "fake Codex edit\n")
        with edit_path.open("a", encoding="utf-8") as handle:
            handle.write(edit_text)
        if mode == "edit-fail":
            mode = "fail"

    if mode == "detach":
        # A descendant that ignores SIGTERM, lives in its own session, and
        # therefore only dies when the whole control group is killed.
        subprocess.Popen(
            [
                sys.executable,
                "-c",
                "import signal, time\n"
                "signal.signal(signal.SIGTERM, signal.SIG_IGN)\n"
                "time.sleep(3600)\n",
            ],
            start_new_session=True,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        time.sleep(3600)
        return 0

    if mode == "sleep":
        time.sleep(3600)
        return 0

    if mode == "loop":
        emit_loop()
    if mode == "error-loop":
        emit_error_loop()
    if mode == "no-progress":
        emit_no_progress()
    if mode == "interleave":
        emit_interleaved()

    if mode == "drip":
        # Emits one line per second so the wrapper's log grows, the way
        # a real codex exec run streams tool output while it works.
        total = float(os.environ.get("CODEX_FAKE_DRIP_SECONDS", "10"))
        text = os.environ.get("CODEX_FAKE_DRIP_TEXT", "examined a hunk")
        end = time.time() + total
        while time.time() < end:
            print(text, flush=True)
            time.sleep(1.0)
        if os.environ.get("CODEX_FAKE_AFTER") == "sleep":
            time.sleep(3600)
        destination = output_path(sys.argv[1:])
        if destination is not None:
            destination.write_text("# PASS\nfake verdict\n")
        return 0

    if mode == "linger":
        # A descendant in the same process group that outlives its parent:
        # writes its identifier to the marker so a test can prove it died.
        child = subprocess.Popen(
            [sys.executable, "-c", "import time; time.sleep(300)"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if marker:
            Path(marker).write_text(f"{child.pid}\n")
        destination = output_path(sys.argv[1:])
        if destination is not None:
            destination.write_text("# PASS\nfake verdict\n")
        return 0

    if mode == "empty":
        return 0

    if mode == "fail":
        print(
            os.environ.get("CODEX_FAKE_FAIL_TEXT", "simulated codex failure"),
            file=sys.stderr,
        )
        return 7
    if mode == "quota":
        print(
            os.environ.get(
                "CODEX_FAKE_QUOTA_DETAIL", "usage limit reached; no credits remain"
            ),
            file=sys.stderr,
        )
        return 7
    if mode == "model-fail":
        print("model is unavailable or not found", file=sys.stderr)
        return 7
    if mode == "transient":
        print("service unavailable: 503", file=sys.stderr)
        return 7
    if mode == "transient-once":
        attempts_path = os.environ.get("CODEX_FAKE_ATTEMPTS")
        attempts = Path(attempts_path) if attempts_path else None
        count = int(attempts.read_text()) if attempts and attempts.exists() else 0
        if attempts:
            attempts.write_text(str(count + 1))
        if count == 0:
            print("service unavailable: 503", file=sys.stderr)
            return 7

    emit_usage()
    destination = output_path(sys.argv[1:])
    if destination is not None:
        destination.write_text("# PASS\nfake verdict\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
