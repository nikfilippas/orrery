#!/usr/bin/env python3
"""Offline Claude CLI stand-in for provider-adapter regression tests."""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path


def option_value(name: str) -> str | None:
    try:
        index = sys.argv.index(name)
    except ValueError:
        return None
    return sys.argv[index + 1] if index + 1 < len(sys.argv) else None


def usage_fields() -> dict:
    """The accounting the real CLI puts in its JSON result.

    The per-model breakdown is what the parser prefers, so both it and
    the flat `usage` field are emitted; a test that wants the flat path
    removes the breakdown. Suppressible entirely, because an absent
    record must become a named gap rather than a zero.
    """
    if os.environ.get("CLAUDE_FAKE_NO_USAGE"):
        return {}
    raw = os.environ.get("CLAUDE_FAKE_USAGE")
    if raw:
        return json.loads(raw)
    return {
        "usage": {
            "input_tokens": 1000,
            "output_tokens": 400,
            "cache_creation_input_tokens": 250,
            "cache_read_input_tokens": 700,
        },
        "modelUsage": {
            "claude-fable-5": {
                "inputTokens": 1000,
                "outputTokens": 400,
                "cacheCreationInputTokens": 250,
                "cacheReadInputTokens": 700,
            }
        },
        "total_cost_usd": 0.0125,
    }


def probe_writes() -> None:
    """Record whether confinement permits each requested write."""
    requested = os.environ.get("CLAUDE_FAKE_PROBE_WRITES")
    result_path = os.environ.get("CLAUDE_FAKE_PROBE_RESULT")
    if not requested or not result_path:
        return
    results: dict[str, bool] = {}
    for name, value in json.loads(requested).items():
        try:
            Path(value).write_text("fake Claude confinement probe\n")
        except OSError:
            results[name] = False
        else:
            results[name] = True
    Path(result_path).write_text(json.dumps(results, sort_keys=True))


def serve_catalogue() -> int:
    """Speak the initialization subset used by the Agent SDK."""
    for line in sys.stdin:
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        request = message.get("request", {})
        if (
            message.get("type") != "control_request"
            or request.get("subtype") != "initialize"
        ):
            continue
        models = [
            {
                "value": "default",
                "resolvedModel": "claude-opus-5[1m]",
                "supportsEffort": True,
                "supportedEffortLevels": [
                    "low", "medium", "high", "xhigh", "max",
                ],
            },
            {
                "value": "opus[1m]",
                "resolvedModel": "claude-opus-5[1m]",
                "supportsEffort": True,
                "supportedEffortLevels": [
                    "low", "medium", "high", "xhigh", "max",
                ],
            },
            {
                "value": "claude-fable-5[1m]",
                "resolvedModel": "claude-fable-5",
                "supportsEffort": True,
                "supportedEffortLevels": [
                    "low", "medium", "high", "xhigh", "max",
                ],
            },
            {
                "value": "sonnet",
                "resolvedModel": "claude-sonnet-5",
                "supportsEffort": True,
                "supportedEffortLevels": [
                    "low", "medium", "high", "xhigh", "max",
                ],
            },
            {
                "value": "haiku",
                "resolvedModel": "claude-haiku-4-5",
            },
            {
                "value": "nova",
                "resolvedModel": "claude-nova-1",
                "supportsEffort": True,
                "supportedEffortLevels": ["low", "high"],
            },
        ]
        hidden = os.environ.get("CLAUDE_FAKE_HIDE_MODEL")
        if hidden:
            models = [
                model
                for model in models
                if model.get("value") != hidden
                and hidden not in str(model.get("resolvedModel", ""))
            ]
        print(
            json.dumps(
                {
                    "type": "control_response",
                    "response": {
                        "subtype": "success",
                        "request_id": message.get("request_id"),
                        "response": {"models": models},
                    },
                }
            ),
            flush=True,
        )
        return 0
    return 0


def main() -> int:
    mode = os.environ.get("CLAUDE_FAKE_MODE", "success")

    if sys.argv[1:2] == ["--version"]:
        print(os.environ.get("CLAUDE_FAKE_VERSION", "9.9.9 (Claude Code)"))
        return 0

    if sys.argv[1:3] == ["auth", "status"]:
        if os.environ.get("CLAUDE_FAKE_AUTH", "ready") == "logged-out":
            print(json.dumps({"loggedIn": False}))
            return 1
        print(json.dumps({"loggedIn": True, "authMethod": "test"}))
        return 0

    if (
        "--input-format" in sys.argv
        and "stream-json" in sys.argv
        and mode == "fail"
    ):
        print("simulated Claude discovery failure", file=sys.stderr)
        return 8
    if "--input-format" in sys.argv and "stream-json" in sys.argv:
        return serve_catalogue()

    if arguments_path := os.environ.get("CLAUDE_FAKE_ARGS"):
        Path(arguments_path).write_text("\n".join(sys.argv[1:]) + "\n")

    assignment = sys.stdin.read()
    if stdin_path := os.environ.get("CLAUDE_FAKE_STDIN"):
        Path(stdin_path).write_text(assignment)
    if write_path := os.environ.get("CLAUDE_FAKE_WRITE"):
        try:
            Path(write_path).write_text("partial fake Claude edit\n")
        except OSError:
            print("fake write blocked", file=sys.stderr)

    if os.environ.get("CLAUDE_FAKE_PLANT"):
        # Mimic the real CLI's sandbox traps: zero-byte files hidden by an
        # appended .git/info/exclude block, left behind when a run aborts.
        for name in (".env", "package.json"):
            Path(name).touch()
        Path("node_modules/.bin").mkdir(parents=True, exist_ok=True)
        exclude = Path(".git/info/exclude")
        if exclude.parent.is_dir():
            with exclude.open("a") as handle:
                handle.write("/.env\n/package.json\n")

    if settings_copy := os.environ.get("CLAUDE_FAKE_SETTINGS"):
        settings = option_value("--settings")
        if settings:
            Path(settings_copy).write_text(Path(settings).read_text())

    if environment_copy := os.environ.get("CLAUDE_FAKE_ENV"):
        selected = {
            name: value
            for name, value in os.environ.items()
            if name.startswith(("ANTHROPIC_", "CLAUDE_", "OPENAI_", "CODEX_"))
            or name in {"DBUS_SESSION_BUS_ADDRESS", "SSH_AUTH_SOCK", "XDG_RUNTIME_DIR"}
        }
        Path(environment_copy).write_text(json.dumps(selected, sort_keys=True))
    probe_writes()

    if mode == "sleep":
        time.sleep(3600)
        return 0
    if mode == "fail":
        print("simulated Claude failure", file=sys.stderr)
        return 8
    if mode == "quota":
        print("usage limit reached; no credits remain", file=sys.stderr)
        return 8
    if mode == "model-fail":
        print("model is unavailable or not found", file=sys.stderr)
        return 8
    if mode == "transient":
        print("service unavailable: 503", file=sys.stderr)
        return 8
    if mode == "transient-once":
        attempts_path = os.environ.get("CLAUDE_FAKE_ATTEMPTS")
        attempts = Path(attempts_path) if attempts_path else None
        count = int(attempts.read_text()) if attempts and attempts.exists() else 0
        if attempts:
            attempts.write_text(str(count + 1))
        if count == 0:
            print("service unavailable: 503", file=sys.stderr)
            return 8
    if mode == "empty":
        print(json.dumps({"result": ""}))
        return 0

    if "--output-format" in sys.argv and "stream-json" in sys.argv:
        # The real CLI emits event lines before the final result object;
        # one is enough to prove recovery reads the last line, not the
        # first.
        print(json.dumps({"type": "system", "subtype": "init"}))
    print(json.dumps({"type": "result", "result": "# PASS\nfake Claude verdict\n", **usage_fields()}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
