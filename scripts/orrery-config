<script>
const STATE = __STATE__;
const SETTINGS = __SETTINGS__;
const CHART = __CHART__;
const TOKEN_PATH = __TOKEN_PATH__;
const roles = Object.fromEntries(STATE.map(s => [s.id, s]));
const original = Object.fromEntries(
  STATE.map(s => [s.id, {
    provider: s.provider, model: s.model, thinking: s.thinking || ""
  }])
);
const originalSettings = Object.fromEntries(SETTINGS.map(s => [s.id, s.value]));
const host = document.getElementById("chart");
const result = document.getElementById("result");
const applyButton = document.getElementById("apply");
const SVGNS = "http://www.w3.org/2000/svg";
const ARROW_SIZE = 12;
const ARROW_CLEARANCE = 20;

const FILL = {
  orchestrator: ["#38617f", "#ffffff"], mechanic: ["#8891a8", "#ffffff"],
  implementer: ["#4f7047", "#ffffff"], "plan-reviewer": ["#7d5d90", "#ffffff"],
  reviewer: ["#a2711d", "#ffffff"], none: ["#e4e8eb", "#1b2226"],
};

function esc(text) {
  return String(text).replace(/&/g, "&amp;").replace(/</g, "&lt;")
    .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function element(name, attributes) {
  const node = document.createElementNS(SVGNS, name);
  for (const [key, value] of Object.entries(attributes)) node.setAttribute(key, value);
  return node;
}

function nodeInk(node) {
  const role = node.roles.length ? node.roles[node.roles.length - 1] : "none";
  return FILL[role] || FILL.none;
}

function stepsUsing(roleId) {
  return CHART.nodes.filter(n => n.roles.includes(roleId)).length;
}

function settingsForNode(nodeId) {
  return SETTINGS.filter(setting => setting.node === nodeId);
}

function picker(step) {
  const id = esc(step.id);
  const knownChoices = (step.choices || []).filter(c => c.known);
  const selectedKnown = knownChoices.some(
    c => c.provider === step.provider && c.id === step.model
  );
  const grouped = ["anthropic", "openai"].map(provider => {
    const options = knownChoices.filter(c => c.provider === provider).map(c => {
      const selected = c.provider === step.provider && c.id === step.model;
      return `<option value="${esc(c.provider + "::" + c.id)}" ` +
        `${selected ? "selected" : ""}>${esc(c.label)}</option>`;
    }).join("");
    const label = provider === "anthropic" ? "Anthropic" : "OpenAI";
    return `<optgroup label="${label}">${options}</optgroup>`;
  }).join("");
  const choice = knownChoices.find(
    c => c.provider === step.provider && c.id === step.model
  );
  const levels = choice ? choice.thinking_levels : [];
  const thinkingOptions = levels.length
    ? levels.map(level =>
        `<option value="${esc(level)}" ${level === step.thinking ? "selected" : ""}>` +
        `${esc(level)}</option>`).join("")
    : `<option value="">${choice ? "unavailable" : "manual setup"}</option>`;
  return `<div class="role-controls" data-role="${id}">` +
    `<div class="role-label">${esc(step.title)}</div><div class="control-row">` +
    `<div class="pick"><label>model</label>` +
    `<select data-step="${id}" data-kind="model">${grouped}` +
    `<option value="__custom__" ${selectedKnown ? "" : "selected"}>custom…</option></select>` +
    `<select data-step="${id}" data-kind="provider" ` +
    `style="display:${selectedKnown ? "none" : "block"}" aria-label="custom model provider">` +
    `<option value="anthropic" ${step.provider === "anthropic" ? "selected" : ""}>Anthropic</option>` +
    `<option value="openai" ${step.provider === "openai" ? "selected" : ""}>OpenAI</option>` +
    `</select>` +
    `<input type="text" data-step="${id}" data-kind="custom" ` +
    `value="${selectedKnown ? "" : esc(step.model)}" ` +
    `style="display:${selectedKnown ? "none" : "block"}" ` +
    `placeholder="exact identifier"></div>` +
    `<div class="pick"><label>thinking</label>` +
    `<select data-step="${id}" data-kind="thinking" ` +
    `${levels.length ? "" : "disabled"}>${thinkingOptions}</select></div>` +
    `</div></div>`;
}

function settingPicker(setting) {
  const options = setting.choices.map(value =>
    `<option value="${value}" ${value === setting.value ? "selected" : ""}>` +
    `${value} round${value === 1 ? "" : "s"}</option>`).join("");
  return `<div class="pick"><label>${esc(setting.label)}</label>` +
    `<select data-setting="${esc(setting.id)}">${options}</select></div>`;
}

function tip(node) {
  const roleText = node.roles.map(id => {
    const step = roles[id];
    const count = stepsUsing(id);
    const shared = count > 1
      ? `Shared with ${count - 1} other step${count === 2 ? "" : "s"}: ` +
        `changing it here changes them too.`
      : "Used at this step only.";
    return `<b>${esc(step.title)}</b>${esc(step.summary)} ${shared}` +
      `<div class="meta">${esc(step.provider)} · ${esc(step.model)}` +
      (step.thinking ? ` · thinking ${esc(step.thinking)}` :
        " · thinking unavailable") +
      `<br>${esc(step.file)}</div>`;
  }).join('<div style="height:8px"></div>');
  const settingText = settingsForNode(node.id).map(setting =>
    `<div style="height:8px"></div><b>${esc(setting.label)}</b>` +
    `${esc(setting.description)}` +
    `<div class="meta">global/orchestration.json · ${setting.minimum}–` +
    `${setting.maximum}, loaded ${originalSettings[setting.id]}</div>`
  ).join("");
  return roleText + settingText;
}

function render() {
  const canvas = document.createElement("div");
  canvas.className = "canvas";
  canvas.style.width = CHART.width + "px";
  canvas.style.height = CHART.height + "px";

  const svg = element("svg", {
    class: "wires", viewBox: `0 0 ${CHART.width} ${CHART.height}`,
    width: CHART.width, height: CHART.height,
  });
  const defs = element("defs", {});
  const marker = element("marker", {
    id: "arrow", viewBox: "0 0 12 12", refX: "11.5", refY: "6",
    markerWidth: String(ARROW_SIZE), markerHeight: String(ARROW_SIZE),
    markerUnits: "userSpaceOnUse", orient: "auto",
  });
  marker.appendChild(element("path", {
    d: "M0.5,0.5 L11.5,6 L0.5,11.5 z", fill: "context-stroke",
  }));
  defs.appendChild(marker);
  svg.appendChild(defs);
  canvas.appendChild(svg);

  const marks = element("svg", {
    class: "marks", viewBox: `0 0 ${CHART.width} ${CHART.height}`,
    width: CHART.width, height: CHART.height,
  });
  canvas.appendChild(marks);

  for (const node of CHART.nodes) {
    const [fill, ink] = nodeInk(node);
    const detail = tip(node);
    const box = document.createElement("div");
    box.className = "cnode" +
      (node.shape === "diamond" ? " diamond" : "") +
      (detail ? " has-info" : "");
    box.dataset.node = node.id;
    box.style.cssText =
      `left:${node.x - node.w / 2}px;top:${node.y - node.h / 2}px;` +
      `width:${node.w}px;min-height:${node.h}px;background:${fill};color:${ink}`;
    box.innerHTML =
      `<div class="title">${esc(node.label)}</div>` +
      (detail ?
        `<button class="info" type="button" aria-label="About this step">&#128712;</button>` +
        `<div class="tip">${detail}</div>` : "") +
      node.roles.map(id => picker(roles[id])).join("") +
      settingsForNode(node.id).map(settingPicker).join("");
    box.addEventListener("mouseenter", () => highlight(node.id, node.roles));
    box.addEventListener("mouseleave", () => highlight(null, null));
    box.addEventListener("focusin", () => highlight(node.id, node.roles));
    box.addEventListener("focusout", event => {
      if (!box.contains(event.relatedTarget)) highlight(null, null);
    });
    canvas.appendChild(box);
  }

  host.appendChild(canvas);
  drawWires(svg, marks, canvas);
  window.addEventListener("resize", () => drawWires(svg, marks, canvas));
  requestAnimationFrame(() => {
    host.scrollLeft = Math.max(0, (CHART.width - host.clientWidth) / 2);
  });
}

function drawWires(svg, marks, canvas) {
  svg.querySelectorAll("path.edge").forEach(old => old.remove());
  marks.querySelectorAll("text").forEach(old => old.remove());
  const frame = canvas.getBoundingClientRect();
  const rect = id => {
    const element = canvas.querySelector(`[data-node="${id}"]`);
    if (!element) return null;
    const box = element.getBoundingClientRect();
    return {
      x: box.left + box.width / 2 - frame.left,
      y: box.top + box.height / 2 - frame.top,
      w: box.width, h: box.height,
      diamond: element.classList.contains("diamond"),
    };
  };

  const edge = (node, towards) => {
    const dx = towards.x - node.x;
    const dy = towards.y - node.y;
    if (!dx && !dy) return { x: node.x, y: node.y };
    const a = node.w / 2;
    const b = node.h / 2;
    const scale = node.diamond
      ? 1 / (Math.abs(dx) / a + Math.abs(dy) / b)
      : Math.min(Math.abs(dx) > 1e-6 ? a / Math.abs(dx) : Infinity,
                 Math.abs(dy) > 1e-6 ? b / Math.abs(dy) : Infinity);
    return { x: node.x + dx * scale, y: node.y + dy * scale };
  };

  const distanceToSegment = (point, start, end) => {
    const dx = end.x - start.x;
    const dy = end.y - start.y;
    const lengthSquared = dx * dx + dy * dy;
    const along = lengthSquared
      ? Math.max(0, Math.min(1,
          ((point.x - start.x) * dx + (point.y - start.y) * dy) /
          lengthSquared))
      : 0;
    return Math.hypot(
      point.x - (start.x + along * dx),
      point.y - (start.y + along * dy),
    );
  };

  const shapeDistance = (point, node) => {
    if (!node.diamond) {
      return Math.hypot(
        Math.max(Math.abs(point.x - node.x) - node.w / 2, 0),
        Math.max(Math.abs(point.y - node.y) - node.h / 2, 0),
      );
    }
    const corners = [
      { x: node.x, y: node.y - node.h / 2 },
      { x: node.x + node.w / 2, y: node.y },
      { x: node.x, y: node.y + node.h / 2 },
      { x: node.x - node.w / 2, y: node.y },
    ];
    return Math.min(...corners.map((corner, index) =>
      distanceToSegment(
        point,
        corner,
        corners[(index + 1) % corners.length],
      )
    ));
  };

  const moveAway = (point, node, minimumGap) => {
    const dx = point.x - node.x;
    const dy = point.y - node.y;
    const length = Math.hypot(dx, dy);
    if (!length) return point;
    let travel = minimumGap;
    let moved;
    do {
      moved = {
        x: point.x + dx / length * travel,
        y: point.y + dy / length * travel,
      };
      travel *= 1.5;
    } while (shapeDistance(moved, node) < minimumGap);
    return moved;
  };

  const labels = [];
  for (const link of CHART.edges) {
    const a = rect(link.from);
    const b = rect(link.to);
    if (!a || !b) continue;
    const start = edge(a, b);
    // The marker extends backwards from the path endpoint. Stop the path
    // outside the target by more than one complete marker, so neither its
    // tip nor its shoulders can disappear beneath an opaque node.
    const end = moveAway(edge(b, a), b, ARROW_CLEARANCE);
    const lift = Math.max(26, Math.abs(end.y - start.y) * 0.4);
    const way = end.y >= start.y ? 1 : -1;
    // A reverse edge would otherwise be painted directly over its forward
    // partner. The manifest can bow one direction sideways so both arrows
    // remain independently legible as a cycle.
    const offset = Number(link.offset || 0);
    const c1 = { x: start.x + offset, y: start.y + lift * way };
    const c2 = { x: end.x + offset, y: end.y - lift * way };
    svg.appendChild(element("path", {
      class: "edge", "marker-end": "url(#arrow)",
      "data-from": link.from, "data-to": link.to,
      d: `M ${start.x} ${start.y} C ${c1.x} ${c1.y}, ${c2.x} ${c2.y}, ${end.x} ${end.y}`,
    }));
    if (link.label) {
      const t = 0.45;
      const at = (p0, p1, p2, p3) =>
        (1 - t) ** 3 * p0 + 3 * (1 - t) ** 2 * t * p1 +
        3 * (1 - t) * t ** 2 * p2 + t ** 3 * p3;
      const labelX = at(start.x, c1.x, c2.x, end.x);
      const labelY = at(start.y, c1.y, c2.y, end.y);
      const text = element("text", { x: labelX, y: labelY });
      const lines = String(link.label).split("\\n");
      lines.forEach((line, index) => {
        const part = element("tspan", {
          x: labelX,
          y: labelY + (index - (lines.length - 1) / 2) * 13,
        });
        part.textContent = line;
        text.appendChild(part);
      });
      labels.push(text);
    }
  }
  labels.forEach(label => marks.appendChild(label));
}

function highlight(sourceId, active) {
  const chosen = active && active.length ? active : null;
  const engaged = sourceId !== null;
  document.querySelectorAll(".cnode").forEach(box => {
    const node = CHART.nodes.find(n => n.id === box.dataset.node);
    const self = sourceId === node.id;
    const kin = Boolean(chosen && !self && node.roles.some(r => chosen.includes(r)));
    box.classList.toggle("self", self);
    box.classList.toggle("kin", kin);
    box.classList.toggle("dim", engaged && !self && !kin);
  });
}

// Several steps run one role, so every control for that role moves
// together; the change is visible rather than hidden.
function choiceFor(roleId, provider, model) {
  return (roles[roleId].choices || []).find(
    choice => choice.known &&
      choice.provider === provider && choice.id === model
  );
}

function selectThinking(select, roleId, provider, model, preferred) {
  const choice = choiceFor(roleId, provider, model);
  const levels = choice ? choice.thinking_levels : [];
  select.replaceChildren();
  if (!levels.length) {
    const option = document.createElement("option");
    option.value = "";
    option.textContent = choice ? "unavailable" : "manual setup";
    select.appendChild(option);
    select.disabled = true;
    return null;
  }
  const remembered = preferred ||
    (provider === roles[roleId].provider &&
     model === roles[roleId].model ? roles[roleId].thinking : "");
  const chosen = levels.includes(remembered)
    ? remembered
    : (choice.default_thinking || levels[0]);
  for (const level of levels) {
    const option = document.createElement("option");
    option.value = level;
    option.textContent = level;
    option.selected = level === chosen;
    select.appendChild(option);
  }
  select.disabled = false;
  return chosen;
}

function syncRole(roleId, provider, model, preferredThinking) {
  const known = Boolean(choiceFor(roleId, provider, model));
  document.querySelectorAll(
    `select[data-step="${roleId}"][data-kind="model"]`
  ).forEach(select => {
    select.value = known ? `${provider}::${model}` : "__custom__";
    const custom = select.parentNode.querySelector('input[data-kind="custom"]');
    if (custom) custom.style.display = known ? "none" : "block";
    const customProvider = select.parentNode.querySelector(
      'select[data-kind="provider"]'
    );
    if (customProvider) {
      customProvider.value = provider;
      customProvider.style.display = known ? "none" : "block";
    }
  });
  document.querySelectorAll(`input[data-step="${roleId}"][data-kind="custom"]`)
    .forEach(input => {
      if (!known && input.value !== model) input.value = model;
    });
  document.querySelectorAll(
    `select[data-step="${roleId}"][data-kind="thinking"]`
  ).forEach(select => selectThinking(
    select, roleId, provider, model, preferredThinking
  ));
}

function currentProvider(id) {
  const select = document.querySelector(
    `select[data-step="${id}"][data-kind="model"]`
  );
  if (!select) return "";
  if (select.value !== "__custom__") return select.value.split("::", 1)[0];
  const customProvider = select.parentNode.querySelector(
    'select[data-kind="provider"]'
  );
  return customProvider ? customProvider.value : "";
}

function currentModel(id) {
  const select = document.querySelector(
    `select[data-step="${id}"][data-kind="model"]`
  );
  if (!select) return "";
  if (select.value !== "__custom__") {
    return select.value.slice(select.value.indexOf("::") + 2);
  }
  const custom = select.parentNode.querySelector('input[data-kind="custom"]');
  return custom ? custom.value.trim() : "";
}

function currentThinking(id) {
  const select = document.querySelector(
    `select[data-step="${id}"][data-kind="thinking"]`
  );
  return !select || select.disabled ? null : select.value;
}

function currentSetting(id) {
  const select = document.querySelector(`select[data-setting="${id}"]`);
  return select ? Number(select.value) : null;
}

function changes() {
  const out = {};
  for (const id of Object.keys(original)) {
    const provider = currentProvider(id);
    const model = currentModel(id);
    const thinking = currentThinking(id);
    if (
      provider && model &&
      (provider !== original[id].provider ||
       model !== original[id].model ||
       (thinking !== null && thinking !== original[id].thinking))
    ) {
      out[id] = {provider, model};
      if (thinking !== null) out[id].thinking = thinking;
    }
  }
  for (const setting of SETTINGS) {
    const value = currentSetting(setting.id);
    if (value !== null && value !== originalSettings[setting.id]) {
      out[setting.id] = { value };
    }
  }
  return out;
}

async function post(endpoint, body) {
  const response = await fetch(TOKEN_PATH + endpoint, {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  return response.json();
}

document.addEventListener("input", event => {
  const data = event.target.dataset || {};
  if (data.step && (data.kind === "custom" || data.kind === "provider")) {
    syncRole(
      data.step,
      currentProvider(data.step),
      currentModel(data.step),
      currentThinking(data.step)
    );
  }
  applyButton.disabled = true;
});

document.addEventListener("change", event => {
  const data = event.target.dataset || {};
  if (data.kind === "model") {
    const custom = event.target.parentNode.querySelector('input[data-kind="custom"]');
    if (custom) custom.style.display = event.target.value === "__custom__" ? "block" : "none";
    const provider = event.target.parentNode.querySelector(
      'select[data-kind="provider"]'
    );
    if (provider) {
      provider.style.display =
        event.target.value === "__custom__" ? "block" : "none";
    }
  }
  if (data.step) {
    syncRole(
      data.step,
      currentProvider(data.step),
      currentModel(data.step),
      currentThinking(data.step)
    );
  }
  applyButton.disabled = true;
});

document.getElementById("preview").addEventListener("click", async () => {
  const body = changes();
  if (!Object.keys(body).length) {
    result.innerHTML = "<p>No changes to preview.</p>"; return;
  }
  const reply = await post("preview", body);
  if (reply.error) {
    result.innerHTML = `<p class="err">${esc(reply.error)}</p>`; return;
  }
  if (!reply.edits.length) {
    result.innerHTML = "<p>Everything already matches.</p>"; return;
  }
  result.innerHTML = "<h3>Exactly this will change:</h3>" +
    reply.edits.map(e => `<pre>${esc(e.diff)}</pre>`).join("");
  applyButton.disabled = false;
});

applyButton.addEventListener("click", async () => {
  applyButton.disabled = true;
  const reply = await post("apply", changes());
  if (reply.error) {
    result.innerHTML = `<p class="err">${esc(reply.error)}</p>`; return;
  }
  const doctor = reply.doctor_pass === null ? "" :
    `<h3>Doctor: <span class="${reply.doctor_pass ? "ok" : "err"}">` +
    `${reply.doctor_pass ? "READY" : "attention needed"}</span></h3>` +
    `<pre>${esc(reply.doctor_tail)}</pre>`;
  result.innerHTML = `<h3 class="ok">Applied: ${esc(reply.applied.join(", "))}</h3>` +
    doctor +
    '<p class="note">Reload to edit further; the kit repository now holds these values, ready to commit.</p>';
});

document.getElementById("revert").addEventListener("click", () => location.reload());

render();
</script>
</body>
</html>
"""


def script_json(value: Any) -> str:
    """JSON safe to embed in a <script> element.

    JSON encoding alone does not escape `</script>`, so a value containing
    one would end the element and let the rest execute as markup. The
    characters that can start a tag or a comment are escaped instead.
    """
    return (
        json.dumps(value)
        .replace("<", "\\u003c")
        .replace(">", "\\u003e")
        .replace("&", "\\u0026")
        .replace(" ", "\\u2028")
        .replace(" ", "\\u2029")
    )


def render_page(token: str) -> str:
    manifest = load_manifest()
    live = [
        provider
        for provider, source in CATALOGUE_DISCOVERY.sources.items()
        if source == "installed CLI"
    ]
    if len(live) == len(PROVIDERS):
        catalogue_note = (
            "Models and thinking levels were discovered from the installed "
            "Claude and Codex CLIs."
        )
    else:
        fallback = [
            provider
            for provider in PROVIDERS
            if provider not in live
        ]
        catalogue_note = (
            "Live model discovery is using the bundled fallback for "
            f"{', '.join(fallback)}."
        )
    return (
        PAGE_TEMPLATE
        .replace("__STATE__", script_json(snapshot(manifest)))
        .replace("__SETTINGS__", script_json(settings_snapshot(manifest)))
        .replace("__CHART__", script_json(manifest.get("chart", {})))
        .replace("__TOKEN_PATH__", script_json(f"/t/{token}/"))
        .replace("__CATALOGUE_NOTE__", html.escape(catalogue_note))
    )


def print_state() -> int:
    manifest = load_manifest()
    for state in snapshot(manifest):
        thinking = (
            f" · thinking {state['thinking']}"
            if state.get("thinking")
            else " · thinking unavailable"
        )
        print(f"{state['title']:24} {state['provider']:10} "
              f"{state['model']}{thinking}   [{state['file']}]")
    for setting in settings_snapshot(manifest):
        print(
            f"{setting['label']:24} {'workflow':10} "
            f"{setting['value']} "
            f"[{setting['minimum']}–{setting['maximum']}; "
            "global/orchestration.json]"
        )
    return 0


class Handler(BaseHTTPRequestHandler):
    token = ""
    lock = threading.Lock()
    last_activity = time.time()
    # The exact edit each file was last previewed with. An apply is only
    # honoured for the change its operator actually saw.
    previewed: dict[str, dict[str, str]] = {}

    def log_message(self, *arguments: Any) -> None:
        pass

    def touch(self) -> bool:
        # Authenticate first: unauthenticated traffic must never keep the
        # server alive past its idle timeout.
        prefix = f"/t/{Handler.token}/"
        if not secrets.compare_digest(self.path[: len(prefix)], prefix):
            self.send_error(404)
            return False
        Handler.last_activity = time.time()
        return True

    def endpoint(self) -> str:
        return self.path[len(f"/t/{Handler.token}/") :]

    def reply(self, payload: dict[str, Any], status: int = 200) -> None:
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        if not self.touch():
            return
        if self.endpoint() not in ("", "/"):
            self.send_error(404)
            return
        body = render_page(Handler.token).encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:
        if not self.touch():
            return
        try:
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                raise ConfigError("invalid Content-Length")
            # A request only ever carries a handful of short model names.
            if length < 0 or length > MAX_BODY_BYTES:
                raise ConfigError(
                    f"the request body may not exceed {MAX_BODY_BYTES} bytes"
                )
            changes = json.loads(self.rfile.read(length) or b"{}")
            if not isinstance(changes, dict):
                raise ConfigError("the request body must be a JSON object")

            if self.endpoint() == "preview":
                with Handler.lock:
                    edits = plan(changes)
                    for edit in edits:
                        Handler.previewed[edit["file"]] = {
                            "before": edit["before"],
                            "after": edit["after"],
                        }
                # The previous content is internal bookkeeping for the
                # apply-time check, not something the page needs.
                self.reply(
                    {
                        "edits": [
                            {key: value for key, value in edit.items()
                             if key != "before"}
                            for edit in edits
                        ]
                    }
                )
            elif self.endpoint() == "apply":
                with Handler.lock:
                    self.reply(apply_edits(plan(changes), Handler.previewed))
            else:
                self.send_error(404)
        except (ConfigError, json.JSONDecodeError, OSError) as exc:
            self.reply({"error": str(exc)}, status=400)


def serve(port: int, timeout: float, open_browser: bool) -> int:
    Handler.token = secrets.token_hex(12)
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{server.server_address[1]}/t/{Handler.token}/"

    def watch_idle() -> None:
        while True:
            time.sleep(1)
            if time.time() - Handler.last_activity > timeout:
                print("Idle timeout reached; exiting.", flush=True)
                server.shutdown()
                return

    threading.Thread(target=watch_idle, daemon=True).start()

    print(f"CONFIG_URL={url}", flush=True)
    print(
        f"Serving the configuration page at {url}\n"
        f"Bound to 127.0.0.1 only; exits after {int(timeout)}s idle "
        "or on Ctrl-C.",
        flush=True,
    )
    if open_browser:
        webbrowser.open(url)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("Interrupted; exiting.", flush=True)
    finally:
        server.server_close()
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Configure the Órrery orchestration visually."
    )
    parser.add_argument("--print", action="store_true", dest="print_state")
    parser.add_argument("--port", type=int, default=0)
    parser.add_argument("--timeout", type=float, default=600)
    parser.add_argument("--no-browser", action="store_true")
    arguments = parser.parse_args()

    try:
        activate_discovered_catalogue()
        for warning in CATALOGUE_DISCOVERY.warnings:
            print(f"Model discovery: {warning}", file=sys.stderr, flush=True)
        if arguments.print_state:
            return print_state()
        return serve(
            arguments.port,
            arguments.timeout,
            open_browser=not arguments.no_browser,
        )
    except ConfigError as exc:
        print(f"orrery-config: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
