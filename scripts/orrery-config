<script>
const STATE = __STATE__;
const SETTINGS = __SETTINGS__;
const CHART = __CHART__;
const SCOPE = "Saving sets the defaults for new Orrery sessions; running " +
  "sessions keep theirs, and a repository\u2019s private .orrery.json " +
  "still wins. " + __CATALOGUE_NOTE__;
// Exposed so the drawing can be measured from a console, and by the
// checks that verify its geometry against what is painted.
window.CHART = CHART;
window.SETTINGS = SETTINGS;
const ENDPOINTS = __ENDPOINTS__;
const TOKEN_PATH = __TOKEN_PATH__;
const roles = Object.fromEntries(STATE.map(s => [s.id, s]));
const original = Object.fromEntries(
  STATE.map(s => [s.id, {
    provider: s.provider, model: s.model, thinking: s.thinking || "",
    endpoint: s.endpoint || ""
  }])
);
const originalSettings = Object.fromEntries(SETTINGS.map(s => [s.id, s.value]));
const host = document.getElementById("chart");
const result = document.getElementById("result");
const applyButton = document.getElementById("apply");
const SVGNS = "http://www.w3.org/2000/svg";
// The drawing is authored at CHART.width x CHART.height and painted through
// a viewBox, so every coordinate below is the exported one and the page can
// take a fresh export unchanged.
const S = CHART.scale || 1;

function esc(text) {
  return String(text).replace(/&/g, "&amp;").replace(/</g, "&lt;")
    .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function element(name, attributes) {
  const node = document.createElementNS(SVGNS, name);
  for (const [key, value] of Object.entries(attributes)) node.setAttribute(key, value);
  return node;
}

function stepsUsing(roleId) {
  return CHART.nodes.filter(n => n.roles.includes(roleId)).length;
}

function boxLeft(item) { return item.x - item.w / 2; }
function boxTop(item) { return item.y - item.h / 2; }

function panel(item, extra) {
  return element("rect", Object.assign({
    x: boxLeft(item), y: boxTop(item), width: item.w, height: item.h,
    rx: item.r || 0, ry: item.r || 0,
    fill: item.fill || "none",
    stroke: item.stroke, "stroke-width": item.width || 1.5,
    "stroke-dasharray": item.dash || "none",
  }, extra || {}));
}

function textRun(line, size, fill, anchor, bold) {
  const text = element("text", {
    x: line.x, y: line.y, "font-size": size, fill,
    "text-anchor": anchor, "font-weight": bold ? "700" : "400",
  });
  // Aptos is a Microsoft font and is usually absent, so every run is
  // pinned to the width it was drawn at. The layout then holds whatever
  // the browser substitutes, instead of spilling out of its box.
  if (line.w) {
    text.setAttribute("textLength", line.w);
    text.setAttribute("lengthAdjust", line.fit || "spacingAndGlyphs");
  }
  text.textContent = line.t;
  return text;
}

// A blurred patch of the background, laid under a caption so the wire it
// sits on fades away rather than striking through the words.
function halo(line, size) {
  // Wide enough that the blur has faded out past the words, and tall
  // enough that its middle is fully opaque where the letters sit.
  const width = (line.haloW || line.w) + size * 1.1;
  const height = size * (line.haloH || 1.9);
  return element("rect", {
    x: (line.haloX || line.x) - width / 2,
    y: line.y - size * 0.32 - height / 2,
    width, height,
    fill: CHART.background,
    filter: line.haloSoft ? "url(#soften-more)" : "url(#soften)",
  });
}

function header() {
  const own = CHART.header;
  const group = element("g", { class: "header" });
  const text = element("text", {
    x: own.x, y: own.y, "text-anchor": "start",
    "font-size": own.titleSize, "font-weight": "700", fill: "#ffffff",
  });
  const name = element("tspan", {});
  name.textContent = own.title;
  const stand = element("tspan", {
    dx: own.gap, "font-size": own.subtitleSize,
    "font-weight": "400", fill: CHART.wire,
  });
  stand.textContent = own.subtitle;
  text.appendChild(name);
  text.appendChild(stand);
  group.appendChild(text);
  const note = element("text", {
    x: own.x, y: own.noteY, "text-anchor": "start", class: "scopeline",
    "font-size": own.noteSize, "font-weight": "400", fill: CHART.wire,
  });
  note.textContent = SCOPE;
  group.appendChild(note);
  return group;
}

// The note shares its band with the buttons, so it is held to the room
// left of them however wide their labels turn out to be.
function fitHeaderNote(canvas) {
  const note = canvas.querySelector("text.scopeline");
  const bar = canvas.querySelector(".actionbar");
  if (!note || !bar) return;
  const taken = bar.getBoundingClientRect().width / S;
  const room = CHART.actions.x - taken - CHART.header.x - 14;
  note.removeAttribute("textLength");
  if (note.getComputedTextLength() > room) {
    note.setAttribute("textLength", room);
    note.setAttribute("lengthAdjust", "spacingAndGlyphs");
  }
}

function nodeShape(node) {
  if (node.shape === "diamond") {
    return element("polygon", {
      points: node.points.map(point => point.join(",")).join(" "),
      fill: node.fill, stroke: node.stroke, "stroke-width": 1.5,
    });
  }
  return panel(node);
}

// Every control sits where the drawing left room for it, so the legend
// keeps the spacing it was designed with.
function place(host, card, slot, node, className) {
  node.className = className;
  node.style.cssText =
    `left:${(slot[0] - boxLeft(card)) * S}px;top:${(slot[1] - boxTop(card)) * S}px;` +
    `width:${slot[2] * S}px;height:${slot[3] * S}px`;
  host.appendChild(node);
  return node;
}

// A card whose caption is drawn in black is a pale one, and needs its
// controls drawn the same way.
function light(card) {
  return card.ink === "#000000";
}

function option(value, label, selected) {
  const node = document.createElement("option");
  node.value = value;
  node.textContent = label;
  node.selected = Boolean(selected);
  return node;
}

function settingControls(card) {
  const setting = SETTINGS.find(entry => entry.id === card.target);
  const box = document.createElement("div");
  box.className = "cardctl" + (light(card) ? " on-light" : "");
  box.dataset.card = card.target;
  box.style.cssText =
    `left:${boxLeft(card) * S}px;top:${boxTop(card) * S}px;` +
    `width:${card.w * S}px;height:${card.h * S}px`;
  if (!setting) return box;
  const select = document.createElement("select");
  select.dataset.setting = setting.id;
  for (const value of setting.choices) {
    select.appendChild(option(
      value,
      `${value} round${value === 1 ? "" : "s"}`,
      value === setting.value,
    ));
  }
  place(box, card, card.fields[0].slot, select, "ctl");
  return box;
}

function roleControls(card) {
  const step = STATE.find(entry => entry.id === card.target);
  const box = document.createElement("div");
  box.className = "cardctl" + (light(card) ? " on-light" : "");
  box.dataset.card = card.target;
  box.style.cssText =
    `left:${boxLeft(card) * S}px;top:${boxTop(card) * S}px;` +
    `width:${card.w * S}px;height:${card.h * S}px`;
  if (!step) return box;

  const preset = ENDPOINTS.find(item => item.id === step.endpoint);
  const known = (step.choices || []).filter(choice => choice.known);
  const chosen = known.find(
    choice => choice.provider === step.provider && choice.id === step.model
  );
  const listed = preset ? preset.models.includes(step.model) : Boolean(chosen);

  const endpoint = document.createElement("select");
  endpoint.dataset.step = step.id;
  endpoint.dataset.kind = "endpoint";
  for (const name of ["anthropic", "openai"]) {
    endpoint.appendChild(option(
      name,
      `first-party (${name === "anthropic" ? "Anthropic" : "OpenAI"})`,
      !preset && step.provider === name,
    ));
  }
  for (const item of ENDPOINTS) {
    endpoint.appendChild(option(
      item.id,
      item.label + (item.verified ? "" : " (unverified)"),
      item.id === step.endpoint,
    ));
  }
  if (preset) {
    endpoint.title = `${preset.base_url} · ` +
      (preset.key_env ? `key from ${preset.key_env}` : "no credential required");
  }
  place(box, card, card.fields[0].slot, endpoint, "ctl");

  const model = document.createElement("select");
  model.dataset.step = step.id;
  model.dataset.kind = "model";
  if (preset) {
    // A third-party endpoint serves its own models, so the first-party
    // catalogue and its thinking levels do not apply here.
    for (const name of preset.models) {
      model.appendChild(option(name, name, name === step.model));
    }
  } else {
    // Seeded by the endpoint: a first-party endpoint is one provider, so
    // only that provider's catalogue belongs in the list.
    for (const choice of known.filter(item => item.provider === step.provider)) {
      model.appendChild(option(choice.id, choice.label, choice.id === step.model));
    }
  }
  model.appendChild(option("__custom__", "custom…", !listed));
  place(box, card, card.fields[1].slot, model, "ctl");

  const thinking = document.createElement("select");
  thinking.dataset.step = step.id;
  thinking.dataset.kind = "thinking";
  const levels = preset ? [] : (chosen ? chosen.thinking_levels : []);
  if (levels.length) {
    for (const level of levels) {
      thinking.appendChild(option(level, level, level === step.thinking));
    }
  } else {
    thinking.appendChild(option(
      "",
      preset ? "endpoint's" : (chosen ? "unavailable" : "manual setup"),
    ));
    thinking.disabled = true;
  }
  place(box, card, card.fields[2].slot, thinking, "ctl");

  // Naming a model by hand still needs somewhere to type it. The bottom row
  // gives up its thinking picker -- which a hand-named model cannot offer
  // anyway -- and model and identifier share the row.

  const custom = document.createElement("input");
  custom.type = "text";
  custom.dataset.step = step.id;
  custom.dataset.kind = "custom";
  custom.placeholder = "exact identifier";
  custom.value = listed ? "" : step.model;
  place(box, card, card.fields[1].slot, custom, "ctl");

  box.dataset.custom = String(!listed);
  layoutRow(box, card, !listed);
  return box;
}

// The bottom row in its two states: model and thinking as drawn, or model
// and a typed identifier sharing the row while a model is named by hand.
function layoutRow(box, card, custom) {
  const model = box.querySelector('select[data-kind="model"]');
  const typed = box.querySelector('input[data-kind="custom"]');
  const thinking = box.querySelector('select[data-kind="thinking"]');
  const label = document.querySelector(
    `[data-field-label="${card.target}:THINKING"]`
  );
  if (!model) return;
  const gap = 4;
  const [x, y, , h] = card.fields[1].slot;
  const full = card.fields[0].slot[2];

  const put = (node, left, width) => {
    node.style.left = `${(x + left - boxLeft(card)) * S}px`;
    node.style.top = `${(y - boxTop(card)) * S}px`;
    node.style.width = `${width * S}px`;
    node.style.height = `${h * S}px`;
    node.style.display = "block";
  };

  if (custom) {
    const room = full - gap;
    put(model, 0, room * 0.42);
    put(typed, room * 0.42 + gap, room * 0.58);
    if (thinking) thinking.style.display = "none";
    if (label) label.style.opacity = "0";
  } else {
    put(model, 0, card.fields[1].slot[2]);
    typed.style.display = "none";
    if (thinking) thinking.style.display = "block";
    if (label) label.style.opacity = "";
  }
}

// What a card stands for, worded for the legend rather than for a step.
function cardTip(card) {
  if (card.kind === "setting") {
    const setting = SETTINGS.find(entry => entry.id === card.target);
    if (!setting) return "";
    return `<b>${esc(setting.label)}</b>${esc(setting.description)}`;
  }
  const step = roles[card.target];
  if (!step) return "";
  const count = stepsUsing(card.target);
  const shared = count > 1
    ? ` The ${count} highlighted steps share this role and change together.`
    : "";
  const access = step.access ? ` Access: ${esc(step.access)}.` : "";
  return `<b>${esc(step.title)}</b>${esc(step.summary)}${shared}${access}`;
}

// A hover target over the card's mark, so the legend explains each role
// and lights up the steps that run it.
function cardMarkHot(card) {
  const detail = cardTip(card);
  if (!detail) return null;
  const [, , iw, ih] = card.icon ? card.icon.box : [0, 0, 1, 1];
  const factor = CHART.iconSize / Math.sqrt(iw * ih);
  const inset = CHART.iconInset;
  const hot = document.createElement("div");
  hot.className = "hot has-tip";
  hot.tabIndex = 0;
  hot.style.cssText =
    `left:${(card.x + card.w / 2 - inset - iw * factor - 2) * S}px;` +
    `top:${(card.y - card.h / 2 + inset - 2) * S}px;` +
    `width:${(iw * factor + 4) * S}px;height:${(ih * factor + 4) * S}px`;
  const bubble = document.createElement("div");
  bubble.className = "tip flip-x" +
    (card.y > CHART.height * 0.5 ? " flip-y" : "");
  bubble.innerHTML = detail;
  hot.appendChild(bubble);
  hot.addEventListener("mouseenter", () => {
    if (!pinned) hoverCard(card.target);
  });
  hot.addEventListener("mouseleave", () => {
    if (!pinned) applyHighlight(null);
  });
  hot.addEventListener("focusin", () => {
    if (!pinned) hoverCard(card.target);
  });
  hot.addEventListener("focusout", event => {
    if (!pinned && !hot.contains(event.relatedTarget)) applyHighlight(null);
  });
  return hot;
}

function cardControls(card) {
  return card.kind === "setting" ? settingControls(card) : roleControls(card);
}

function renderLegend(canvas) {
  for (const card of CHART.legend.cards) {
    canvas.appendChild(cardControls(card));
    const mark = cardMarkHot(card);
    if (mark) canvas.appendChild(mark);
  }
}

// One card's controls depend on its endpoint, so only that card is rebuilt.
function replaceCard(target) {
  const card = CHART.legend.cards.find(entry => entry.target === target);
  const existing = document.querySelector(`.cardctl[data-card="${target}"]`);
  if (!card || !existing) return;
  existing.replaceWith(cardControls(card));
}

function render() {
  host.style.background = CHART.background;
  const canvas = document.createElement("div");
  canvas.className = "canvas";
  canvas.style.cssText =
    `width:${CHART.width * S}px;height:${CHART.height * S}px;` +
    `background:${CHART.background}`;

  const art = element("svg", {
    class: "art", viewBox: `0 0 ${CHART.width} ${CHART.height}`,
    width: CHART.width * S, height: CHART.height * S,
    "font-family": CHART.font,
  });

  // A wire passing under a caption is faded out behind it rather than
  // crossing it, exactly as the drawing does.
  const defs = element("defs", {});
  // Filters work in linear light by default, so a blurred patch of the
  // background comes back a different colour and prints as a pale box.
  // Blurring in sRGB keeps it the same colour it started as.
  const soften = element("filter", {
    id: "soften", x: "-50%", y: "-100%", width: "200%", height: "300%",
    "color-interpolation-filters": "sRGB",
  });
  soften.appendChild(element("feGaussianBlur", { stdDeviation: "1.6" }));
  defs.appendChild(soften);
  // A gentler version, for a caption too hemmed in to carry the usual fade.
  const gentler = element("filter", {
    id: "soften-more", x: "-60%", y: "-160%", width: "220%", height: "420%",
    "color-interpolation-filters": "sRGB",
  });
  gentler.appendChild(element("feGaussianBlur", { stdDeviation: "2.8" }));
  defs.appendChild(gentler);
  art.appendChild(defs);

  const caption = link => {
    for (const line of link.lines || []) {
      const key = `${link.from}>${link.to}`;
      const patch = halo(line, CHART.wireSize);
      patch.setAttribute("data-edge", key);
      art.appendChild(patch);
      const words = textRun(line, CHART.wireSize, CHART.wire, "middle", false);
      words.setAttribute("data-edge", key);
      art.appendChild(words);
    }
  };
  // A caption marked to sit behind is drawn first, so the loop border and
  // the box it runs into both cover it; the rest keep their place above.
  for (const link of CHART.edges) if (link.back) caption(link);

  const loopBorder = panel(CHART.cluster);
  loopBorder.setAttribute("data-part", "cluster");
  art.appendChild(loopBorder);
  for (const link of CHART.edges) {
    if (!link.d) continue;
    const wire = element("path", { d: link.d, fill: CHART.wire });
    wire.setAttribute("data-edge", `${link.from}>${link.to}`);
    art.appendChild(wire);
  }
  const loopMark = element("path", {
    d: CHART.loopMark.d, fill: CHART.loopMark.fill,
  });
  loopMark.setAttribute("data-part", "loop");
  art.appendChild(loopMark);

  for (const node of CHART.nodes) {
    const group = element("g", { "data-node": node.id });
    group.appendChild(nodeShape(node));
    for (const line of node.lines) {
      group.appendChild(textRun(line, node.size, node.ink, "middle", true));
    }
    art.appendChild(group);
  }

  for (const link of CHART.edges) if (!link.back) caption(link);

  const legend = CHART.legend;
  art.appendChild(panel(legend.group));
  for (const card of legend.cards) {
    // One group per entry, so hovering a step can fade the entries that
    // have nothing to do with it.
    const entry = element("g", { "data-card": card.target });
    art.appendChild(entry);
    entry.appendChild(panel(card));
    entry.appendChild(textRun(card.title, card.titleSize, card.ink, "start", false));
    for (const field of card.fields) {
      const drawn = textRun(
        { t: field.label, x: field.x, y: field.y, w: field.w },
        card.fieldSize, card.ink, "start", false,
      );
      drawn.setAttribute("data-field-label", `${card.target}:${field.label}`);
      entry.appendChild(drawn);
    }
    if (card.icon) {
      // The marks were drawn at different proportions, so matching one
      // dimension would leave a wide one looking half the size of a tall
      // one. Matching the area they cover is what reads as the same size.
      const [ix, iy, iw, ih] = card.icon.box;
      const side = CHART.iconSize;
      const factor = side / Math.sqrt(iw * ih);
      // One inset for every card, so the marks line up as a set rather
      // than following each card's own inner rhythm.
      const inset = CHART.iconInset;
      const toX = card.x + card.w / 2 - inset - iw * factor;
      const toY = card.y - card.h / 2 + inset;
      const mark = element("g", {
        transform: `translate(${toX - ix * factor} ${toY - iy * factor}) ` +
          `scale(${factor})`,
      });
      mark.appendChild(element("path", { d: card.icon.d, fill: card.icon.fill }));
      entry.appendChild(mark);
    }
  }
  // The frame is drawn last so its border sits in front of the panel it
  // encloses instead of disappearing behind it.
  art.appendChild(panel(legend.frame));

  art.appendChild(header());
  canvas.appendChild(art);

  // The steps light up their kin on hover; what a role actually does is
  // explained by its mark in the legend instead.
  for (const node of CHART.nodes) {
    const hot = document.createElement("div");
    hot.className = "hot";
    hot.dataset.node = node.id;
    hot.style.cssText =
      `left:${boxLeft(node) * S}px;top:${boxTop(node) * S}px;` +
      `width:${node.w * S}px;height:${node.h * S}px`;
    hot.addEventListener("mouseenter", () => {
      if (!pinned) hoverNode(node.id);
    });
    hot.addEventListener("mouseleave", () => {
      if (!pinned) applyHighlight(null);
    });
    hot.addEventListener("click", event => {
      event.stopPropagation();
      pinned = pinned === node.id ? null : node.id;
      if (pinned) hoverNode(node.id, true);
      else hoverNode(node.id);
    });
    canvas.appendChild(hot);
  }

  renderLegend(canvas);

  // Clicking the drawing itself releases a pin; the legend does not, so a
  // pinned step survives while its model is changed.
  canvas.addEventListener("click", event => {
    if (event.target.closest(".cardctl") || event.target.closest(".hot")) return;
    if (!pinned) return;
    pinned = null;
    applyHighlight(null);
  });

  const bar = document.createElement("div");
  bar.className = "actionbar";
  const box = CHART.actions;
  bar.style.cssText =
    `right:${(CHART.width - box.x) * S}px;top:${box.y * S}px;` +
    `height:${box.h * S}px;font-size:${box.h * 0.44 * S}px`;
  for (const button of [...document.querySelectorAll(".actions .btn")]) {
    bar.appendChild(button);
  }
  canvas.appendChild(bar);

  const frame = document.createElement("div");
  frame.className = "canvasfit";
  frame.appendChild(canvas);
  host.appendChild(frame);
  // Measured only once the canvas is in the document, or the buttons have
  // no width yet and the note would be left running underneath them.
  fitHeaderNote(canvas);
  fitCanvas();
  let pending = false;
  window.addEventListener("resize", () => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => { pending = false; fitCanvas(); });
  });
}

// The drawing takes whatever room the tab has left once the page's own
// furniture is measured, so nothing ever needs scrolling to be seen.
function fitCanvas() {
  const frame = document.querySelector(".canvasfit");
  const canvas = frame.firstChild;
  const width = CHART.width * S;
  const height = CHART.height * S;
  // The chart's box is whatever the column layout leaves it, so the two
  // measurements below are already free of the page's own furniture.
  const scale = Math.max(0.2, Math.min(
    host.clientWidth / width,
    host.clientHeight / height,
  ));
  canvas.style.transform = `scale(${scale})`;
  frame.style.width = `${width * scale}px`;
  frame.style.height = `${height * scale}px`;
}

// How far each step is from the chart's entry, which is the first one
// listed, and which wires arrive at each step. Between them these give
// every shortest way in, not merely one of them.
const INTO = new Map();
for (const link of CHART.edges) {
  if (!INTO.has(link.to)) INTO.set(link.to, []);
  INTO.get(link.to).push(link);
}
const ENTRY = CHART.nodes.length ? CHART.nodes[0].id : null;
const DEPTH = new Map(ENTRY === null ? [] : [[ENTRY, 0]]);
for (let frontier = [ENTRY]; frontier.length; ) {
  const next = [];
  for (const at of frontier) {
    for (const link of CHART.edges) {
      if (link.from !== at || DEPTH.has(link.to)) continue;
      DEPTH.set(link.to, DEPTH.get(at) + 1);
      next.push(link.to);
    }
  }
  frontier = next;
}
const ROUTES = new Map();

// The steps the loop's border is drawn around, taken from the border
// itself rather than listed again, so moving a box in the drawing cannot
// leave the two disagreeing.
const ENCLOSED = new Set(
  (CHART.cluster ? CHART.nodes : []).filter(node =>
    boxLeft(node) >= boxLeft(CHART.cluster) &&
    node.x + node.w / 2 <= CHART.cluster.x + CHART.cluster.w / 2 &&
    boxTop(node) >= boxTop(CHART.cluster) &&
    node.y + node.h / 2 <= CHART.cluster.y + CHART.cluster.h / 2
  ).map(node => node.id)
);

// Every shortest way in, as the steps and the wires they use. Where two
// branches rejoin -- a diff can arrive from either worker -- both are
// shown, because naming one of them would be a claim the chart does not
// make. A step with no way in is its own route.
function routeTo(nodeId) {
  if (ROUTES.has(nodeId)) return ROUTES.get(nodeId);
  const found = { nodes: new Set([nodeId]), edges: new Set() };
  if (DEPTH.has(nodeId)) {
    const pending = [nodeId];
    while (pending.length) {
      const at = pending.pop();
      for (const link of INTO.get(at) || []) {
        if (DEPTH.get(link.from) !== DEPTH.get(at) - 1) continue;
        found.edges.add(`${link.from}>${link.to}`);
        if (found.nodes.has(link.from)) continue;
        found.nodes.add(link.from);
        pending.push(link.from);
      }
    }
  }
  ROUTES.set(nodeId, found);
  return found;
}

// A step can be pinned so the highlight survives the trip to the legend
// entry that configures it; until then hovering rules.
let pinned = null;

// One rule for the whole drawing: whatever the gesture names stays lit and
// everything else recedes, the loop's border and its mark included.
function applyHighlight(state, sweep) {
  const engaged = Boolean(state);
  const fade = (part, keep) => part.classList.toggle("dim", engaged && !keep);
  document.querySelectorAll(".art .sweep").forEach(part => {
    part.classList.remove("sweep");
    part.style.animationDelay = "";
  });

  document.querySelectorAll(".art g[data-node]").forEach(group => {
    const id = group.dataset.node;
    fade(group, engaged && state.nodes.has(id));
    group.classList.toggle("self", engaged && state.self === id);
  });
  document.querySelectorAll(".art [data-edge]").forEach(part => {
    fade(part, engaged && state.edges.has(part.dataset.edge));
  });
  document.querySelectorAll(".art [data-part]").forEach(part => {
    fade(part, engaged && state.parts.has(part.dataset.part));
  });
  document.querySelectorAll("[data-card]").forEach(part => {
    fade(part, engaged && state.cards.has(part.dataset.card));
  });

  // Pinning runs a light along the route, leaving the entry and arriving at
  // the step just pinned, so the way in reads in the order it happens.
  if (!sweep || !engaged) return;
  const step = 70;
  const mark = (part, depth) => {
    part.style.animationDelay = `${Math.max(0, depth) * step}ms`;
    part.classList.add("sweep");
  };
  document.querySelectorAll(".art g[data-node]").forEach(part => {
    if (state.nodes.has(part.dataset.node)) {
      mark(part, depthOf(part.dataset.node));
    }
  });
  document.querySelectorAll(".art [data-edge]").forEach(part => {
    if (state.edges.has(part.dataset.edge)) {
      mark(part, depthOf(part.dataset.edge.split(">")[1]) - 0.5);
    }
  });
}

// How far along the route something sits. Steps the chart leaves unwired
// take their place from the loop's own order instead.
function depthOf(nodeId) {
  if (DEPTH.has(nodeId)) return DEPTH.get(nodeId);
  const loop = CHART.loop;
  const at = loop ? loop.steps.indexOf(nodeId) : -1;
  if (at > 0 && DEPTH.has(loop.steps[0])) return DEPTH.get(loop.steps[0]) + at;
  return 0;
}

// Pointing at a step lights the shortest way to it. The legend shows only
// what configures that step itself, not everything met along the way.
function hoverNode(nodeId, sweep) {
  const route = routeTo(nodeId);
  const nodes = new Set(route.nodes);
  const edges = new Set(route.edges);

  // Inside the plan-review loop the order is a prerequisite, not a path:
  // reaching a later step means the earlier ones have happened, and the
  // cycle's own captions belong to them.
  const loop = CHART.loop;
  if (loop) {
    let reached = loop.steps.indexOf(nodeId);
    if (reached < 0 && loop.after.includes(nodeId)) {
      reached = loop.steps.length - 1;
    }
    if (reached >= 0) {
      for (const id of routeTo(loop.steps[0]).nodes) nodes.add(id);
      for (const key of routeTo(loop.steps[0]).edges) edges.add(key);
      for (const step of loop.steps.slice(0, reached + 1)) {
        nodes.add(step);
        for (const key of loop.captions[step] || []) edges.add(key);
      }
    }
  }

  const node = CHART.nodes.find(entry => entry.id === nodeId);
  const cards = new Set(node ? node.roles : []);
  for (const setting of SETTINGS) {
    if (setting.node === nodeId) cards.add(setting.id);
  }
  applyHighlight({
    nodes, edges, cards, parts: loopParts(nodes), self: nodeId,
  }, sweep);
}

// The border belongs to the loop as a whole; the mark belongs to the step
// that counts the rounds.
function loopParts(nodes) {
  const parts = new Set();
  if ([...nodes].some(id => ENCLOSED.has(id))) parts.add("cluster");
  if (CHART.loop && nodes.has(CHART.loop.mark)) parts.add("loop");
  return parts;
}

// Pointing at a legend entry lights the steps it configures. No single
// route is implied, so the wires stay out of it.
function hoverCard(target) {
  const setting = SETTINGS.find(entry => entry.id === target);
  const nodes = new Set(
    setting
      ? [setting.node]
      : CHART.nodes
          .filter(node => node.roles.includes(target))
          .map(node => node.id)
  );
  applyHighlight({
    nodes, edges: new Set(), cards: new Set([target]),
    parts: loopParts(nodes), self: null,
  });
}

// Several steps run one role, so every control for that role moves
// together; the change is visible rather than hidden.
function choiceFor(roleId, provider, model) {
  return (roles[roleId].choices || []).find(
    choice => choice.known &&
      choice.provider === provider && choice.id === model
  );
}

function selectThinking(select, roleId, provider, model, preferred) {
  const choice = choiceFor(roleId, provider, model);
  const levels = choice ? choice.thinking_levels : [];
  select.replaceChildren();
  if (!levels.length) {
    const option = document.createElement("option");
    option.value = "";
    option.textContent = choice ? "unavailable" : "manual setup";
    select.appendChild(option);
    select.disabled = true;
    return null;
  }
  const remembered = preferred ||
    (provider === roles[roleId].provider &&
     model === roles[roleId].model ? roles[roleId].thinking : "");
  const chosen = levels.includes(remembered)
    ? remembered
    : (choice.default_thinking || levels[0]);
  for (const level of levels) {
    const option = document.createElement("option");
    option.value = level;
    option.textContent = level;
    option.selected = level === chosen;
    select.appendChild(option);
  }
  select.disabled = false;
  return chosen;
}

function syncRole(roleId, provider, model, preferredThinking) {
  const preset = ENDPOINTS.some(item => item.id === endpointChoice(roleId));
  const known = preset || Boolean(choiceFor(roleId, provider, model));
  document.querySelectorAll(
    `select[data-step="${roleId}"][data-kind="model"]`
  ).forEach(select => {
    select.value = known ? model : "__custom__";
    const box = select.closest(".cardctl");
    const card = CHART.legend.cards.find(
      entry => entry.target === box.dataset.card
    );
    if (card) layoutRow(box, card, select.value === "__custom__");
  });
  document.querySelectorAll(`input[data-step="${roleId}"][data-kind="custom"]`)
    .forEach(input => {
      if (!known && input.value !== model) input.value = model;
    });
  document.querySelectorAll(
    `select[data-step="${roleId}"][data-kind="thinking"]`
  ).forEach(select => selectThinking(
    select, roleId, provider, model, preferredThinking
  ));
}

// The endpoint control carries both meanings: a named third-party endpoint,
// or which first-party provider the role talks to.
function endpointChoice(id) {
  const select = document.querySelector(
    `select[data-step="${id}"][data-kind="endpoint"]`
  );
  return select ? select.value : "";
}

function currentEndpoint(id) {
  const value = endpointChoice(id);
  return ENDPOINTS.some(item => item.id === value) ? value : "";
}

function currentProvider(id) {
  const value = endpointChoice(id);
  const preset = ENDPOINTS.find(item => item.id === value);
  return preset ? preset.adapter : value;
}

function currentModel(id) {
  const select = document.querySelector(
    `select[data-step="${id}"][data-kind="model"]`
  );
  if (!select) return "";
  if (select.value !== "__custom__") return select.value;
  const custom = select.parentNode.querySelector('input[data-kind="custom"]');
  return custom ? custom.value.trim() : "";
}

function currentThinking(id) {
  const select = document.querySelector(
    `select[data-step="${id}"][data-kind="thinking"]`
  );
  return !select || select.disabled ? null : select.value;
}

function currentSetting(id) {
  const select = document.querySelector(`select[data-setting="${id}"]`);
  return select ? Number(select.value) : null;
}

function changes() {
  const out = {};
  for (const id of Object.keys(original)) {
    const endpoint = currentEndpoint(id);
    const model = currentModel(id);
    const thinking = currentThinking(id);
    if (endpoint) {
      const preset = ENDPOINTS.find(item => item.id === endpoint);
      if (!model || !preset) continue;
      if (
        endpoint !== original[id].endpoint ||
        model !== original[id].model ||
        preset.adapter !== original[id].provider
      ) {
        out[id] = {endpoint, model, provider: preset.adapter};
      }
      continue;
    }
    const provider = currentProvider(id);
    if (original[id].endpoint) {
      // Leaving an endpoint always counts as a change, even when the
      // model text happens to be unchanged.
      if (provider && model) {
        out[id] = {endpoint: "", provider, model};
        if (thinking !== null) out[id].thinking = thinking;
      }
      continue;
    }
    if (
      provider && model &&
      (provider !== original[id].provider ||
       model !== original[id].model ||
       (thinking !== null && thinking !== original[id].thinking))
    ) {
      out[id] = {provider, model};
      if (thinking !== null) out[id].thinking = thinking;
    }
  }
  for (const setting of SETTINGS) {
    const value = currentSetting(setting.id);
    if (value !== null && value !== originalSettings[setting.id]) {
      out[setting.id] = { value };
    }
  }
  return out;
}

async function post(endpoint, body) {
  const response = await fetch(TOKEN_PATH + endpoint, {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  return response.json();
}

document.addEventListener("input", event => {
  const data = event.target.dataset || {};
  if (data.step && (data.kind === "custom" || data.kind === "provider")) {
    syncRole(
      data.step,
      currentProvider(data.step),
      currentModel(data.step),
      currentThinking(data.step)
    );
  }
  applyButton.disabled = true;
});

document.addEventListener("change", event => {
  const data = event.target.dataset || {};
  if (data.kind === "endpoint" && data.step) {
    // The card's whole shape depends on the endpoint, so rebuild it from
    // a state copy carrying the new selection.
    const step = STATE.find(entry => entry.id === data.step);
    if (step) {
      const preset = ENDPOINTS.find(item => item.id === event.target.value);
      if (preset) {
        step.endpoint = preset.id;
        step.provider = preset.adapter;
        if (!preset.models.includes(step.model) && preset.models.length) {
          step.model = preset.models[0];
        }
      } else {
        // A first-party provider: the role keeps its own model when that
        // provider serves it, and otherwise takes that provider's first.
        const initial = original[data.step];
        const catalogue = (step.choices || []).filter(
          choice => choice.known && choice.provider === event.target.value
        );
        step.endpoint = "";
        step.provider = event.target.value;
        const same = initial.provider === step.provider && !initial.endpoint;
        step.model = same
          ? initial.model
          : (catalogue.length ? catalogue[0].id : step.model);
        step.thinking = same
          ? initial.thinking
          : (catalogue.length ? catalogue[0].default_thinking || "" : "");
      }
      replaceCard(data.step);
      applyButton.disabled = true;
      return;
    }
  }
  if (data.kind === "model") {
    const box = event.target.closest(".cardctl");
    const card = box && CHART.legend.cards.find(
      entry => entry.target === box.dataset.card
    );
    if (card) layoutRow(box, card, event.target.value === "__custom__");
  }
  if (data.step) {
    syncRole(
      data.step,
      currentProvider(data.step),
      currentModel(data.step),
      currentThinking(data.step)
    );
  }
  applyButton.disabled = true;
});

document.getElementById("preview").addEventListener("click", async () => {
  const body = changes();
  if (!Object.keys(body).length) {
    result.innerHTML = "<p>No changes to preview.</p>"; return;
  }
  const reply = await post("preview", body);
  if (reply.error) {
    result.innerHTML = `<p class="err">${esc(reply.error)}</p>`; return;
  }
  if (!reply.edits.length) {
    result.innerHTML = "<p>Everything already matches.</p>"; return;
  }
  result.innerHTML = "<h3>Exactly this will change:</h3>" +
    reply.edits.map(e => `<pre>${esc(e.diff)}</pre>`).join("");
  applyButton.disabled = false;
});

applyButton.addEventListener("click", async () => {
  applyButton.disabled = true;
  const reply = await post("apply", changes());
  if (reply.error) {
    result.innerHTML = `<p class="err">${esc(reply.error)}</p>`; return;
  }
  const doctor = reply.doctor_pass === null ? "" :
    `<h3>Doctor: <span class="${reply.doctor_pass ? "ok" : "err"}">` +
    `${reply.doctor_pass ? "READY" : "attention needed"}</span></h3>` +
    `<pre>${esc(reply.doctor_tail)}</pre>`;
  result.innerHTML = `<h3 class="ok">Applied: ${esc(reply.applied.join(", "))}</h3>` +
    doctor +
    '<p class="note">Reload to edit further; the kit repository now holds these values, ready to commit.</p>';
});

document.addEventListener("keydown", event => {
  if (event.key === "Escape" && pinned) {
    pinned = null;
    applyHighlight(null);
  }
});

document.getElementById("revert").addEventListener("click", () => location.reload());

const revokeStanding = document.getElementById("revoke-standing");
if (revokeStanding) {
  revokeStanding.addEventListener("click", async () => {
    revokeStanding.disabled = true;
    const reply = await post("revoke", {});
    if (reply.error) {
      result.innerHTML = `<p class="err">${esc(reply.error)}</p>`;
      revokeStanding.disabled = false;
      return;
    }
    location.reload();
  });
}

render();
</script>
</body>
</html>
"""


def script_json(value: Any) -> str:
    """JSON safe to embed in a <script> element.

    JSON encoding alone does not escape `</script>`, so a value containing
    one would end the element and let the rest execute as markup. The
    characters that can start a tag or a comment are escaped instead.
    """
    return (
        json.dumps(value)
        .replace("<", "\\u003c")
        .replace(">", "\\u003e")
        .replace("&", "\\u0026")
        .replace(" ", "\\u2028")
        .replace(" ", "\\u2029")
    )


def render_page(token: str) -> str:
    manifest = load_manifest()
    live = [
        provider
        for provider, source in CATALOGUE_DISCOVERY.sources.items()
        if source == "installed CLI"
    ]
    if len(live) == len(PROVIDERS):
        catalogue_note = (
            "Models and thinking levels were discovered from the installed "
            "Claude and Codex CLIs."
        )
    else:
        fallback = [
            provider
            for provider in PROVIDERS
            if provider not in live
        ]
        catalogue_note = (
            "Live model discovery is using the bundled fallback for "
            f"{', '.join(fallback)}."
        )
    replacements = {
        "__STATE__": script_json(snapshot(manifest)),
        "__SETTINGS__": script_json(settings_snapshot(manifest)),
        "__CHART__": script_json(manifest.get("chart", {})),
        "__ENDPOINTS__": script_json(endpoint_presets()),
        "__TOKEN_PATH__": script_json(f"/t/{token}/"),
        "__CATALOGUE_NOTE__": script_json(catalogue_note),
        "__STANDING__": standing_html(),
    }
    # One pass, so a substituted value that happens to contain another
    # placeholder is served verbatim rather than substituted again.
    return re.sub(
        "|".join(map(re.escape, replacements)),
        lambda match: replacements[match.group(0)],
        PAGE_TEMPLATE,
    )


def standing_html() -> str:
    """The active standing approvals, or nothing at all.

    Rendered server-side so the control exists only when there is
    something real to revoke; the page never implies configurability
    that is not there.
    """
    try:
        records = list_standing()
    except OSError:
        records = []
    if not records:
        return ""
    items = "".join(
        f"<li>{html.escape(describe_standing(record))}</li>"
        for record in records
    )
    return (
        '<div class="scopenote">'
        "<strong>Standing fallback approvals</strong> — prior recorded "
        "consent; every use is disclosed and the approval expires by "
        f"itself:<ul>{items}</ul>"
        '<button id="revoke-standing" class="btn btn-ghost" type="button">'
        "Revoke standing fallbacks</button>"
        "</div>"
    )


def print_state() -> int:
    manifest = load_manifest()
    for state in snapshot(manifest):
        thinking = (
            f" · thinking {state['thinking']}"
            if state.get("thinking")
            else " · thinking unavailable"
        )
        print(f"{state['title']:24} {state['provider']:10} "
              f"{state['model']}{thinking}   [{state['file']}]")
    for setting in settings_snapshot(manifest):
        print(
            f"{setting['label']:24} {'workflow':10} "
            f"{setting['value']} "
            f"[{setting['minimum']}–{setting['maximum']}; "
            "global/orchestration.json]"
        )
    for record in list_standing():
        print(
            f"{'Standing fallback':24} {'consent':10} "
            f"{describe_standing(record)}"
        )
    return 0


class Handler(BaseHTTPRequestHandler):
    token = ""
    # Single-use redirect credential handed to the browser, cleared by
    # the first request that presents it.
    claim = ""
    lock = threading.Lock()
    last_activity = time.time()
    # The exact edit each file was last previewed with. An apply is only
    # honoured for the change its operator actually saw.
    previewed: dict[str, dict[str, str]] = {}

    def log_message(self, *arguments: Any) -> None:
        pass

    def touch(self) -> bool:
        # Authenticate first: unauthenticated traffic must never keep the
        # server alive past its idle timeout.
        prefix = f"/t/{Handler.token}/"
        if not secrets.compare_digest(self.path[: len(prefix)], prefix):
            self.send_error(404)
            return False
        Handler.last_activity = time.time()
        return True

    def endpoint(self) -> str:
        return self.path[len(f"/t/{Handler.token}/") :]

    def reply(self, payload: dict[str, Any], status: int = 200) -> None:
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def redeem_claim(self) -> bool:
        """Spend a one-time claim and send the browser to the page."""
        prefix = "/c/"
        if not self.path.startswith(prefix):
            return False
        supplied = self.path[len(prefix):].strip("/")
        with Handler.lock:
            expected = Handler.claim
            if not expected or not secrets.compare_digest(
                supplied,
                expected,
            ):
                self.send_error(404)
                return True
            Handler.claim = ""
            Handler.last_activity = time.time()
        self.send_response(302)
        self.send_header("Location", f"/t/{Handler.token}/")
        self.send_header("Content-Length", "0")
        self.end_headers()
        return True

    def do_GET(self) -> None:
        if self.redeem_claim():
            return
        if not self.touch():
            return
        if self.endpoint() not in ("", "/"):
            self.send_error(404)
            return
        body = render_page(Handler.token).encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:
        if not self.touch():
            return
        try:
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                raise ConfigError("invalid Content-Length")
            # A request only ever carries a handful of short model names.
            if length < 0 or length > MAX_BODY_BYTES:
                raise ConfigError(
                    f"the request body may not exceed {MAX_BODY_BYTES} bytes"
                )
            changes = json.loads(self.rfile.read(length) or b"{}")
            if not isinstance(changes, dict):
                raise ConfigError("the request body must be a JSON object")

            if self.endpoint() == "preview":
                with Handler.lock:
                    edits = plan(changes)
                    for edit in edits:
                        Handler.previewed[edit["file"]] = {
                            "before": edit["before"],
                            "after": edit["after"],
                        }
                # The previous content is internal bookkeeping for the
                # apply-time check, not something the page needs.
                self.reply(
                    {
                        "edits": [
                            {key: value for key, value in edit.items()
                             if key != "before"}
                            for edit in edits
                        ]
                    }
                )
            elif self.endpoint() == "apply":
                with Handler.lock:
                    self.reply(apply_edits(plan(changes), Handler.previewed))
            elif self.endpoint() == "revoke":
                with Handler.lock:
                    removed = revoke_standing()
                self.reply(
                    {
                        "revoked": [
                            describe_standing(record) for record in removed
                        ]
                    }
                )
            else:
                self.send_error(404)
        except (ConfigError, json.JSONDecodeError, OSError) as exc:
            self.reply({"error": str(exc)}, status=400)


def serve(port: int, timeout: float, open_browser: bool) -> int:
    Handler.token = secrets.token_hex(12)
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    origin = f"http://127.0.0.1:{server.server_address[1]}"
    url = f"{origin}/t/{Handler.token}/"

    def watch_idle() -> None:
        while True:
            time.sleep(1)
            if time.time() - Handler.last_activity > timeout:
                print("Idle timeout reached; exiting.", flush=True)
                server.shutdown()
                return

    threading.Thread(target=watch_idle, daemon=True).start()

    print(f"CONFIG_URL={url}", flush=True)
    print(
        f"Serving the configuration page at {url}\n"
        f"Bound to 127.0.0.1 only; exits after {int(timeout)}s idle "
        "or on Ctrl-C.",
        flush=True,
    )
    if open_browser:
        # The browser is handed a single-use claim rather than the
        # session token: a command line is readable by other local
        # users through /proc, and the claim is spent by the browser's
        # own first request. A file:// launcher cannot be used instead,
        # because a confined browser (snap, flatpak) has a private /tmp
        # and would report the file as missing.
        Handler.claim = secrets.token_urlsafe(18)
        webbrowser.open(f"{origin}/c/{Handler.claim}")

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("Interrupted; exiting.", flush=True)
    finally:
        server.server_close()
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Configure the Órrery orchestration visually."
    )
    parser.add_argument("--print", action="store_true", dest="print_state")
    parser.add_argument("--port", type=int, default=0)
    parser.add_argument("--timeout", type=float, default=600)
    parser.add_argument("--no-browser", action="store_true")
    arguments = parser.parse_args()

    try:
        activate_discovered_catalogue()
        for warning in CATALOGUE_DISCOVERY.warnings:
            print(f"Model discovery: {warning}", file=sys.stderr, flush=True)
        if arguments.print_state:
            return print_state()
        return serve(
            arguments.port,
            arguments.timeout,
            open_browser=not arguments.no_browser,
        )
    except ConfigError as exc:
        print(f"orrery-config: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
