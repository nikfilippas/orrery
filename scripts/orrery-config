  .cnode .info:hover, .cnode .info:focus-visible { opacity: 1; background: rgba(255,255,255,.4); }
  .tip {
    position: absolute; top: 22px; right: 0; width: 250px; z-index: 60;
    background: var(--panel); color: var(--ink); border: 1px solid var(--edge);
