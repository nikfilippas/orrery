#!/usr/bin/env python3
"""Visual configuration surface for the Órrery orchestration kit.

Serves a single local page generated from the orchestration manifest and
the live configuration files, showing the whole pipeline with the model
behind each step. Changes are previewed as unified diffs and applied only
through the kit's own write paths, then validated by the doctor. The page
is a veneer over the files; it never holds knowledge of its own.
"""

from __future__ import annotations

import argparse
import difflib
import json
import os
import re
import secrets
import subprocess
import sys
import tempfile
import threading
import time
import tomllib
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any


KIT_DIR = Path(__file__).resolve().parent.parent

# A request carries only a few short model names.
MAX_BODY_BYTES = 64 * 1024
THINKING_LEVELS = ("low", "medium", "high", "xhigh", "max", "ultra")
CLAUDE_EFFORT_ENV = "CLAUDE_CODE_EFFORT_LEVEL"


class ConfigError(Exception):
    pass


def load_manifest() -> dict[str, Any]:
    path = KIT_DIR / "global" / "orchestration.json"
    manifest = json.loads(path.read_text())
    steps = manifest.get("steps")
    if not isinstance(steps, list) or not steps:
        raise ConfigError(f"no steps defined in {path}")
    return manifest


def integer_setting_state(
    setting_id: str,
    definition: dict[str, Any],
) -> dict[str, Any]:
    """Validate and expose one bounded integer orchestration setting."""
    value = definition.get("value")
    minimum = definition.get("minimum")
    maximum = definition.get("maximum")
    if any(isinstance(item, bool) or not isinstance(item, int)
           for item in (value, minimum, maximum)):
        raise ConfigError(f"{setting_id} must define integer value/minimum/maximum")
    if minimum > maximum or not minimum <= value <= maximum:
        raise ConfigError(
            f"{setting_id} must be between {minimum} and {maximum}, got {value}"
        )
    if setting_id == "plan_review_rounds" and (minimum, maximum) != (1, 4):
        raise ConfigError("plan_review_rounds must remain bounded from 1 to 4")
    node = definition.get("node")
    label = definition.get("label")
    description = definition.get("description")
    if not all(isinstance(item, str) and item.strip()
               for item in (node, label, description)):
        raise ConfigError(
            f"{setting_id} must name a node, label and description"
        )
    return {
        "id": setting_id,
        "kind": "integer",
        "value": value,
        "minimum": minimum,
        "maximum": maximum,
        "node": node,
        "label": label,
        "description": description,
        "choices": list(range(minimum, maximum + 1)),
    }


def settings_snapshot(
    manifest: dict[str, Any] | None = None,
) -> list[dict[str, Any]]:
    if manifest is None:
        manifest = load_manifest()
    settings = manifest.get("settings", {})
    if not isinstance(settings, dict):
        raise ConfigError("the manifest settings must be an object")
    if "plan_review_rounds" not in settings:
        raise ConfigError("the manifest must define plan_review_rounds")
    node_ids = {
        node.get("id")
        for node in manifest.get("chart", {}).get("nodes", [])
        if isinstance(node, dict)
    }
    states: list[dict[str, Any]] = []
    for setting_id, definition in settings.items():
        if not isinstance(setting_id, str) or not isinstance(definition, dict):
            raise ConfigError("every orchestration setting must be a named object")
        state = integer_setting_state(setting_id, definition)
        if state["node"] not in node_ids:
            raise ConfigError(
                f"{setting_id} names missing chart node {state['node']}"
            )
        states.append(state)
    return states


def read_toml(path: Path) -> dict[str, Any]:
    with path.open("rb") as handle:
        return tomllib.load(handle)


BARE_KEY = re.compile(r"^[A-Za-z0-9_-]+$")


def toml_value(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, str):
        # JSON string quoting is valid TOML basic-string quoting, but only
        # without ASCII escaping: json's \uXXXX form uses surrogate pairs
        # for astral characters, and a TOML escape must be a scalar value.
        return json.dumps(value, ensure_ascii=False)
    raise ConfigError(
        f"cannot rewrite a profile containing a non-scalar value: {value!r}"
    )


def toml_key(key: str) -> str:
    """Render a key, quoting anything that is not a bare key.

    An unquoted key containing a space is invalid TOML, and one containing
    a dot means something else entirely, so a key that was quoted in the
    original must stay quoted.
    """
    return key if BARE_KEY.match(key) else json.dumps(key, ensure_ascii=False)


def load_catalogue() -> dict[str, list[dict[str, Any]]]:
    """Models offered in the dropdowns, per provider.

    The choices and their current thinking capabilities are curated rather
    than inferred from a model name. Anything absent can still be typed in,
    and the current value is represented even when the catalogue does not
    mention it.
    """
    path = KIT_DIR / "global" / "model-catalogue.json"
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise ConfigError(f"the model catalogue is unreadable: {exc}") from exc
    if not isinstance(data, dict):
        raise ConfigError("the model catalogue root must be an object")
    providers = data.get("providers", {})

    if not isinstance(providers, dict):
        raise ConfigError("the model catalogue providers must be an object")

    catalogue: dict[str, list[dict[str, Any]]] = {}
    for provider, entries in providers.items():
        if not isinstance(entries, list):
            raise ConfigError(f"the {provider} model catalogue must be a list")
        seen: set[str] = set()
        parsed: list[dict[str, Any]] = []
        for entry in entries:
            if not isinstance(entry, dict):
                raise ConfigError(f"every {provider} model must be an object")
            model = entry.get("id")
            label = entry.get("label")
            levels = entry.get("thinking_levels")
            default = entry.get("default_thinking")
            if not isinstance(model, str) or not model.strip():
                raise ConfigError(f"every {provider} model needs an id")
            if model in seen:
                raise ConfigError(f"duplicate {provider} model: {model}")
            if not isinstance(label, str) or not label.strip():
                raise ConfigError(f"{model} needs a plain dropdown label")
            if not isinstance(levels, list) or any(
                not isinstance(level, str) or level not in THINKING_LEVELS
                for level in levels
            ):
                raise ConfigError(
                    f"{model} has invalid thinking_levels"
                )
            if len(levels) != len(set(levels)):
                raise ConfigError(f"{model} repeats a thinking level")
            expected_order = [
                level for level in THINKING_LEVELS if level in levels
            ]
            if levels != expected_order:
                raise ConfigError(
                    f"{model} thinking levels must follow "
                    f"{', '.join(THINKING_LEVELS)}"
                )
            if default is not None and default not in levels:
                raise ConfigError(
                    f"{model} default_thinking is not available for that model"
                )
            if not levels and default is not None:
                raise ConfigError(
                    f"{model} cannot have a thinking default without levels"
                )
            parsed.append(
                {
                    "id": model,
                    "label": label,
                    "thinking_levels": levels,
                    "default_thinking": default,
                    "known": True,
                }
            )
            seen.add(model)
        catalogue[provider] = parsed
    return catalogue


def model_choices(step: dict[str, Any], current: str) -> list[dict[str, Any]]:
    """The exact curated choices plus a safe representation of a custom one."""
    choices: list[dict[str, Any]] = []
    seen: set[str] = set()

    for entry in load_catalogue().get(step.get("provider", ""), []):
        if entry["id"] not in seen:
            choices.append(dict(entry))
            seen.add(entry["id"])

    if current and current not in seen:
        choices.append(
            {
                "id": current,
                "label": current,
                "thinking_levels": [],
                "default_thinking": None,
                "known": False,
            }
        )

    return choices


def claude_thinking(settings: dict[str, Any]) -> str:
    environment = settings.get("env", {})
    if environment is not None and not isinstance(environment, dict):
        raise ConfigError("Claude env must be an object")
    persisted = settings.get("effortLevel")
    if persisted is not None and not isinstance(persisted, str):
        raise ConfigError("Claude effortLevel must be a string")
    override = None
    if isinstance(environment, dict):
        override = environment.get(CLAUDE_EFFORT_ENV)
        if override is not None and not isinstance(override, str):
            raise ConfigError(f"Claude {CLAUDE_EFFORT_ENV} must be a string")
    if persisted is not None and override is not None:
        raise ConfigError(
            "Claude thinking uses both effortLevel and "
            f"{CLAUDE_EFFORT_ENV}; keep only the effective representation"
        )
    return override or persisted or ""


def set_claude_thinking(
    settings: dict[str, Any],
    thinking: str | None,
) -> None:
    """Store a Claude thinking choice in the representation it supports."""
    settings.pop("effortLevel", None)
    environment = settings.get("env", {})
    if not isinstance(environment, dict):
        raise ConfigError("Claude env must be an object")
    environment = dict(environment)
    environment.pop(CLAUDE_EFFORT_ENV, None)

    if thinking == "max":
        environment[CLAUDE_EFFORT_ENV] = thinking
    elif thinking:
        settings["effortLevel"] = thinking

    if environment:
        settings["env"] = environment
    else:
        settings.pop("env", None)


def step_state(step: dict[str, Any]) -> dict[str, Any]:
    path = KIT_DIR / step["file"]
    state: dict[str, Any] = {
        "id": step["id"],
        "title": step["title"],
        "provider": step["provider"],
        "kind": step["kind"],
        "file": step["file"],
        "summary": step.get("summary", ""),
        "selects": step.get("selects", ""),
        "profile": step.get("profile", ""),
    }

    if step["kind"] == "claude-settings":
        settings = json.loads(path.read_text())
        state["model"] = settings.get("model", "")
        state["thinking"] = claude_thinking(settings)
        live = Path.home() / ".claude" / "settings.json"
        try:
            live_settings = json.loads(live.read_text())
            state["live_model"] = live_settings.get("model", "")
            state["live_thinking"] = claude_thinking(live_settings)
        except (OSError, json.JSONDecodeError):
            state["live_model"] = ""
            state["live_thinking"] = ""
    elif step["kind"] == "codex-profile":
        profile = read_toml(path)
        state["model"] = profile.get("model", "")
        state["thinking"] = profile.get("model_reasoning_effort", "")
    else:
        raise ConfigError(f"unknown step kind: {step['kind']}")

    state["choices"] = model_choices(step, state["model"])
    return state


def snapshot(
    manifest: dict[str, Any] | None = None,
) -> list[dict[str, Any]]:
    if manifest is None:
        manifest = load_manifest()
    return [step_state(step) for step in manifest["steps"]]


MODEL_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:@/+-]*(\[[A-Za-z0-9.]+\])?$")


def validate_model(value: Any) -> str:
    """Accept only what a model identifier can legitimately look like.

    An allow-list rather than a deny-list: the value is written into TOML
    and JSON and rendered into a page, so nothing resembling markup, a
    quote, or a newline may pass at all.
    """
    if not isinstance(value, str) or not value.strip():
        raise ConfigError("a model must be a non-empty string")
    candidate = value.strip()
    if len(candidate) > 120:
        raise ConfigError("a model name cannot exceed 120 characters")
    if not MODEL_NAME.match(candidate):
        raise ConfigError(
            "a model name may contain only letters, digits and "
            f". _ : @ / + - with an optional [suffix]: {candidate!r}"
        )
    return candidate


def catalogue_choice(
    step: dict[str, Any],
    model: str,
) -> dict[str, Any] | None:
    return next(
        (
            entry
            for entry in load_catalogue().get(step.get("provider", ""), [])
            if entry["id"] == model
        ),
        None,
    )


def resolved_thinking(
    step: dict[str, Any],
    model: str,
    requested: Any,
    *,
    supplied: bool,
) -> str | None:
    """Validate a model/thinking pair and choose a deterministic fallback."""
    current = step_state(step)
    choice = catalogue_choice(step, model)
    if choice is None:
        if supplied and requested not in (None, ""):
            raise ConfigError(
                f"{model} is a custom model, so its available thinking "
                "levels are unknown; configure that level manually"
            )
        return current.get("thinking") or None

    levels = choice["thinking_levels"]
    if not levels:
        if supplied and requested not in (None, ""):
            raise ConfigError(f"{model} does not offer a thinking selector")
        return None

    if supplied:
        if not isinstance(requested, str) or requested not in levels:
            raise ConfigError(
                f"{model} thinking must be one of: {', '.join(levels)}"
            )
        return requested

    current_thinking = current.get("thinking")
    if current_thinking in levels:
        return current_thinking
    return choice.get("default_thinking") or levels[0]


def planned_edit(
    step: dict[str, Any],
    model: str,
    thinking: str | None,
) -> dict[str, Any] | None:
    """The new content one step change produces, or None when unchanged."""
    path = KIT_DIR / step["file"]
    before = path.read_text()

    if step["kind"] == "claude-settings":
        settings = json.loads(before)
        settings["model"] = model
        set_claude_thinking(settings, thinking)
        after = json.dumps(settings, indent=2) + "\n"
    else:
        profile = read_toml(path)
        profile["model"] = model
        if thinking is None:
            profile.pop("model_reasoning_effort", None)
        else:
            profile["model_reasoning_effort"] = thinking
        lines = [f"model = {toml_value(profile.pop('model'))}"]
        effort = profile.pop("model_reasoning_effort", None)
        if effort is not None:
            lines.append(f"model_reasoning_effort = {toml_value(effort)}")
        for key in sorted(profile):
            lines.append(f"{toml_key(key)} = {toml_value(profile[key])}")
        after = "\n".join(lines) + "\n"

    if after == before:
        return None

    diff = "".join(
        difflib.unified_diff(
            before.splitlines(keepends=True),
            after.splitlines(keepends=True),
            fromfile=f"a/{step['file']}",
            tofile=f"b/{step['file']}",
        )
    )
    return {
        "file": step["file"],
        "before": before,
        "after": after,
        "diff": diff,
    }


def validate_setting_change(
    setting_id: str,
    requested: Any,
    definition: dict[str, Any],
) -> int:
    if not isinstance(requested, dict):
        raise ConfigError(f"invalid change for setting {setting_id}")
    unknown = set(requested) - {"value"}
    if unknown:
        raise ConfigError(
            f"only the value can be changed for {setting_id}, "
            f"not: {sorted(unknown)}"
        )
    value = requested.get("value")
    if isinstance(value, bool) or not isinstance(value, int):
        raise ConfigError(f"{setting_id} must be an integer")
    state = integer_setting_state(setting_id, definition)
    if not state["minimum"] <= value <= state["maximum"]:
        raise ConfigError(
            f"{setting_id} must be between "
            f"{state['minimum']} and {state['maximum']}"
        )
    return value


def planned_settings_edit(
    requested: dict[str, Any],
) -> dict[str, Any] | None:
    """One atomic manifest edit for every requested runtime setting."""
    path = KIT_DIR / "global" / "orchestration.json"
    before = path.read_text()
    manifest = json.loads(before)
    definitions = manifest.get("settings", {})
    if not isinstance(definitions, dict):
        raise ConfigError("the manifest settings must be an object")

    changed: list[str] = []
    for setting_id, change in requested.items():
        definition = definitions.get(setting_id)
        if not isinstance(definition, dict):
            raise ConfigError(f"unknown setting: {setting_id}")
        value = validate_setting_change(setting_id, change, definition)
        if definition.get("value") != value:
            definition["value"] = value
            changed.append(setting_id)

    if not changed:
        return None
    after = json.dumps(manifest, indent=2) + "\n"
    diff = "".join(
        difflib.unified_diff(
            before.splitlines(keepends=True),
            after.splitlines(keepends=True),
            fromfile="a/global/orchestration.json",
            tofile="b/global/orchestration.json",
        )
    )
    return {
        "file": "global/orchestration.json",
        "before": before,
        "after": after,
        "diff": diff,
        "settings": sorted(changed),
    }


def plan(changes: dict[str, Any]) -> list[dict[str, Any]]:
    manifest = load_manifest()
    steps = {step["id"]: step for step in manifest["steps"]}
    settings = manifest.get("settings", {})
    if not isinstance(settings, dict):
        raise ConfigError("the manifest settings must be an object")
    settings_snapshot(manifest)
    edits: list[dict[str, Any]] = []
    requested_settings: dict[str, Any] = {}
    for step_id, requested in changes.items():
        if step_id in settings:
            requested_settings[step_id] = requested
            continue
        if step_id not in steps:
            raise ConfigError(f"unknown step or setting: {step_id}")
        if not isinstance(requested, dict):
            raise ConfigError(f"invalid change for step {step_id}")
        unknown = set(requested) - {"model", "thinking"}
        if unknown:
            raise ConfigError(
                f"only model and thinking can be changed for {step_id}, "
                f"not: {sorted(unknown)}"
            )
        current = step_state(steps[step_id])
        model = validate_model(requested.get("model", current["model"]))
        thinking = resolved_thinking(
            steps[step_id],
            model,
            requested.get("thinking"),
            supplied="thinking" in requested,
        )
        edit = planned_edit(steps[step_id], model, thinking)
        if edit is not None:
            edit["step"] = step_id
            edits.append(edit)
    settings_edit = planned_settings_edit(requested_settings)
    if settings_edit is not None:
        edits.append(settings_edit)
    return edits


def write_atomically(path: Path, content: str) -> None:
    with tempfile.NamedTemporaryFile(
        mode="w",
        dir=path.parent,
        prefix=f".{path.name}.",
        delete=False,
    ) as handle:
        handle.write(content)
        handle.flush()
        os.fsync(handle.fileno())
        temporary = Path(handle.name)
    temporary.replace(path)


def stage_edits(edits: list[dict[str, Any]]) -> list[tuple[Path, Path, str]]:
    """Write every replacement to a sibling temporary file.

    Staging all of them before renaming any means a failure that would
    otherwise leave the configuration half-applied is caught while nothing
    has moved yet. The renames afterwards are individually atomic.
    """
    staged: list[tuple[Path, Path, str]] = []
    try:
        for edit in edits:
            path = KIT_DIR / edit["file"]
            with tempfile.NamedTemporaryFile(
                mode="w",
                dir=path.parent,
                prefix=f".{path.name}.",
                delete=False,
            ) as handle:
                handle.write(edit["after"])
                handle.flush()
                os.fsync(handle.fileno())
                staged.append((Path(handle.name), path, edit["before"]))
    except BaseException:
        for temporary, _destination, _before in staged:
            temporary.unlink(missing_ok=True)
        raise
    return staged


def commit_staged(staged: list[tuple[Path, Path, str]]) -> None:
    """Rename every staged file into place, undoing the set on failure.

    POSIX has no transaction across several files, so all-or-nothing is
    approximated: each destination is re-read immediately before its
    rename, and a failure part way restores the ones already renamed from
    the content the preview recorded. A writer landing inside the window
    between that final read and the rename cannot be excluded without its
    cooperation; the window is microseconds and the check makes anything
    wider than that impossible.
    """
    completed: list[tuple[Path, str, str]] = []
    try:
        for temporary, destination, before in staged:
            if destination.read_text() != before:
                raise ConfigError(
                    f"{destination.name} changed while it was being written. "
                    "Nothing further was applied; preview again."
                )
            applied = temporary.read_text()
            temporary.replace(destination)
            completed.append((destination, before, applied))
    except BaseException:
        # Undo every rename that did land, then clean up. Each rollback is
        # attempted even if an earlier one failed, and a file another
        # writer has since changed is left to that writer rather than
        # having this apply's idea of the past forced back over it.
        problems: list[str] = []
        for destination, before, applied in reversed(completed):
            try:
                if destination.read_text() != applied:
                    problems.append(
                        f"{destination.name} was changed by something else "
                        "after this apply wrote it and was left alone"
                    )
                    continue
                write_atomically(destination, before)
            except OSError as exc:
                problems.append(f"{destination.name} could not be restored: {exc}")

        for temporary, _destination, _before in staged:
            temporary.unlink(missing_ok=True)

        if problems:
            raise ConfigError(
                "The apply failed and the configuration could not be fully "
                "restored: " + "; ".join(problems) + ". Inspect these files "
                "before continuing."
            ) from None
        raise


def run_kit(command: list[str], timeout: float) -> tuple[int, str]:
    result = subprocess.run(
        command,
        cwd=KIT_DIR,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        timeout=timeout,
        check=False,
    )
    return result.returncode, result.stdout


def apply_edits(
    edits: list[dict[str, Any]],
    previewed: dict[str, dict[str, str]],
) -> dict[str, Any]:
    # Only the exact change that was previewed may be applied: both the
    # state it started from and the content it produces must match what
    # the operator saw, so neither an external edit nor a different model
    # slipped into the apply request can pass.
    for edit in edits:
        expected = previewed.get(edit["file"])
        if expected is None:
            raise ConfigError(
                f"{edit['file']} was not previewed. Preview the changes "
                "before applying them."
            )
        if expected["before"] != edit["before"]:
            raise ConfigError(
                f"{edit['file']} changed since the preview was computed. "
                "Nothing was written; reload the page and preview again."
            )
        if expected["after"] != edit["after"]:
            raise ConfigError(
                f"the change requested for {edit['file']} is not the one "
                "that was previewed. Nothing was written; preview again."
            )

    commit_staged(stage_edits(edits))

    result: dict[str, Any] = {
        "applied": [edit["file"] for edit in edits],
        "propagated": None,
        "doctor_pass": None,
        "doctor_tail": "",
    }

    if any(edit.get("step") == "orchestrator" for edit in edits):
        # The canonical settings changed; the kit's own applier carries the
        # model into the live settings atomically, with a backup.
        status, output = run_kit(
            [
                sys.executable,
                str(KIT_DIR / "scripts" / "apply-claude-settings.py"),
                "--model",
                "--effort",
            ],
            timeout=60,
        )
        result["propagated"] = {"status": status, "output": output.strip()}

    doctor = KIT_DIR / "scripts" / "doctor.sh"
    if doctor.exists():
        try:
            status, output = run_kit(["bash", str(doctor)], timeout=300)
        except subprocess.TimeoutExpired:
            status, output = 1, "the doctor timed out"
        result["doctor_pass"] = status == 0
        result["doctor_tail"] = "\n".join(output.splitlines()[-14:])

    return result


PAGE_TEMPLATE = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Órrery configuration</title>
<style>
  :root {
    --ground: #f3f5f6; --panel: #ffffff; --edge: #d9dfe3;
    --ink: #1b2226; --soft: #4c5a63; --accent: #38617f; --accent-ink: #ffffff;
    --mechanic: #737d94; --implementer: #587b50; --plan-reviewer: #8a6a9c; --reviewer: #a97a24;
    --wire: #8b969d; --code: #1d2428; --code-ink: #d7e0e5; --bad: #a33b3b; --good: #3d7a4a;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ground: #14181b; --panel: #1c2226; --edge: #2c353b;
      --ink: #dde3e6; --soft: #a6b2b9; --accent: #7fa8c9; --accent-ink: #10161a;
      --mechanic: #98a2b8; --implementer: #86a97e; --plan-reviewer: #b294c4; --reviewer: #cfa04a;
