#!/usr/bin/env python3
"""Notify direct Claude/Codex sessions when they bypass Orrery's principal."""

from __future__ import annotations

import json
import os
import re
import sys
import time
import tomllib
from pathlib import Path
from typing import Any


sys.path.insert(0, str(Path(__file__).resolve().parent))

from orrery_fallback import nearest_fallback, provider_label  # noqa: E402
from orrery_runtime import (  # noqa: E402
    MODEL_ID,
    PROVIDERS,
    THINKING_LEVEL,
    Role,
    RuntimeConfigError,
    adopted_root,
    codex_home,
    load_role,
)
import orrery_incidents as incident_log  # noqa: E402


MAX_INPUT_BYTES = 1024 * 1024
PROGRAM = "orrery-session-start"
PERSISTED_EFFORTS = frozenset({"low", "medium", "high", "xhigh"})


def surface_default_matches(role: Role, active_provider: str) -> bool:
    """Whether the surface's configured *default* is the configured role.

    This is deliberately not a claim about what is running. The model
    in a provider's configuration is only a default: the interface's
    own picker and an in-session `/model` both override it, and
    neither is visible to a hook. Treating agreement here as proof of
    the active model would manufacture a false assertion, which is
    exactly what the principal check exists to prevent. It answers one
    narrower question: does the stored default still agree with the
    manifest, or has it drifted and needs `orrery-sync`?
    """
    if active_provider != role.provider:
        return False
    try:
        if active_provider == "anthropic":
            live = json.loads(
                (Path.home() / ".claude" / "settings.json").read_text()
            )
            if not isinstance(live, dict) or live.get("model") != role.model:
                return False
            environment = (
                live.get("env") if isinstance(live.get("env"), dict) else {}
            )
            persisted = live.get("effortLevel")
            active = environment.get("CLAUDE_CODE_EFFORT_LEVEL")
            if role.thinking is None:
                return persisted is None and active is None
            if role.thinking in PERSISTED_EFFORTS:
                return persisted == role.thinking and active is None
            # max is honoured only through the environment key.
            return active == role.thinking and persisted is None
        data = tomllib.loads((codex_home() / "config.toml").read_text())
        if data.get("model") != role.model:
            return False
        return (
            not role.thinking
            or data.get("model_reasoning_effort") == role.thinking
        )
    except Exception:  # noqa: BLE001 - a hook must never fail a session
        return False


def environment_effort() -> str | None:
    """The session's thinking level, when this surface exports it.

    CLAUDE_CODE_EFFORT_LEVEL and CLAUDE_EFFORT are Claude settings, so
    callers consult them only on an anthropic surface; an OpenAI
    session's reasoning level is not observable here.
    """
    for name in ("CLAUDE_CODE_EFFORT_LEVEL", "CLAUDE_EFFORT"):
        value = os.environ.get(name, "").strip().lower()
        if value and THINKING_LEVEL.fullmatch(value):
            return value
    return None


def same_model(provider: str, configured: str, active: str) -> bool:
    if configured == active:
        return True
    if provider != "anthropic":
        return False
    family = configured.lower()
    if family not in {"fable", "opus", "sonnet", "haiku"}:
        return False
    return re.search(
        rf"(?:^|[-_/]){re.escape(family)}(?:[-_/\[\]]|$)",
        active.lower(),
    ) is not None


def parked_announcement() -> str:
    """One line when parked pickup work is due with no timer to fire.

    Tolerant on purpose, unlike orrery-pickup's own strict store
    reading: this announces a pointer and executes nothing, and a
    session must start whatever state the store is in. A delegated
    session gets no announcement; its assignment is bounded.
    """
    if os.environ.get("ORRERY_ROLE"):
        return ""
    state = Path(
        os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state"
    )
    # A store under a granted path is delegate-writable; even a mere
    # pointer should not be forgeable from one. The executor's own
    # strict checks remain the real gate.
    resolved = os.path.realpath(state)
    if any(
        resolved == grant or resolved.startswith(grant + os.sep)
        for grant in ("/tmp", "/var/tmp")
    ) and os.environ.get("ORRERY_ALLOW_TMP_REPOSITORY") != "1":
        return ""
    try:
        payload = json.loads((state / "orrery" / "pickup.json").read_text())
        records = payload.get("records") or []
        now = time.time()
        due = sorted(
            str(entry.get("task_id"))
            for entry in records
            if isinstance(entry, dict)
            and isinstance(entry.get("reset_at"), (int, float))
            and entry["reset_at"] <= now
        )
        timer = payload.get("timer")
        armed = isinstance(timer, dict) and timer.get("phase") == "confirmed"
        if due and not armed:
            return (
                f"Parked Orrery work is runnable ({', '.join(due)}); "
                "run orrery-pickup run."
            )
    except (OSError, ValueError, TypeError):
        return ""
    return ""


def hook_output(system_message: str, context: str) -> dict[str, Any]:
    parked = parked_announcement()
    if parked:
        context = f"{context}\n{parked}" if context else parked
    return {
        "systemMessage": system_message,
        "hookSpecificOutput": {
            "hookEventName": "SessionStart",
            "additionalContext": context,
        },
    }


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in PROVIDERS:
        print(
            json.dumps(
                hook_output(
                    "Orrery could not identify this provider surface.",
                    "Report that Orrery's principal-surface check was "
                    "misconfigured before relying on its result.",
                )
            )
        )
        return 0
    active_provider = sys.argv[1]
    delegated_role = os.environ.get("ORRERY_ROLE", "").strip()
    if delegated_role:
        # A bounded delegate carries its role in the environment set by
        # the runner. Principal comparison does not apply to it, and
        # injecting principal framing here only forces the worker to
        # spend its reply disclaiming the contradiction.
        print(
            json.dumps(
                hook_output(
                    f"Orrery bounded {delegated_role} session; principal "
                    "checks do not apply.",
                    "This is a bounded, non-principal Orrery session. "
                    "Follow the ORRERY ROLE HANDOFF in the prompt. Do not "
                    "adopt principal duties, open replies with a principal "
                    "header, or treat principal-surface guidance as "
                    "applying here.",
                )
            )
        )
        return 0
    try:
        raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
        if len(raw) > MAX_INPUT_BYTES:
            raise ValueError("hook input is too large")
        payload = json.loads(raw or b"{}")
        if not isinstance(payload, dict):
            raise ValueError("hook input is not an object")
        if payload.get("hook_event_name") != "SessionStart":
            return 0
        cwd = payload.get("cwd")
        if not isinstance(cwd, str) or not cwd:
            cwd = str(Path.cwd())
        # Adoption is decided before the payload's model is examined:
        # an un-adopted repository gets a normal single-provider
        # session however incomplete the payload is, rather than
        # principal noise about a comparison that will never apply.
        if (
            adopted_root(Path(cwd)) is None
            and os.environ.get("ORRERY_SESSION") != "principal"
        ):
            print(
                json.dumps(
                    hook_output(
                        "Orrery: repository not adopted; standard "
                        f"{provider_label(active_provider)} session.",
                        "This repository has not been adopted by Orrery: "
                        "there is no .orrery.json at its root (run "
                        "orrery-init to adopt it). Apply only the "
                        "engineering baseline from the global policy. Run "
                        "as a normal single-provider session with the "
                        "model chosen in this interface, and do not "
                        "classify requests into orchestration routes, "
                        "delegate to orrery-agent, run plan-review loops, "
                        "apply the fallback protocol, or require "
                        "principal approval.",
                    )
                )
            )
            return 0
        configured = load_role("orchestrator", cwd=Path(cwd))
    except (OSError, ValueError, json.JSONDecodeError, RuntimeConfigError) as exc:
        detail = re.sub(r"[\r\n]+", " ", str(exc))[:300]
        print(
            json.dumps(
                hook_output(
                    "Orrery could not verify this session's principal: "
                    f"{detail}",
                    "Orrery's principal check failed before any "
                    "comparison. Say so in one short line in your first "
                    "reply; do not claim the configured principal or a "
                    "fallback was verified.",
                )
            )
        )
        incident_log.record(
            "config-error",
            program=PROGRAM,
            detail=detail,
            active_provider=active_provider,
        )
        return 0

    configured_label = (
        f"{provider_label(configured.provider)} / {configured.model}"
        + (
            f" / thinking {configured.thinking}"
            if configured.thinking
            else ""
        )
    )
    active_model = payload.get("model")
    if (
        not isinstance(active_model, str)
        or not MODEL_ID.fullmatch(active_model)
    ):
        # This surface (for example the VS Code extension) sends no
        # model in its SessionStart payload, so the principal match
        # cannot run at all. That is a property of the surface, not an
        # error in the configuration, and it earns one short line, not
        # an alarm.
        # The active model is genuinely unknowable here, whatever the
        # configuration says, so neither branch below may assert one.
        # The stored default only decides whether this is ordinary
        # (aligned, so nothing to act on) or drifted (actionable).
        aligned = surface_default_matches(configured, active_provider)
        selection_note = (
            "The model chosen in the interface, or with /model, "
            "overrides the stored default and is not visible to this "
            "hook, so it is authoritative over anything Orrery says "
            "here."
        )
        if aligned:
            print(
                json.dumps(
                    hook_output(
                        f"Orrery: principal configured as {configured_label}; "
                        "this surface does not report the active model, so "
                        "what is running is unverified.",
                        "This surface's SessionStart payload carries no "
                        "model, so Orrery cannot determine which model is "
                        f"running. The configured principal is "
                        f"{configured_label} and this surface's stored "
                        f"default agrees with it. {selection_note} If you "
                        "mention this at all, use one short line saying the "
                        "principal is configured but unverified for this "
                        "session. Never state that the configured model is "
                        "the one running, and if the interface shows a "
                        "different model, report that instead. This is a "
                        "property of the surface, not an error.",
                    )
                )
            )
            return 0

        effort = (
            environment_effort()
            if active_provider == "anthropic"
            else None
        )
        reference = (
            configured.thinking
            if configured.provider == "anthropic"
            else None
        )
        if effort is not None and reference is not None:
            thinking_note = (
                f"the session's thinking level {effort} matches the "
                "configured level"
                if effort == reference
                else (
                    f"the session reports thinking {effort}, not the "
                    f"configured {reference}"
                )
            )
        elif effort is not None:
            thinking_note = (
                f"the session reports thinking {effort}, which has no "
                "comparable level on the configured provider's scale"
            )
        else:
            thinking_note = "the thinking level is likewise unreported"
        print(
            json.dumps(
                hook_output(
                    f"Orrery: principal configured as {configured_label}; "
                    "this surface does not report the active model, so "
                    "what is running is unverified, and its stored "
                    "default has drifted from the manifest. Run "
                    f"orrery-sync to align it; {thinking_note}.",
                    "This surface's SessionStart payload carries no "
                    "model, so Orrery cannot determine which model is "
                    "running, and this surface's stored default no "
                    "longer matches the configured principal "
                    f"({configured_label}); {thinking_note}. "
                    f"{selection_note} Say in one short line that the "
                    "principal is unverified for this session and that "
                    "orrery-sync would realign the stored default. "
                    "Never state that the configured model is the one "
                    "running, and if the interface shows a different "
                    "model, report that instead.",
                )
            )
        )
        # Recorded only for drift, which is actionable: the stored
        # default disagrees with the manifest and orrery-sync fixes it.
        # An unreported active model is a permanent property of the
        # surface and is not an incident, or the log fills with one
        # entry per session start and buries real failures.
        incident_log.record(
            "principal-drift",
            program=PROGRAM,
            role=configured,
            detail=(
                "the surface's stored default no longer matches the "
                "configured principal; run orrery-sync"
            ),
            active_provider=active_provider,
            session_thinking=effort,
        )
        return 0

    if (
        configured.provider == active_provider
        and same_model(active_provider, configured.model, active_model)
    ):
        return 0

    excluded = set(PROVIDERS) - {active_provider}
    proposal = nearest_fallback(
        configured,
        "the session was opened directly instead of through `orrery`",
        excluded_providers=excluded,
        assumed_ready={active_provider},
        additional_models={active_provider: [active_model]},
        discover_live=False,
    )
    recommended = proposal.candidate if proposal is not None else None
    active_label = (
        f"{provider_label(active_provider)} / {active_model}"
    )
    if recommended is None:
        recommendation = (
            "No potential fallback could be ranked for this provider surface."
        )
    else:
        recommended_label = (
            f"{provider_label(recommended.provider)} / {recommended.model}"
            + (
                f" / thinking {recommended.thinking}"
                if recommended.thinking
                else ""
            )
        )
        recommendation = (
            f"This is the nearest potential fallback ({recommended_label})."
            if same_model(active_provider, recommended.model, active_model)
            else f"The nearest potential fallback is {recommended_label}."
        )

    # The effort variables are Claude settings, so the comparison only
    # runs on an anthropic surface, and against the recommended
    # candidate's position-mapped level rather than the configured
    # provider's raw wording, which may use a different scale.
    effort = (
        environment_effort() if active_provider == "anthropic" else None
    )
    reference = (
        recommended.thinking
        if recommended is not None
        and recommended.provider == "anthropic"
        and active_provider == "anthropic"
        else None
    )
    if effort is not None and reference is not None:
        thinking_sentence = (
            f"The session's thinking level {effort} matches the "
            "recommended level."
            if effort == reference
            else (
                f"The session reports thinking {effort}; the "
                f"recommended level is {reference}."
            )
        )
    else:
        thinking_sentence = (
            "The thinking level is not reported by this surface; ask "
            "the user to verify it where possible."
        )

    system_message = (
        f"Orrery principal mismatch: configured {configured_label}; active "
        f"{active_label}. {recommendation} Explicit approval is required "
        "before this session acts as Orrery's principal."
    )
    context = (
        "ORRERY PRINCIPAL FALLBACK APPROVAL REQUIRED\n"
        f"Configured principal: {configured_label}. Active session: "
        f"{active_label}. {recommendation} {thinking_sentence} Unless "
        "this conversation already holds unrevoked, explicit user "
        "approval for this exact provider/model, tell the user about "
        "the mismatch in one short line and ask whether they approve "
        "this session as the principal fallback before running tools, "
        "editing files, or delegating. Opening the IDE or provider CLI "
        "is not approval. If they decline, change nothing and point "
        "them to `orrery` or a model switch. If they approve, continue "
        "here and report the fallback honestly and briefly."
    )
    print(json.dumps(hook_output(system_message, context)))
    incident_log.record(
        "principal-mismatch",
        program=PROGRAM,
        role=configured,
        detail=f"active session is {active_provider}/{active_model}",
        active_provider=active_provider,
        candidate=(
            f"{recommended.provider}:{recommended.model}"
            if recommended is not None
            else None
        ),
        session_thinking=effort,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
