#!/usr/bin/env python3
"""Aggregate Claude Code and Codex CLI token usage from local session logs.

Claude Code writes one JSONL transcript per session under
~/.claude/projects, with per-message usage. The Codex CLI writes one
rollout file per session under $CODEX_HOME/sessions, with a cumulative
token count per session. Both are read here, never modified. The numbers
are what the providers reported at the time and are an accounting of
usage, not of billing.

`--task` reports a different population entirely. Delegated runs are
ephemeral by design, so they write no session file and appear in no
global scan; their accounting comes from the attempt records the wrapper
writes beside each run. The two views therefore cover disjoint sets of
runs and must never be added together, which the report says out loud
rather than leaving to be inferred.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))
import orrery_spend  # noqa: E402


COLUMNS = ("fresh_in", "cache_read", "cache_write", "output", "total")


def codex_home() -> Path:
    raw = os.environ.get("CODEX_HOME")

    if raw is None:
        raw = str(Path.home() / ".codex")

    if not raw.strip():
        print("orrery-usage: CODEX_HOME cannot be empty", file=sys.stderr)
        raise SystemExit(2)

    return Path(raw).expanduser().resolve(strict=False)


def parse_since(value: str) -> datetime:
    try:
        return datetime.now(timezone.utc) - timedelta(days=int(value))
    except ValueError:
        pass
    try:
        parsed = datetime.fromisoformat(value)
    except ValueError as exc:
        raise SystemExit(
            f"orrery-usage: --since must be a day count or a date: {value}"
        ) from exc
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed


def parse_timestamp(value: Any) -> datetime | None:
    if not isinstance(value, str):
        return None
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed


def new_bucket() -> dict[str, int]:
    bucket = {name: 0 for name in COLUMNS}
    bucket["events"] = 0
    return bucket


def integer(value: Any) -> int:
    return value if isinstance(value, int) and value >= 0 else 0


def read_claude(
    root: Path,
    since: datetime,
    totals: dict[tuple[str, str], dict[str, int]],
) -> int:
    """Aggregate assistant-message usage; one event per API response.

    A response can be recorded more than once, for example when a session
    is resumed into a new transcript, so responses are deduplicated by
    message and request identity across every file.
    """
    seen: set[tuple[str, str]] = set()
    files = 0

    for path in sorted(root.glob("*/*.jsonl")):
        try:
            handle = path.open(encoding="utf-8", errors="replace")
        except OSError:
            continue
        files += 1
        with handle:
            for line in handle:
                try:
                    data = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(data, dict) or data.get("type") != "assistant":
                    continue
                message = data.get("message")
                if not isinstance(message, dict):
                    continue
                usage = message.get("usage")
                if not isinstance(usage, dict):
                    continue

                timestamp = parse_timestamp(data.get("timestamp"))
                if timestamp is None or timestamp < since:
                    continue

                fresh = integer(usage.get("input_tokens"))
                cache_read = integer(usage.get("cache_read_input_tokens"))
                cache_write = integer(usage.get("cache_creation_input_tokens"))
                output = integer(usage.get("output_tokens"))
                if not (fresh or cache_read or cache_write or output):
                    # Synthetic bookkeeping messages carry no tokens. They
                    # are skipped before deduplication so a zero-usage twin
                    # can never swallow the counted row's identity.
                    continue

                message_id = message.get("id")
                if isinstance(message_id, str) and message_id:
                    key = (message_id, str(data.get("requestId", "")))
                    if key in seen:
                        continue
                    seen.add(key)

                model = message.get("model")
                if not isinstance(model, str) or not model:
                    model = "unknown"
                bucket = totals.setdefault(("claude", model), new_bucket())
                bucket["fresh_in"] += fresh
                bucket["cache_read"] += cache_read
                bucket["cache_write"] += cache_write
                bucket["output"] += output
                bucket["total"] += fresh + cache_read + cache_write + output
                bucket["events"] += 1

    return files


def read_codex(
    root: Path,
    since: datetime,
    totals: dict[tuple[str, str], dict[str, int]],
) -> int:
    """Aggregate per-session cumulative usage from rollout files.

    Codex records a running total, so only the last complete count in each
    file matters; summing the intermediate ones would multiply the truth.
    """
    files = 0

    for path in sorted(root.rglob("rollout-*.jsonl")):
        try:
            handle = path.open(encoding="utf-8", errors="replace")
        except OSError:
            continue

        provider = "codex"
        model = "unknown"
        last_usage: dict[str, Any] | None = None
        last_timestamp: datetime | None = None
        # The model current when the count was recorded, not whatever a
        # later turn switched to before the file ended.
        model_at_last_usage = "unknown"

        with handle:
            for line in handle:
                try:
                    data = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(data, dict):
                    continue
                payload = data.get("payload")
                if not isinstance(payload, dict):
                    continue
                kind = payload.get("type") or data.get("type")

                if kind == "session_meta":
                    recorded = payload.get("model_provider")
                    if isinstance(recorded, str) and recorded:
                        provider = recorded
                elif kind == "turn_context":
                    recorded = payload.get("model")
                    if isinstance(recorded, str) and recorded:
                        model = recorded
                elif kind == "token_count":
                    info = payload.get("info")
                    if isinstance(info, dict):
                        usage = info.get("total_token_usage")
                        if isinstance(usage, dict) and usage:
                            last_usage = usage
                            model_at_last_usage = model
                            stamp = parse_timestamp(data.get("timestamp"))
                            if stamp is not None:
                                last_timestamp = stamp

        if last_usage is None:
            continue
        if last_timestamp is None or last_timestamp < since:
            continue

        files += 1
        bucket = totals.setdefault((provider, model_at_last_usage), new_bucket())
        cache_read = integer(last_usage.get("cached_input_tokens"))
        fresh = max(0, integer(last_usage.get("input_tokens")) - cache_read)
        cache_write = integer(last_usage.get("cache_write_input_tokens"))
        output = integer(last_usage.get("output_tokens"))
        total = integer(last_usage.get("total_tokens"))
        bucket["fresh_in"] += fresh
        bucket["cache_read"] += cache_read
        bucket["cache_write"] += cache_write
        bucket["output"] += output
        bucket["total"] += total or (fresh + cache_read + cache_write + output)
        bucket["events"] += 1

    return files


def task_attempts(store: Path, task_id: str) -> tuple[list[dict], int]:
    """Every attempt record for one task, and the runs that left none.

    Dispatches and reviews keep their artefacts in different places, so
    both trees are walked. A dispatch or review directory with no
    attempt record at all is counted rather than ignored: it predates
    this accounting or its artefacts were reclaimed, and either way its
    cost is not zero, it is absent.
    """
    records: list[dict] = []
    unattributed = 0
    roots = [
        directory
        for parent in (store / "dispatch" / task_id, store / "reviews" / task_id)
        if parent.is_dir()
        for directory in sorted(parent.iterdir())
        if directory.is_dir() and not directory.is_symlink()
    ]
    for directory in roots:
        # A dispatch nests its receipts one level deeper; a review does
        # not, and its retry lives in a sibling directory of its own.
        candidates = [directory] + [
            child
            for child in sorted(directory.iterdir())
            if child.is_dir() and child.name.startswith("attempt-")
        ]
        found = 0
        for candidate in candidates:
            for record in orrery_spend.read_attempts(candidate):
                records.append(record)
                found += 1
        if not found:
            unattributed += 1
    return records, unattributed


def price_records(records: list[dict]) -> tuple[float | None, str | None]:
    """Cost for a task's attempts, or why it cannot be given.

    The provider's own billed figure is preferred wherever it exists,
    because it is the truth and needs no maintenance: Claude reports one
    per run. The operator's table is consulted only for the attempts
    that have none, so a Claude-only task can be priced with no table at
    all, and a table that cannot price those attempts refuses rather
    than guessing.
    """
    total = 0.0
    table: dict | None = None
    for record in records:
        usage = record.get("usage")
        if not isinstance(usage, dict):
            # Unknown spend is reported as its own row; it must not be
            # folded into a money figure as though it were nothing.
            continue
        reported = record.get("provider_cost_usd")
        if isinstance(reported, (int, float)) and not isinstance(reported, bool):
            total += float(reported)
            continue
        if table is None:
            from orrery_runtime import RuntimeConfigError, load_manifest

            try:
                table = orrery_spend.price_table(load_manifest())
            except (RuntimeConfigError, orrery_spend.SpendError) as exc:
                return None, str(exc)
            refusal = orrery_spend.price_refusal(table)
            if refusal:
                return None, refusal
        # Tokens the provider says came from another model cannot be
        # charged at this attempt's rate. The provider's own figure
        # already accounts for them, so this only bites the table path.
        named = record.get("reported_models")
        if named and set(named) != {record.get("model")}:
            return None, (
                f"a run on {record.get('model')} reports usage from "
                f"{sorted(named)}, which this attempt's rate cannot price"
            )
        assert table is not None
        rates = orrery_spend.rate_for(
            table, record.get("provider"), record.get("model"),
            record.get("endpoint"),
        )
        if rates is None:
            key = orrery_spend.price_key(
                record.get("provider"), record.get("model"), record.get("endpoint")
            )
            return None, (
                f"the provider reported no cost for this run and the price "
                f"table has no rate for {key}"
            )
        total += orrery_spend.money_of(usage, rates)
    return total, None


def task_report(root: Path, task_id: str, money: bool, as_json: bool) -> int:
    store = root / ".orrery"
    if not (store / "ledger" / f"{task_id}.jsonl").exists():
        print(f"orrery-usage: no such task: {task_id}", file=sys.stderr)
        return 2
    records, unattributed = task_attempts(store, task_id)

    totals: dict[tuple[str, str, str, str], dict[str, int]] = {}
    unknown = 0
    reported_cost = 0.0
    have_reported = False
    for record in records:
        usage = record.get("usage")
        key = (
            str(record.get("role", "unknown")),
            str(record.get("provider", "unknown")),
            str(record.get("model", "unknown")),
            str(record.get("endpoint") or ""),
        )
        bucket = totals.setdefault(key, new_bucket())
        bucket["events"] += 1
        if not isinstance(usage, dict):
            unknown += 1
            continue
        for name in orrery_spend.TOKEN_CLASSES:
            bucket[name] += integer(usage.get(name))
            bucket["total"] += integer(usage.get(name))
        cost = record.get("provider_cost_usd")
        if isinstance(cost, (int, float)):
            reported_cost += float(cost)
            have_reported = True

    computed: float | None = None
    priced_by: set[str] = set()
    if money:
        computed, refusal = price_records(records)
        if refusal is not None:
            print(f"orrery-usage: cannot report money: {refusal}", file=sys.stderr)
            return 2
        priced_by = {
            "the provider's own figure"
            if isinstance(record.get("provider_cost_usd"), (int, float))
            else "the price table"
            for record in records
            if isinstance(record.get("usage"), dict)
        }

    if as_json:
        print(
            json.dumps(
                {
                    "task_id": task_id,
                    "attempts": len(records),
                    "unknown_attempts": unknown,
                    "unattributed_runs": unattributed,
                    "population": "delegated runs only; disjoint from the global scan",
                    "usage": [
                        {
                            "role": role,
                            "provider": provider,
                            "model": model,
                            "endpoint": endpoint or None,
                            **bucket,
                        }
                        for (role, provider, model, endpoint), bucket in sorted(
                            totals.items()
                        )
                    ],
                    "provider_cost_usd": reported_cost if have_reported else None,
                    "computed_cost_usd": computed,
                    "priced_by": sorted(priced_by),
                },
                indent=2,
            )
        )
        return 0

    print(f"Token usage attributed to {task_id}")
    print(
        "Delegated runs are ephemeral and write no session file, so these "
        "figures are disjoint from the global scan and cannot be added to it."
    )
    print()
    print(f"{'ATTRIBUTION':14} {'RUNS':>5}  MEANING")
    print(f"{'attributed':14} {len(records) - unknown:>5}  usage parsed and counted below")
    print(
        f"{'unknown':14} {unknown:>5}  a provider run started and its usage "
        "was not recovered"
    )
    print(
        f"{'unattributed':14} {unattributed:>5}  a run left no attempt record; "
        "it predates this accounting or never started a provider"
    )
    print()
    header = (
        f"{'ROLE':13} {'PROVIDER':10} {'MODEL':22} {'FRESH IN':>10} "
        f"{'CACHE RD':>10} {'CACHE WR':>10} {'OUTPUT':>9} {'TOTAL':>11} {'RUNS':>5}"
    )
    print(header)
    print("-" * len(header))
    grand = new_bucket()
    for (role, provider, model, _endpoint), bucket in sorted(totals.items()):
        for name in (*COLUMNS, "events"):
            grand[name] += bucket[name]
        print(
            f"{role[:13]:13} {provider[:10]:10} {model[:22]:22} "
            f"{bucket['fresh_in']:>10,} {bucket['cache_read']:>10,} "
            f"{bucket['cache_write']:>10,} {bucket['output']:>9,} "
            f"{bucket['total']:>11,} {bucket['events']:>5,}"
        )
    print("-" * len(header))
    print(
        f"{'all':13} {'':10} {'':22} {grand['fresh_in']:>10,} "
        f"{grand['cache_read']:>10,} {grand['cache_write']:>10,} "
        f"{grand['output']:>9,} {grand['total']:>11,} {grand['events']:>5,}"
    )
    if have_reported:
        print(f"\nProvider-reported cost: {reported_cost:.4f} USD")
    if computed is not None:
        print(
            f"Cost: {computed:.4f} USD, from "
            + " and ".join(sorted(priced_by or {"no priced runs"}))
        )
    if unknown:
        # Only for runs that actually started a provider. An
        # unattributed run may have spent nothing at all, and calling
        # that a floor would invent a cost the ledger says is zero.
        print(
            "\nThe totals above are a floor: a run that started and whose "
            "usage was not recovered spent an unknown amount, which is never "
            "counted as zero."
        )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Report Claude Code and Codex token usage from local logs."
        )
    )
    parser.add_argument(
        "--since",
        default="30",
        help="day count or ISO date to start from (default: 30)",
    )
    parser.add_argument(
        "--task",
        help="report one Orrery task's delegated runs instead of the global scan",
    )
    parser.add_argument(
        "--money",
        action="store_true",
        help="also report cost, refusing when the price table cannot answer",
    )
    parser.add_argument("--json", action="store_true", dest="as_json")
    args = parser.parse_args()

    if args.task:
        from orrery_ledger import LedgerError, repository_root

        try:
            root = repository_root()
        except LedgerError as exc:
            print(f"orrery-usage: {exc}", file=sys.stderr)
            return 2
        return task_report(root, args.task, args.money, args.as_json)
    if args.money:
        print(
            "orrery-usage: --money reports a task's cost and needs --task",
            file=sys.stderr,
        )
        return 2

    since = parse_since(args.since)
    totals: dict[tuple[str, str], dict[str, int]] = {}

    claude_files = read_claude(
        Path.home() / ".claude" / "projects", since, totals
    )
    codex_files = read_codex(codex_home() / "sessions", since, totals)

    if args.as_json:
        print(
            json.dumps(
                {
                    "since": since.isoformat(),
                    "files": {"claude": claude_files, "codex": codex_files},
                    "usage": [
                        {"provider": provider, "model": model, **bucket}
                        for (provider, model), bucket in sorted(totals.items())
                    ],
                },
                indent=2,
            )
        )
        return 0

    print(f"Token usage since {since:%Y-%m-%d %H:%M} UTC")
    print(
        f"Sources: {claude_files} Claude transcript(s), "
        f"{codex_files} Codex session(s)\n"
    )
    header = (
        f"{'PROVIDER':10} {'MODEL':26} {'FRESH IN':>12} {'CACHE RD':>12} "
        f"{'CACHE WR':>12} {'OUTPUT':>10} {'TOTAL':>14} {'EVENTS':>7}"
    )
    print(header)
    print("-" * len(header))

    grand = new_bucket()
    for (provider, model), bucket in sorted(totals.items()):
        for name in (*COLUMNS, "events"):
            grand[name] += bucket[name]
        print(
            f"{provider:10} {model[:26]:26} {bucket['fresh_in']:>12,} "
            f"{bucket['cache_read']:>12,} {bucket['cache_write']:>12,} "
            f"{bucket['output']:>10,} {bucket['total']:>14,} "
            f"{bucket['events']:>7,}"
        )

    print("-" * len(header))
    print(
        f"{'all':10} {'':26} {grand['fresh_in']:>12,} "
        f"{grand['cache_read']:>12,} {grand['cache_write']:>12,} "
        f"{grand['output']:>10,} {grand['total']:>14,} {grand['events']:>7,}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
