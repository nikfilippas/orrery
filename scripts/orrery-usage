#!/usr/bin/env python3
"""Aggregate Claude Code and Codex CLI token usage from local logs.

Claude Code writes one JSONL transcript per session under
~/.claude/projects, or $CLAUDE_CONFIG_DIR/projects, with per-message
usage, and one more per subagent beneath the session's own directory.
The Codex CLI writes one rollout file per session under
$CODEX_HOME/sessions, with a cumulative token count per session. Both
are read here, never modified. The numbers are what the providers
reported at the time and are an accounting of usage, not of billing.

Delegated runs are ephemeral by design, so they write no session file
and appear in neither; each writes a `spend` record to the incident log
instead, which is reported as a separate delegated figure keyed exactly
as the allowance ceiling keys it, so the two add up to what the ceiling
measures. `--task` reports one task's runs from the attempt records the
wrapper writes beside each run. Those runs write a `spend` record too,
so a task's figures are part of the global delegated figure and must
never be added to it, which the report says out loud rather than
leaving to be inferred.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))
import orrery_spend  # noqa: E402
from orrery_model_names import spend_name  # noqa: E402


COLUMNS = ("fresh_in", "cache_read", "cache_write", "output", "total")


def codex_home() -> Path:
    raw = os.environ.get("CODEX_HOME")

    if raw is None:
        raw = str(Path.home() / ".codex")

    if not raw.strip():
        print("orrery-usage: CODEX_HOME cannot be empty", file=sys.stderr)
        raise SystemExit(2)

    return Path(raw).expanduser().resolve(strict=False)


def parse_since(value: str) -> datetime:
    try:
        return datetime.now(timezone.utc) - timedelta(days=int(value))
    except ValueError:
        pass
    try:
        parsed = datetime.fromisoformat(value)
    except ValueError as exc:
        raise SystemExit(
            f"orrery-usage: --since must be a day count or a date: {value}"
        ) from exc
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed


def parse_timestamp(value: Any) -> datetime | None:
    if not isinstance(value, str):
        return None
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed


def new_bucket() -> dict[str, int]:
    bucket = {name: 0 for name in COLUMNS}
    bucket["events"] = 0
    return bucket


def integer(value: Any) -> int:
    return value if isinstance(value, int) and value >= 0 else 0


def read_claude(
    root: Path,
    since: datetime,
    totals: dict[tuple[str, str], dict[str, int]],
) -> int:
    """Aggregate assistant-message usage; one event per API response.

    A response can be recorded more than once, for example when a session
    is resumed into a new transcript, so responses are deduplicated by
    message and request identity across every file. Each is keyed by the
    allowance ceiling's own resolver, so one model recorded as
    `claude-haiku-4-5-20251001` and as `claude-haiku-4-5` is one row, and
    every row is one of the ceiling's keys.
    """
    from orrery_allowance import model_resolver, split_key

    seen: set[tuple[str, str]] = set()
    # Memoised: a month of transcripts holds tens of thousands of
    # responses and only a handful of model ids.
    resolve = model_resolver()
    files = 0

    # At any depth, as the allowance rollup reads them: subagent and
    # workflow-agent transcripts nest beneath their session, and none of
    # their responses is recorded in the parent transcript.
    for path in sorted(root.rglob("*.jsonl")):
        try:
            handle = path.open(encoding="utf-8", errors="replace")
        except OSError:
            continue
        files += 1
        with handle:
            for line in handle:
                try:
                    data = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(data, dict) or data.get("type") != "assistant":
                    continue
                message = data.get("message")
                if not isinstance(message, dict):
                    continue
                usage = message.get("usage")
                if not isinstance(usage, dict):
                    continue

                timestamp = parse_timestamp(data.get("timestamp"))
                if timestamp is None or timestamp < since:
                    continue

                fresh = integer(usage.get("input_tokens"))
                cache_read = integer(usage.get("cache_read_input_tokens"))
                cache_write = integer(usage.get("cache_creation_input_tokens"))
                output = integer(usage.get("output_tokens"))
                if not (fresh or cache_read or cache_write or output):
                    # Synthetic bookkeeping messages carry no tokens. They
                    # are skipped before deduplication so a zero-usage twin
                    # can never swallow the counted row's identity.
                    continue

                message_id = message.get("id")
                if isinstance(message_id, str) and message_id:
                    key = (message_id, str(data.get("requestId", "")))
                    if key in seen:
                        continue
                    seen.add(key)

                model = message.get("model")
                if not isinstance(model, str) or not model:
                    model = "unknown"
                bucket = totals.setdefault(
                    ("claude", split_key(resolve(model))[1]), new_bucket()
                )
                bucket["fresh_in"] += fresh
                bucket["cache_read"] += cache_read
                bucket["cache_write"] += cache_write
                bucket["output"] += output
                bucket["total"] += fresh + cache_read + cache_write + output
                bucket["events"] += 1

    return files


def read_codex(
    root: Path,
    since: datetime,
    totals: dict[tuple[str, str], dict[str, int]],
) -> int:
    """Aggregate per-session cumulative usage from rollout files.

    Codex records a running total, so only the last complete count in each
    file matters; summing the intermediate ones would multiply the truth.
    """
    files = 0

    for path in sorted(root.rglob("rollout-*.jsonl")):
        try:
            handle = path.open(encoding="utf-8", errors="replace")
        except OSError:
            continue

        provider = "codex"
        model = "unknown"
        last_usage: dict[str, Any] | None = None
        last_timestamp: datetime | None = None
        # The model current when the count was recorded, not whatever a
        # later turn switched to before the file ended.
        model_at_last_usage = "unknown"

        with handle:
            for line in handle:
                try:
                    data = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(data, dict):
                    continue
                payload = data.get("payload")
                if not isinstance(payload, dict):
                    continue
                kind = payload.get("type") or data.get("type")

                if kind == "session_meta":
                    recorded = payload.get("model_provider")
                    if isinstance(recorded, str) and recorded:
                        provider = recorded
                elif kind == "turn_context":
                    recorded = payload.get("model")
                    if isinstance(recorded, str) and recorded:
                        model = recorded
                elif kind == "token_count":
                    info = payload.get("info")
                    if isinstance(info, dict):
                        usage = info.get("total_token_usage")
                        if isinstance(usage, dict) and usage:
                            last_usage = usage
                            model_at_last_usage = model
                            stamp = parse_timestamp(data.get("timestamp"))
                            if stamp is not None:
                                last_timestamp = stamp

        if last_usage is None:
            continue
        if last_timestamp is None or last_timestamp < since:
            continue

        files += 1
        bucket = totals.setdefault((provider, model_at_last_usage), new_bucket())
        cache_read = integer(last_usage.get("cached_input_tokens"))
        fresh = max(0, integer(last_usage.get("input_tokens")) - cache_read)
        cache_write = integer(last_usage.get("cache_write_input_tokens"))
        output = integer(last_usage.get("output_tokens"))
        total = integer(last_usage.get("total_tokens"))
        bucket["fresh_in"] += fresh
        bucket["cache_read"] += cache_read
        bucket["cache_write"] += cache_write
        bucket["output"] += output
        bucket["total"] += total or (fresh + cache_read + cache_write + output)
        bucket["events"] += 1

    return files


def read_delegated(
    since: datetime,
    totals: dict[tuple[str, str], dict[str, int]],
) -> tuple[int, int, int]:
    """Aggregate delegated runs' `spend` records under the ceiling's keys.

    Records carry the manifest's short model names where transcripts
    carry API identifiers, so both go through the allowance's resolver
    and its key for a record, and an endpoint-routed run lands under an
    empty provider exactly as the ceiling files it. A run is unknown only
    where its record says so; one whose provider reported zero usage is
    counted and adds no row. Returns the runs counted, the runs unknown,
    and how many counted runs are a partial floor.
    """
    from orrery_allowance import SPEND_FIELDS, model_resolver, spend_key, split_key
    from orrery_incidents import read_events

    resolve = model_resolver()
    counted = unknown = partial = 0
    for event in read_events(since=since):
        if event.get("kind") != "spend":
            continue
        if event.get("unknown") is True:
            unknown += 1
            continue
        counted += 1
        if event.get("partial") is True:
            partial += 1
        counts = {name: integer(event.get(name)) for name in SPEND_FIELDS}
        if not any(counts.values()):
            # A run the provider reported as free: it adds nothing, and
            # the ceiling files no row for it either.
            continue
        bucket = totals.setdefault(
            split_key(spend_key(event, resolve)), new_bucket()
        )
        for name, value in counts.items():
            bucket[name] += value
            bucket["total"] += value
        bucket["events"] += 1
    return counted, unknown, partial


def task_attempts(store: Path, task_id: str) -> tuple[list[dict], int]:
    """Every attempt record for one task, and the runs that left none.

    Dispatches and reviews keep their artefacts in different places, so
    both trees are walked. A dispatch or review directory with no
    attempt record at all is counted rather than ignored: it predates
    this accounting or its artefacts were reclaimed, and either way its
    cost is not zero, it is absent.
    """
    records: list[dict] = []
    unattributed = 0
    roots = [
        directory
        for parent in (store / "dispatch" / task_id, store / "reviews" / task_id)
        if parent.is_dir()
        for directory in sorted(parent.iterdir())
        if directory.is_dir() and not directory.is_symlink()
    ]
    for directory in roots:
        # A dispatch nests its receipts one level deeper; a review does
        # not, and its retry lives in a sibling directory of its own.
        candidates = [directory] + [
            child
            for child in sorted(directory.iterdir())
            if child.is_dir() and child.name.startswith("attempt-")
        ]
        found = 0
        for candidate in candidates:
            for record in orrery_spend.read_attempts(candidate):
                records.append(record)
                found += 1
        if not found:
            unattributed += 1
    return records, unattributed


def price_records(records: list[dict]) -> tuple[float | None, str | None]:
    """Cost for a task's attempts, or why it cannot be given.

    The provider's own billed figure is preferred wherever it exists,
    because it is the truth and needs no maintenance: Claude reports one
    per run. The operator's table is consulted only for the attempts
    that have none, so a Claude-only task can be priced with no table at
    all, and a table that cannot price those attempts refuses rather
    than guessing.
    """
    total = 0.0
    table: dict | None = None
    for record in records:
        usage = record.get("usage")
        if not isinstance(usage, dict):
            # Unknown spend is reported as its own row; it must not be
            # folded into a money figure as though it were nothing.
            continue
        reported = record.get("provider_cost_usd")
        if isinstance(reported, (int, float)) and not isinstance(reported, bool):
            total += float(reported)
            continue
        if table is None:
            from orrery_runtime import RuntimeConfigError, effective_manifest

            try:
                table = orrery_spend.price_table(effective_manifest())
            except (RuntimeConfigError, orrery_spend.SpendError) as exc:
                return None, str(exc)
            refusal = orrery_spend.price_refusal(table)
            if refusal:
                return None, refusal
        # Tokens the provider says came from another model cannot be
        # charged at this attempt's rate. The provider's own figure
        # already accounts for them, so this only bites the table path.
        named = record.get("reported_models")
        if named and set(named) != {record.get("model")}:
            return None, (
                f"a run on {record.get('model')} reports usage from "
                f"{sorted(named)}, which this attempt's rate cannot price"
            )
        assert table is not None
        rates = orrery_spend.rate_for(
            table, record.get("provider"), record.get("model"),
            record.get("endpoint"),
        )
        if rates is None:
            key = orrery_spend.price_key(
                record.get("provider"), record.get("model"), record.get("endpoint")
            )
            return None, (
                f"the provider reported no cost for this run and the price "
                f"table has no rate for {key}"
            )
        total += orrery_spend.money_of(usage, rates)
    return total, None


def ran_as(record: dict, resolve: Any = None) -> str:
    """The model an attempt ran as: the one it reported, else its configured one.

    Grouped by this rather than by the configured name, so two `opus`
    runs a CLI update split between Opus 5 and Opus 5.5 are two rows.
    Spelled as the run's spend is keyed, through the ceiling's resolver,
    built here where the caller passes none, so attempts naming one model
    differently, `claude-haiku-4-5-20251001` and `claude-haiku-4-5`,
    share a row; an endpoint's model keeps its own spelling, as the
    delegated figure keeps it.
    """
    from orrery_allowance import (
        model_resolver,
        single_reported_model,
        spend_key,
        split_key,
    )

    named = record.get("reported_models")
    single = (
        single_reported_model({
            "provider": record.get("provider"),
            "model": record.get("model"),
            "reported_models": ",".join(str(name) for name in named),
        })
        if isinstance(named, list)
        else None
    )
    ran = single or str(record.get("model", "unknown"))
    if record.get("endpoint"):
        return ran
    if resolve is None:
        resolve = model_resolver()
    return split_key(
        spend_key({"provider": record.get("provider"), "model": ran}, resolve)
    )[1]


def task_report(root: Path, task_id: str, money: bool, as_json: bool) -> int:
    from orrery_allowance import model_resolver

    store = root / ".orrery"
    if not (store / "ledger" / f"{task_id}.jsonl").exists():
        print(f"orrery-usage: no such task: {task_id}", file=sys.stderr)
        return 2
    records, unattributed = task_attempts(store, task_id)
    resolve = model_resolver()

    totals: dict[tuple[str, str, str, str, str], dict[str, int]] = {}
    unknown = 0
    reported_cost = 0.0
    have_reported = False
    for record in records:
        usage = record.get("usage")
        key = (
            str(record.get("role", "unknown")),
            str(record.get("provider", "unknown")),
            str(record.get("model", "unknown")),
            str(record.get("endpoint") or ""),
            ran_as(record, resolve),
        )
        bucket = totals.setdefault(key, new_bucket())
        bucket["events"] += 1
        if not isinstance(usage, dict):
            unknown += 1
            continue
        for name in orrery_spend.TOKEN_CLASSES:
            bucket[name] += integer(usage.get(name))
            bucket["total"] += integer(usage.get(name))
        cost = record.get("provider_cost_usd")
        if isinstance(cost, (int, float)):
            reported_cost += float(cost)
            have_reported = True

    computed: float | None = None
    priced_by: set[str] = set()
    if money:
        computed, refusal = price_records(records)
        if refusal is not None:
            print(f"orrery-usage: cannot report money: {refusal}", file=sys.stderr)
            return 2
        priced_by = {
            "the provider's own figure"
            if isinstance(record.get("provider_cost_usd"), (int, float))
            else "the price table"
            for record in records
            if isinstance(record.get("usage"), dict)
        }

    if as_json:
        print(
            json.dumps(
                {
                    "task_id": task_id,
                    "attempts": len(records),
                    "unknown_attempts": unknown,
                    "unattributed_runs": unattributed,
                    "population": (
                        "this task's delegated runs; already part of the "
                        "global delegated figure"
                    ),
                    "usage": [
                        {
                            "role": role,
                            "provider": provider,
                            "model": model,
                            "endpoint": endpoint or None,
                            "ran_as": ran,
                            "name": (
                                ran if endpoint else spend_name(provider, ran)
                            ),
                            **bucket,
                        }
                        for (role, provider, model, endpoint, ran), bucket
                        in sorted(totals.items())
                    ],
                    "provider_cost_usd": reported_cost if have_reported else None,
                    "computed_cost_usd": computed,
                    "priced_by": sorted(priced_by),
                },
                indent=2,
            )
        )
        return 0

    print(f"Token usage attributed to {task_id}")
    print(
        "Every delegated run also records its spend in the incident log, so "
        "these figures are part of the global delegated figure and cannot be "
        "added to it."
    )
    print()
    print(f"{'ATTRIBUTION':14} {'RUNS':>5}  MEANING")
    print(f"{'attributed':14} {len(records) - unknown:>5}  usage parsed and counted below")
    print(
        f"{'unknown':14} {unknown:>5}  a provider run started and its usage "
        "was not recovered"
    )
    print(
        f"{'unattributed':14} {unattributed:>5}  a run left no attempt record; "
        "it predates this accounting or never started a provider"
    )
    print()
    # An endpoint serves its own models, which no first-party name fits.
    # The column is as wide as its longest name, so none is cut short.
    names = {
        (role, provider, model, endpoint, ran): (
            ran if endpoint else spend_name(provider, ran)
        )
        for role, provider, model, endpoint, ran in totals
    }
    width = max([len("RAN AS"), *map(len, names.values())])
    header = (
        f"{'ROLE':13} {'PROVIDER':10} {'MODEL':22} {'RAN AS':{width}} "
        f"{'FRESH IN':>10} {'CACHE RD':>10} {'CACHE WR':>10} {'OUTPUT':>9} "
        f"{'TOTAL':>11} {'RUNS':>5}"
    )
    print(header)
    print("-" * len(header))
    grand = new_bucket()
    for key, bucket in sorted(totals.items()):
        role, provider, model, _endpoint, _ran = key
        for name in (*COLUMNS, "events"):
            grand[name] += bucket[name]
        print(
            f"{role[:13]:13} {provider[:10]:10} {model[:22]:22} "
            f"{names[key]:{width}} "
            f"{bucket['fresh_in']:>10,} {bucket['cache_read']:>10,} "
            f"{bucket['cache_write']:>10,} {bucket['output']:>9,} "
            f"{bucket['total']:>11,} {bucket['events']:>5,}"
        )
    print("-" * len(header))
    print(
        f"{'all':13} {'':10} {'':22} {'':{width}} {grand['fresh_in']:>10,} "
        f"{grand['cache_read']:>10,} {grand['cache_write']:>10,} "
        f"{grand['output']:>9,} {grand['total']:>11,} {grand['events']:>5,}"
    )
    if have_reported:
        print(f"\nProvider-reported cost: {reported_cost:.4f} USD")
    if computed is not None:
        print(
            f"Cost: {computed:.4f} USD, from "
            + " and ".join(sorted(priced_by or {"no priced runs"}))
        )
    if unknown:
        # Only for runs that actually started a provider. An
        # unattributed run may have spent nothing at all, and calling
        # that a floor would invent a cost the ledger says is zero.
        print(
            "\nThe totals above are a floor: a run that started and whose "
            "usage was not recovered spent an unknown amount, which is never "
            "counted as zero."
        )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Report Claude Code and Codex token usage from local logs."
        )
    )
    parser.add_argument(
        "--since",
        default="30",
        help="day count or ISO date to start from (default: 30)",
    )
    parser.add_argument(
        "--task",
        help="report one Orrery task's delegated runs instead of the global scan",
    )
    parser.add_argument(
        "--money",
        action="store_true",
        help="also report cost, refusing when the price table cannot answer",
    )
    parser.add_argument("--json", action="store_true", dest="as_json")
    args = parser.parse_args()

    if args.task:
        from orrery_ledger import LedgerError, repository_root

        try:
            root = repository_root()
        except LedgerError as exc:
            print(f"orrery-usage: {exc}", file=sys.stderr)
            return 2
        return task_report(root, args.task, args.money, args.as_json)
    if args.money:
        print(
            "orrery-usage: --money reports a task's cost and needs --task",
            file=sys.stderr,
        )
        return 2

    since = parse_since(args.since)
    totals: dict[tuple[str, str], dict[str, int]] = {}

    claude_config = os.environ.get("CLAUDE_CONFIG_DIR")
    claude_files = read_claude(
        (Path(claude_config) if claude_config else Path.home() / ".claude")
        / "projects",
        since,
        totals,
    )
    codex_files = read_codex(codex_home() / "sessions", since, totals)
    delegated: dict[tuple[str, str], dict[str, int]] = {}
    delegated_runs, unknown_runs, partial_runs = read_delegated(since, delegated)

    if args.as_json:
        print(
            json.dumps(
                {
                    "since": since.isoformat(),
                    "files": {"claude": claude_files, "codex": codex_files},
                    "usage": [
                        {
                            "provider": provider,
                            "model": model,
                            "name": spend_name(provider, model),
                            **bucket,
                        }
                        for (provider, model), bucket in sorted(totals.items())
                    ],
                    "delegated": {
                        "runs": delegated_runs,
                        "unknown_runs": unknown_runs,
                        "partial_runs": partial_runs,
                        "usage": [
                            {
                                "provider": provider or None,
                                "model": model,
                                "name": spend_name(provider, model),
                                **bucket,
                            }
                            for (provider, model), bucket in sorted(
                                delegated.items()
                            )
                        ],
                    },
                },
                indent=2,
            )
        )
        return 0

    print(f"Token usage since {since:%Y-%m-%d %H:%M} UTC")
    print(
        f"Sources: {claude_files} Claude transcript(s), "
        f"{codex_files} Codex session(s), "
        f"{delegated_runs + unknown_runs} delegated run(s)\n"
    )
    print_table(totals)

    print(
        "\nDelegated runs, from the spend record each writes on the way out."
        "\nThey keep no session file, so they are not in the table above; the"
        "\nallowance ceiling counts both. Runs routed at an endpoint are listed"
        "\nas `endpoint` and count towards no provider's ceiling.\n"
    )
    print_table({
        (provider or "endpoint", model): bucket
        for (provider, model), bucket in delegated.items()
    })
    if unknown_runs:
        print(
            f"\n{unknown_runs} delegated run(s) started and their usage was not "
            "recovered, so this figure is a floor."
        )
    if partial_runs:
        print(
            f"{partial_runs} delegated run(s) ended without a result and were "
            "counted from their messages, which understates their output."
        )
    return 0


def print_table(totals: dict[tuple[str, str], dict[str, int]]) -> None:
    # The version beside every id, so Opus 5 and Opus 5.5 read as two
    # models rather than two ids a reader has to know apart. The column
    # is as wide as its longest name, so none is cut short.
    names = {key: spend_name(*key) for key in totals}
    width = max([len("NAME"), *map(len, names.values())])
    header = (
        f"{'PROVIDER':10} {'MODEL':26} {'NAME':{width}} {'FRESH IN':>12} "
        f"{'CACHE RD':>12} {'CACHE WR':>12} {'OUTPUT':>10} {'TOTAL':>14} "
        f"{'EVENTS':>7}"
    )
    print(header)
    print("-" * len(header))

    grand = new_bucket()
    for (provider, model), bucket in sorted(totals.items()):
        for name in (*COLUMNS, "events"):
            grand[name] += bucket[name]
        print(
            f"{provider:10} {model[:26]:26} "
            f"{names[(provider, model)]:{width}} {bucket['fresh_in']:>12,} "
            f"{bucket['cache_read']:>12,} {bucket['cache_write']:>12,} "
            f"{bucket['output']:>10,} {bucket['total']:>14,} "
            f"{bucket['events']:>7,}"
        )

    print("-" * len(header))
    print(
        f"{'all':10} {'':26} {'':{width}} {grand['fresh_in']:>12,} "
        f"{grand['cache_read']:>12,} {grand['cache_write']:>12,} "
        f"{grand['output']:>10,} {grand['total']:>14,} {grand['events']:>7,}"
    )


if __name__ == "__main__":
    raise SystemExit(main())
