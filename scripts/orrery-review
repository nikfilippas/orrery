TERMINAL_STATES = frozenset({"inactive", "failed"})
PROGRAM_NAME = Path(sys.argv[0]).name

# How long a transient unit is allowed to reach a terminal state after a stop
# and again after an escalation to SIGKILL.
STOP_SETTLE_SECONDS = 10.0

# Progress-aware budgets: at its base deadline a run whose merged log
# grew within the stall window keeps going, one step at a time, up to
# its hard cap; codex exec streams tool output and messages
# continuously, so log growth is a live progress signal. Delegated
# Claude runs print only their final JSON, never grow mid-run, and so
# keep plain base-deadline behaviour. Deliberately constants, not
# configuration.
# Widened from 180s on live evidence: a reviewer at ultra effort was
# recorded timing out with stalled_seconds 287 while demonstrably
# working, because a reasoning model can think for minutes between
# tool calls and emits nothing meanwhile. The window must exceed a
# plausible silent reasoning turn, or productive runs are cut off at
# their deadline.
STALL_WINDOW_SECONDS = 360.0
EXTEND_STEP_SECONDS = 120.0
# The delegate's own output is mirrored to stderr as it arrives. A
# review can emit hundreds of kilobytes, so the default caps how many
# lines each poll may print and says how many it dropped; `--stream`
# lifts the cap and `--no-stream` leaves only the byte counters.
STREAM_LINES_PER_POLL = 4
STREAM_LINE_LIMIT = 200
# Explicitly supplied hard caps (flag, environment, manifest) must sit
# in this range; a cap derived from the base inherits the base's
# freedom.
HARD_TIMEOUT_MINIMUM = 30
HARD_TIMEOUT_MAXIMUM = 14400


class UsageError(Exception):
    pass


class PlainUsageError(UsageError):
    pass


class CleanupError(Exception):
    pass


def receipt_path_is_safe(path: Path) -> bool:
    """Reject a receipts path when any existing component is a symlink."""
    current = Path(path.anchor) if path.is_absolute() else Path(".")
    parts = path.parts[1:] if path.is_absolute() else path.parts
    for part in parts:
        current /= part
        try:
            if current.is_symlink():
                return False
        except OSError:
            return False
    return True


def receipt_open(path: Path, flags: int) -> int:
    return os.open(path, flags | os.O_NOFOLLOW, 0o600)


class Invocation:
    def __init__(
        self,
        *,
        timeout_seconds: int,
        output_path: Path | None,
        prompt: str,
        role_id: str,
        approval: tuple[str, str] | None,
        no_fallback: bool,
        approval_scope: tuple[str, float | None] | None = None,
        revoke: bool = False,
        timeout_is_default: bool = False,
        hard_timeout_seconds: int | None = None,
        log_path: Path | None = None,
        stream_mode: str = "lines",
        workspace: Path | None = None,
        receipts: Path | None = None,
        schema_path: Path | None = None,
    ) -> None:
        self.schema_path = schema_path
        self.log_path = log_path
        self.stream_mode = stream_mode
        self.timeout_seconds = timeout_seconds
        self.output_path = output_path
        self.prompt = prompt
        self.role_id = role_id
        self.approval = approval
        self.no_fallback = no_fallback
        self.approval_scope = approval_scope
        self.revoke = revoke
        self.timeout_is_default = timeout_is_default
        self.hard_timeout_seconds = hard_timeout_seconds
        self.workspace = workspace
        self.receipts = receipts


class DelegationState:
    def __init__(self, *, configured: Role, role: Role) -> None:
        self.configured = configured
        self.role = role
        self.excluded_providers: set[str] = set()
        self.excluded_models: set[tuple[str, str]] = set()
        self.transient_retries: set[tuple[str, str]] = set()
        self.is_fallback = False


class NextAttempt(Exception):
    def __init__(
        self,
        invocation: Invocation,
        state: DelegationState,
    ) -> None:
        super().__init__(state.role)
        self.invocation = invocation
        self.state = state


class ReviewInterrupted(Exception):
    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


def interrupting_signals() -> set[int]:
    """Every catchable asynchronous signal whose default action terminates.

    Any of these would otherwise kill the wrapper without running the
    cleanup in `finally`, leaving the transient unit and the Codex control
    group behind. The set is derived from the platform rather than listed
    by hand so that signals such as SIGIO, SIGSTKFLT and the real-time
    signals are covered too.
    """
    excluded_names = (
        # Cannot be caught.
        "SIGKILL",
        "SIGSTOP",
        # Default action is ignore, stop, or continue, so the wrapper
        # survives and its own cleanup still runs.
        "SIGCHLD",
        "SIGCLD",
        "SIGCONT",
        "SIGTSTP",
        "SIGTTIN",
        "SIGTTOU",
        "SIGURG",
        "SIGWINCH",
        # Synchronous faults. Raising a Python exception from these
        # handlers is not safe, and they indicate a broken process rather
        # than a request to stop.
        "SIGABRT",
        "SIGBUS",
        "SIGFPE",
        "SIGILL",
        "SIGIOT",
        "SIGSEGV",
        "SIGSYS",
        "SIGTRAP",
    )

    excluded = {
        int(member)
        for member in (getattr(signal, name, None) for name in excluded_names)
        if isinstance(member, signal.Signals)
    }

    return {
        int(number)
        for number in signal.valid_signals()
        if int(number) not in excluded
    }


ROLE_LABELS = {
    "mechanic": ("Mechanical worker", "bounded mechanical work"),
    "implementer": ("Implementation worker", "bounded implementation"),
    "reviewer": ("Reviewer", "independent review"),
    "plan-reviewer": ("Plan reviewer", "plan review"),
}


def role_label(role: str) -> tuple[str, str]:
    return ROLE_LABELS.get(
        role,
        (role.replace("-", " ").capitalize(), "bounded agent work"),
    )


def usage() -> str:
    return (
        "Usage:\n"
        f"  {PROGRAM_NAME} [--timeout SECONDS] [--hard-timeout SECONDS]\n"
        "                 [--output PATH] [--log PATH] [--workspace DIR]\n"
        "                 [--receipts DIR] [--schema FILE]\n"
        "                 [--stream | --no-stream]\n"
        "                 [--approve-fallback PROVIDER:MODEL]\n"
        "                 [--approval-scope run|session|until:ISO8601]\n"
        "                 [--no-fallback] [--role NAME] -- PROMPT...\n"
        f"  {PROGRAM_NAME} --revoke-fallbacks\n"
        f"  printf '%s\\n' \"PROMPT\" | {PROGRAM_NAME} "
        "[--role NAME] [--timeout SECONDS] [--output PATH] [--workspace DIR]\n"
        "[--receipts DIR]\n\n"
        "Runs one configured Orrery role in a separate provider process. "
        "Reviewer roles are read-only and fresh; worker roles are "
        "workspace-write. The compatibility command orrery-review defaults "
        "to reviewer. orrery-agent requires --role. A transient systemd "
        "service contains the complete process tree where available. A failed "
        "provider gets one automatically ranked fallback proposal; "
        "substitution requires explicit user approval.\n"
    )


def parse_args(argv: list[str]) -> Invocation:
    try:
        timeout_seconds = int(
            os.environ.get(
                "ORRERY_AGENT_TIMEOUT_SECONDS",
                os.environ.get("CODEX_REVIEW_TIMEOUT_SECONDS", "600"),
            )
        )
    except ValueError as exc:
        raise UsageError(
            "ORRERY_AGENT_TIMEOUT_SECONDS must be a positive integer"
        ) from exc
    timeout_is_default = (
        "ORRERY_AGENT_TIMEOUT_SECONDS" not in os.environ
        and "CODEX_REVIEW_TIMEOUT_SECONDS" not in os.environ
    )
    hard_raw = os.environ.get("ORRERY_AGENT_HARD_TIMEOUT_SECONDS")
    try:
        hard_timeout_seconds = (
            int(hard_raw) if hard_raw is not None else None
        )
    except ValueError as exc:
        raise UsageError(
            "ORRERY_AGENT_HARD_TIMEOUT_SECONDS must be an integer"
        ) from exc

    output_path: Path | None = None
    log_destination: Path | None = None
    stream_mode = "lines"
    prompt_parts: list[str] | None = None
    role: str | None = "reviewer" if PROGRAM_NAME == "orrery-review" else None
    approval: tuple[str, str] | None = None
    no_fallback = False
    approval_scope_raw: str | None = None
    revoke = False
    workspace: Path | None = None
    receipts: Path | None = None
    schema_path: Path | None = None

    index = 0
    while index < len(argv):
        argument = argv[index]

        if argument in ("--help", "-h"):
            print(usage(), end="")
            raise SystemExit(0)

        if argument == "--":
            prompt_parts = argv[index + 1 :]
            break

        if argument == "--timeout":
            if index + 1 >= len(argv):
                raise UsageError("missing value for --timeout")
            index += 1
            try:
                timeout_seconds = int(argv[index])
            except ValueError as exc:
                raise UsageError(
                    "--timeout must be a positive integer"
                ) from exc
            timeout_is_default = False
        elif argument.startswith("--timeout="):
            try:
                timeout_seconds = int(argument.split("=", 1)[1])
            except ValueError as exc:
                raise UsageError(
                    "--timeout must be a positive integer"
                ) from exc
            timeout_is_default = False
        elif argument == "--hard-timeout":
            if index + 1 >= len(argv):
                raise UsageError("missing value for --hard-timeout")
            index += 1
            try:
                hard_timeout_seconds = int(argv[index])
            except ValueError as exc:
                raise UsageError(
                    "--hard-timeout must be a positive integer"
                ) from exc
        elif argument.startswith("--hard-timeout="):
            try:
                hard_timeout_seconds = int(argument.split("=", 1)[1])
            except ValueError as exc:
                raise UsageError(
                    "--hard-timeout must be a positive integer"
                ) from exc
        elif argument == "--log":
            if index + 1 >= len(argv):
                raise UsageError("missing value for --log")
            index += 1
            if not argv[index]:
                raise UsageError("--log requires a non-empty path")
            log_destination = Path(argv[index])
        elif argument.startswith("--log="):
            value = argument.split("=", 1)[1]
            if not value:
                raise UsageError("--log requires a non-empty path")
            log_destination = Path(value)
        elif argument == "--stream":
            stream_mode = "full"
        elif argument == "--no-stream":
            stream_mode = "off"
        elif argument == "--output":
            if index + 1 >= len(argv):
                raise UsageError("missing value for --output")
            index += 1
            if not argv[index]:
                raise UsageError("--output requires a non-empty path")
            output_path = Path(argv[index])
        elif argument.startswith("--output="):
            value = argument.split("=", 1)[1]
            if not value:
                raise UsageError("--output requires a non-empty path")
            output_path = Path(value)
        elif argument == "--schema":
            index += 1
            if index >= len(argv) or not argv[index]:
                raise UsageError("--schema requires a path to a JSON Schema")
            schema_path = Path(argv[index]).expanduser()
        elif argument.startswith("--schema="):
            value = argument.split("=", 1)[1]
            if not value:
                raise UsageError("--schema requires a path to a JSON Schema")
            schema_path = Path(value).expanduser()
        elif argument in ("--workspace", "--receipts"):
            if index + 1 >= len(argv):
                raise UsageError(f"missing value for {argument}")
            index += 1
            value = argv[index]
            if not value:
                raise PlainUsageError(f"{argument} requires a non-empty path")
            if argument == "--workspace":
                workspace = Path(value)
            else:
                receipts = Path(value)
        elif argument.startswith("--workspace=") or argument.startswith("--receipts="):
            option, value = argument.split("=", 1)
            if not value:
                raise PlainUsageError(f"{option} requires a non-empty path")
            if option == "--workspace":
                workspace = Path(value)
            else:
                receipts = Path(value)
        elif argument == "--approve-fallback":
            if index + 1 >= len(argv):
                raise UsageError("missing value for --approve-fallback")
            index += 1
            try:
                approval = parse_approval(argv[index])
            except RuntimeConfigError as exc:
                raise UsageError(str(exc)) from exc
        elif argument.startswith("--approve-fallback="):
            try:
                approval = parse_approval(argument.split("=", 1)[1])
            except RuntimeConfigError as exc:
                raise UsageError(str(exc)) from exc
        elif argument == "--approval-scope":
            if index + 1 >= len(argv):
                raise UsageError("missing value for --approval-scope")
            index += 1
            approval_scope_raw = argv[index]
        elif argument.startswith("--approval-scope="):
            approval_scope_raw = argument.split("=", 1)[1]
        elif argument == "--revoke-fallbacks":
            revoke = True
        elif argument == "--no-fallback":
            no_fallback = True
        elif argument in ("--role", "-r"):
            if index + 1 >= len(argv):
                raise UsageError(f"missing value for {argument}")
            index += 1
            role = argv[index]
        elif argument.startswith("--role="):
            role = argument.split("=", 1)[1]
        elif argument.startswith("-"):
            raise UsageError(f"unknown wrapper option: {argument}")
        else:
            prompt_parts = argv[index:]
            break

        index += 1

    if timeout_seconds <= 0:
        raise UsageError("--timeout must be a positive integer")
    if hard_timeout_seconds is not None and not (
        HARD_TIMEOUT_MINIMUM <= hard_timeout_seconds <= HARD_TIMEOUT_MAXIMUM
    ):
        raise UsageError(
            "--hard-timeout must be between "
            f"{HARD_TIMEOUT_MINIMUM} and {HARD_TIMEOUT_MAXIMUM} seconds"
        )

    if revoke:
        if (
            approval is not None
            or approval_scope_raw is not None
            or no_fallback
            or output_path is not None
            or workspace is not None
            or receipts is not None
            or prompt_parts
        ):
            raise UsageError(
                "--revoke-fallbacks stands alone and cannot be combined "
                "with other options"
            )
        return Invocation(
            timeout_seconds=timeout_seconds,
            output_path=None,
            prompt="",
            role_id=role or "reviewer",
            approval=None,
            no_fallback=False,
            revoke=True,
            timeout_is_default=timeout_is_default,
        )

    if prompt_parts is not None and prompt_parts:
        prompt = " ".join(prompt_parts)
    elif not sys.stdin.isatty():
        prompt = sys.stdin.read()
    else:
        raise UsageError("an assignment prompt is required")

    if not prompt.strip():
        raise UsageError("the assignment prompt is empty")

    if role is None:
        raise UsageError("--role is required")
    if not role or not re.fullmatch(r"[A-Za-z0-9._-]+", role):
        raise UsageError(f"invalid role name: {role!r}")
    if no_fallback and approval is not None:
        raise UsageError(
            "--no-fallback and --approve-fallback cannot be combined"
        )
    if workspace is not None:
        try:
            workspace = workspace.resolve(strict=True)
        except (OSError, RuntimeError) as exc:
            # A symlink loop raises RuntimeError rather than OSError up to
            # Python 3.12, so catching OSError alone turned a bad argument
            # into a traceback.
            raise PlainUsageError(f"--workspace is not an existing directory: {exc}") from exc
        if not workspace.is_dir() or git_workspace_fingerprint(workspace) is None:
            raise PlainUsageError("--workspace must be an existing git worktree")
    if receipts is not None:
        if not receipt_path_is_safe(receipts):
            raise PlainUsageError("--receipts must not be or contain a symlink")
        try:
            receipts = receipts.resolve(strict=True)
        except (OSError, RuntimeError) as exc:
            raise PlainUsageError(f"--receipts is not an existing writable directory: {exc}") from exc
        if not receipts.is_dir() or not os.access(receipts, os.W_OK):
            raise PlainUsageError("--receipts must be an existing writable directory")
    approval_scope: tuple[str, float | None] | None = None
    if approval_scope_raw is not None:
        if approval is None:
            raise UsageError("--approval-scope requires --approve-fallback")
        try:
            approval_scope = parse_approval_scope(approval_scope_raw)
        except RuntimeConfigError as exc:
            raise UsageError(str(exc)) from exc

    return Invocation(
        timeout_seconds=timeout_seconds,
        output_path=output_path,
        prompt=prompt,
        role_id=role,
        approval=approval,
        no_fallback=no_fallback,
        approval_scope=approval_scope,
        timeout_is_default=timeout_is_default,
        hard_timeout_seconds=hard_timeout_seconds,
        log_path=log_destination,
        stream_mode=stream_mode,
        workspace=workspace,
        receipts=receipts,
        schema_path=schema_path,
    )


# Provider-derived text reaching stderr must never be able to forge
# Orrery's exact protocol markers (a reviewer can legitimately quote
# ORRERY FALLBACK APPROVAL REQUIRED) or smuggle terminal escape
# sequences into the transcript, so every such path renders through
# this filter. Stdout is the verdict's data channel and stays raw.
# Defined in orrery_findings so that anything rendering provider text can
# import it. This file has no .py extension and cannot be imported, which
# would otherwise have left a second copy of the filter to drift.


def next_deadline(
    now: float,
    deadline: float,
    hard_deadline: float,
    growth_age: float | None,
    *,
    stall_window: float = STALL_WINDOW_SECONDS,
    step: float = EXTEND_STEP_SECONDS,
) -> float | None:
    """The extended deadline, or None when the run has timed out.

    Evaluated afresh at every deadline touch with the growth age taken
    from the log file's own modification time at that moment, not from
    when a poll happened to notice growth, so a single early write can
    never masquerade as recent progress. Staying alive requires growth
    within the stall window at every touch: a run that grew and then
    went silent stalls out within one window plus one step. A run
    whose log never grew (growth_age None) keeps its base deadline
    whatever the cap, which also preserves exact current behaviour for
    delegated Claude runs that print only their final JSON.
    """
    if growth_age is None:
        return None
    if growth_age > stall_window:
        return None
    if deadline >= hard_deadline:
        return None
    return min(deadline + step, hard_deadline)


def log_growth_age(path: Path) -> float | None:
    """Seconds since the log last grew, or None while it is empty."""
    try:
        status = path.stat()
    except OSError:
        return None
    if status.st_size <= 0:
        return None
    return max(0.0, time.time() - status.st_mtime)


def effective_budgets(invocation: Invocation, role: Role) -> tuple[int, int]:
    """The effective base and hard budgets for one delegated run.

    The manifest's per-role values apply only when neither the flag nor
    the environment chose a base; an explicitly chosen base without an
    explicit hard cap is its own bound. Fallback and standing
    candidates inherit the configured role's budget fields, so the
    configured role decides these numbers for the whole invocation.
    """
    base = invocation.timeout_seconds
    if invocation.timeout_is_default and role.timeout_seconds is not None:
        base = role.timeout_seconds
    hard = invocation.hard_timeout_seconds
    if hard is None:
        hard = (
            role.hard_timeout_seconds
            if invocation.timeout_is_default
            and role.timeout_seconds is not None
            and role.hard_timeout_seconds is not None
            else base
        )
    return base, hard


def role_availability(role: Role):
    """Endpoint roles bypass first-party login and model visibility checks."""
    if role.endpoint is None:
        return provider_status(role.provider)
    executable = shutil.which("claude" if role.provider == "anthropic" else "codex")
    if executable is None:
        return provider_status(role.provider)
    endpoint_environment(role.endpoint)
    from orrery_fallback import ProviderStatus
    return ProviderStatus(role.provider, Availability.READY, executable, "endpoint adapter ready")


def stream_new_lines(path: Path, offset: int, mode: str) -> int:
    """Mirror complete new lines to stderr; return the new offset.

    Only whole lines are consumed, so a partially written line is left
    for the next poll rather than being split. Every line goes through
    the same sanitiser as the diagnostics tail and is prefixed, so
    provider text is visibly the delegate's and cannot forge Orrery's
    own protocol markers.
    """
    try:
        with path.open("rb") as handle:
            handle.seek(offset)
            chunk = handle.read()
    except OSError:
        return offset
    end = chunk.rfind(b"\n")
    if end == -1:
        return offset
    complete = chunk[: end + 1]
    lines = [
        line
        for line in complete.decode("utf-8", "replace").splitlines()
        if line.strip()
    ]
    if mode != "full" and len(lines) > STREAM_LINES_PER_POLL:
        dropped = len(lines) - STREAM_LINES_PER_POLL
        lines = lines[-STREAM_LINES_PER_POLL:]
        print(
            f"  | ... {dropped} earlier line(s) not shown",
            file=sys.stderr,
            flush=True,
        )
    for line in lines:
        rendered = sanitise_provider_text(line)[:STREAM_LINE_LIMIT]
        if rendered.strip():
            print(f"  | {rendered}", file=sys.stderr, flush=True)
    return offset + len(complete)


def newest_log_line(path: Path) -> str:
    try:
        with path.open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            handle.seek(max(0, size - 4096))
            chunk = handle.read().decode("utf-8", "replace")
    except OSError:
        return ""
    for line in reversed(chunk.splitlines()):
        line = line.strip()
        if line:
            return line
    return ""


def report(message: str) -> None:
    """Write a diagnostic to stderr, tolerating a closed descriptor.

    Every stream this wrapper writes to can be closed by its caller. A
    diagnostic that raised in place of being delivered would replace a
    reportable outcome with a traceback.
    """
    try:
        if sys.stderr is None:
            return
        print(f"{PROGRAM_NAME}: {message}", file=sys.stderr)
    except (OSError, ValueError, AttributeError):
        pass


def tail_text(path: Path, lines: int = 80) -> str:
    if not path.exists():
        return ""
    content = path.read_text(errors="replace").splitlines()
    return sanitise_provider_text("\n".join(content[-lines:]))


def run_systemctl(
    *arguments: str,
    timeout: float = 20.0,
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            ["systemctl", "--user", *arguments],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
            text=True,
        )
    except FileNotFoundError as exc:
        raise RuntimeError("systemctl is unavailable") from exc
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError(
            f"systemctl timed out: {' '.join(arguments)}"
        ) from exc


def systemctl_error(
    action: str,
    result: subprocess.CompletedProcess[str],
) -> RuntimeError:
    detail = result.stderr.strip() or result.stdout.strip()
    if not detail:
        detail = f"exit status {result.returncode}"
    return RuntimeError(f"systemctl {action} failed: {detail}")


def unit_status(unit: str) -> tuple[bool, str]:
    # Named properties are parsed rather than positional `--value` output.
    # systemctl emits `--value` lines in its own canonical property order, not
    # the requested order, and omits nothing for empty values, so positional
    # reading silently misattributes states.
    result = run_systemctl(
        "show",
        unit,
        "--property=LoadState",
        "--property=ActiveState",
        timeout=3.0,
    )

    properties: dict[str, str] = {}
    for line in result.stdout.splitlines():
        key, separator, value = line.partition("=")
        if separator:
            properties[key.strip()] = value.strip()

    load_state = properties.get("LoadState", "")
    active_state = properties.get("ActiveState", "")

    absent_messages = (
        "could not be found",
        "not found",
        "not loaded",
    )
    stderr_lower = result.stderr.lower()

    if load_state == "not-found" or (
        result.returncode != 0
        and any(message in stderr_lower for message in absent_messages)
    ):
        return False, "not-found"

    if result.returncode != 0:
        raise systemctl_error("show", result)

    if not load_state:
        raise RuntimeError(
            f"systemctl show returned no LoadState for {unit}"
        )

    return True, active_state


def containment_properties(
    writable_paths: list[Path],
    read_only_paths: list[Path] | None = None,
) -> list[str]:
    """The filesystem properties every contained unit is composed from.

    A probe that composed anything else would answer a different
    question from the one the run relies on, so the probes and the real
    unit are built from this one list.
    """
    def listed(path: Path) -> str:
        # These properties take a space-separated list, so an unquoted
        # path containing a space is read as two paths and systemd
        # refuses the unit outright ("Invalid ReadWritePaths"). Quoting
        # every entry costs nothing and keeps a workspace or provider
        # home under a directory with a space in its name usable.
        return '"' + str(path).replace("\\", "\\\\").replace('"', '\\"') + '"'

    return [
        # ProtectSystem=strict makes the whole hierarchy read-only while
        # leaving /dev, /proc and /sys alone. A bare ReadOnlyPaths=/ also
        # froze /proc, which broke the provider's own bubblewrap sandbox
        # ("setting up uid map: Read-only file system") in a live run.
        "--property=ProtectSystem=strict",
        "--property=ProtectHome=read-only",
        *[
            f"--property=ReadWritePaths={listed(path)}"
            for path in dict.fromkeys(writable_paths)
        ],
        # The deeper mapping wins, measured on systemd 257 and 259: a
        # read-only mapping beats a grant that contains it and a grant
        # naming the same path, but a grant nested inside it beats the
        # mapping. Callers refuse that nesting rather than compose it.
        *[
            f"--property=ReadOnlyPaths={listed(path)}"
            for path in dict.fromkeys(read_only_paths or [])
        ],
        "--property=NoNewPrivileges=yes",
    ]


def confinement_enforced(
    writable_paths: list[Path],
    probe_root: Path,
    read_only_paths: list[Path] | None = None,
) -> bool:
    """Whether systemd behaviorally enforces the composed write allowlist.

    `read_only_paths` are the paths whose read-only-ness is being
    claimed. Each is composed into the probe exactly as the run will
    compose it, and each is written to, so a claim the host cannot
    honour fails here rather than silently at the delegate.
    """
    inside = probe_root / ".containment-probe-inside"
    # Home rather than the run directory's parent. That parent is
    # $XDG_RUNTIME_DIR/orrery-review, whose unwritability comes from
    # ProtectHome covering /run/user rather than from the allowlist, so
    # pointing XDG_RUNTIME_DIR under /tmp put the negative target inside
    # a deliberate grant and refused every run on a host whose
    # confinement was intact. ProtectHome covers home on every host, and
    # nothing grants it.
    outside = Path.home() / f".containment-probe-outside-{uuid.uuid4().hex}"
    refused = [
        path / f".containment-probe-{uuid.uuid4().hex}"
        for path in dict.fromkeys(read_only_paths or [])
    ]
    try:
        inside.mkdir(mode=0o700)
        result = subprocess.run(
            [
                "systemd-run",
                "--user",
                "--quiet",
                "--wait",
                "--collect",
                "--pipe",
                *containment_properties(writable_paths, read_only_paths),
                "/bin/sh",
                "-c",
                'directory="$1"; shift; touch "$directory/inside" || exit 1; '
                'for path in "$@"; do '
                'if touch "$path" 2>/dev/null; then exit 1; fi; done; exit 0',
                "probe",
                str(inside),
                str(outside),
                *[str(path) for path in refused],
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=20,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    finally:
        shutil.rmtree(inside, ignore_errors=True)
        # A probe file that exists is itself the finding, so it is removed
        # either way rather than left in a path the delegate was supposed
        # to be unable to touch.
        for path in (outside, *refused):
            try:
                path.unlink()
            except FileNotFoundError:
                pass
            except OSError:
                return False
    return result.returncode == 0


def read_only_paths_enforced(target: Path) -> bool:
    """Whether a read-only mapping over `target` is actually enforced.

    This answers the question a caller asks before relying on the
    guarantee: is a write into *this* path blocked? The former shim
    probed a throwaway directory instead and ignored its argument, so it
    reported whether the host can enforce an allowlist somewhere. A
    runner that manages the first but not the second then claimed
    enforcement while the delegate's write landed in the workspace.
    """
    with tempfile.TemporaryDirectory(prefix="orrery-containment-") as directory:
        writable = Path(directory)
        probe = target / f".containment-probe-{uuid.uuid4().hex}"
        try:
            result = subprocess.run(
                [
                    "systemd-run",
                    "--user",
                    "--quiet",
                    "--wait",
                    "--collect",
                    "--pipe",
                    *containment_properties([writable]),
                    "/bin/sh",
                    "-c",
                    'touch "$1/inside" && ! touch "$2"',
                    "probe",
                    str(writable),
                    str(probe),
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=20,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            return False
        finally:
            try:
                probe.unlink()
            except FileNotFoundError:
                pass
            except OSError:
                return False
        return result.returncode == 0


def repository_read_only_paths(workspace: Path) -> list[Path]:
    """Every path a read-only role must not be able to write.

    The workspace alone is not the repository. A linked worktree keeps
    its refs, config and hooks in the common git directory, which lives
    with the main checkout: a delegate that cannot touch its own
    workspace could still rewrite HEAD, or plant a hook that runs on the
    user's next git command, whenever that directory sits inside one of
    the paths granted above. Measured before this was added, with a
    repository under /tmp: workspace refused, common git directory
    written.
    """
    paths = [workspace]

    def plumbing(*arguments: str) -> str | None:
        try:
            result = subprocess.run(
                ["git", "-C", str(workspace), *arguments],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=20,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            return None
        return result.stdout if result.returncode == 0 else None

    # Plain --git-common-dir rather than --path-format=absolute, which
    # only git 2.31 and later understands: losing this path to an older
    # git would silently drop the mapping that matters most, and nothing
    # downstream would notice because the probe only tests what it is
    # given. Relative output is relative to the workspace, since that is
    # where git ran.
    common = plumbing("rev-parse", "--git-common-dir")
    if common and common.strip():
        paths.append(workspace / common.strip())
    listing = plumbing("worktree", "list", "--porcelain")
    for line in (listing or "").splitlines():
        if line.startswith("worktree "):
            paths.append(Path(line[len("worktree "):]))

    seen: dict[Path, None] = {}
    for path in paths:
        try:
            resolved = path.resolve(strict=True)
        except (OSError, RuntimeError):
            continue
        # systemd refuses to start a unit naming a path that is not
        # there, so a stale worktree entry would take the run down.
        seen.setdefault(resolved, None)
    return list(seen)


def grant_defeating(
    protected: list[Path], writable_paths: list[Path]
) -> str | None:
    """A write grant that defeats a read-only mapping, described, or None.

    Measured, because the direction is not symmetric: the deeper mapping
    wins. A grant *containing* a protected path leaves it read-only,
    which is what makes a workspace under /tmp safe. A grant *nested
    inside* one wins instead, so `--receipts` pointed within a reviewed
    tree would hand the delegate a writable pocket of it. A grant naming
    the same path loses to the mapping, which is safe but means the grant
    silently stops doing what it was added for.
    """
    grants = [path.resolve(strict=False) for path in writable_paths]
    for target in protected:
        resolved = target.resolve(strict=False)
        for grant in grants:
            if grant == resolved:
                return f"{grant} is granted and mapped read-only at once"
            if resolved in grant.parents:
                return f"{grant} is granted inside read-only {resolved}"
    return None


def ancestors_to_pin(
    protected: list[Path], writable_paths: list[Path]
) -> tuple[list[Path], str | None]:
    """Ancestors that must be mapped too, or why they cannot be.

    A read-only mapping protects a directory's contents and makes it a
    mount point, which cannot be renamed. It says nothing about the
    directory's ancestors. Measured: with the repository two levels under
    /tmp, a delegate refused every write inside its workspace could still
    rename the workspace's parent and recreate the path with a tree of
    its own, which the runner and the user would then read as the
    original. Every ancestor whose own parent is writable is therefore
    mapped as well, which makes it a mount point in turn; the walk stops
    where the parent is no longer writable, so a workspace directly under
    /tmp costs nothing.
    """
    grants = [path.resolve(strict=False) for path in writable_paths]

    def writable(path: Path) -> bool:
        return any(grant == path or grant in path.parents for grant in grants)

    resolved_protected = {path.resolve(strict=False) for path in protected}
    pinned: dict[Path, None] = {}
    for target in protected:
        current = target.resolve(strict=False)
        while current.parent != current and writable(current.parent):
            # `current` sits in a writable directory, so it can be
            # renamed and must be a mount point of its own. The target
            # already is one; its ancestors are not.
            if current not in resolved_protected:
                if any(grant == current for grant in grants):
                    # It would have to be granted and refused at once,
                    # and the mapping wins, so the grant would stop doing
                    # what it exists for. The layout cannot give the
                    # guarantee.
                    return [], f"{current} is granted but must be pinned read-only"
                pinned.setdefault(current, None)
            current = current.parent
    return list(pinned), None


def workspace_overlap(workspace: Path, trusted: dict[str, Path]) -> str | None:
    """Return the trusted path a writable workspace would contain."""
    resolved_workspace = workspace.resolve(strict=True)
    for label, path in trusted.items():
        resolved = path.resolve(strict=False)
        if resolved == resolved_workspace or resolved_workspace in resolved.parents:
            return f"workspace and {label}"
    return None


def unit_is_loaded(unit: str) -> bool:
    loaded, _active_state = unit_status(unit)
    return loaded


def wait_for_unit_registration(
    process: subprocess.Popen[bytes],
    unit: str,
    timeout: float = 15.0,
) -> bool:
    deadline = time.monotonic() + timeout

    while time.monotonic() < deadline:
        if unit_is_loaded(unit):
            return True
        if process.poll() is not None:
            return False
        time.sleep(0.05)

    raise RuntimeError(
        f"transient review unit was not registered: {unit}"
    )


def unit_is_settled(unit: str) -> bool:
    """True when the unit is gone or has reached a known terminal state.

    Only `inactive` and `failed` count as terminal. Every other loaded state,
    including states this version of the toolkit does not know about, is
    treated as still needing cleanup, and blank state reporting is an error
    rather than an implicit success.
    """
    loaded, active_state = unit_status(unit)
    if not loaded:
        return True

    if not active_state:
        raise RuntimeError(
            f"systemctl returned an empty ActiveState for {unit}"
        )

    return active_state in TERMINAL_STATES


def wait_until_settled(unit: str, seconds: float) -> bool:
    deadline = time.monotonic() + seconds
    while True:
        if unit_is_settled(unit):
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.2)


def stop_unit(unit: str) -> None:
    problems: list[str] = []

    def attempt(*arguments: str) -> None:
        # A failure here is recorded rather than raised so that a stop that
        # fails, or times out on a wedged user bus, still reaches the
        # SIGKILL escalation below instead of leaving Codex running.
        try:
            result = run_systemctl(*arguments, timeout=20.0)
        except RuntimeError as exc:
            problems.append(str(exc))
            return

        if result.returncode != 0:
            problems.append(str(systemctl_error(arguments[0], result)))

    def settled(seconds: float = STOP_SETTLE_SECONDS) -> bool:
        try:
            return wait_until_settled(unit, seconds)
        except RuntimeError as exc:
            problems.append(str(exc))
            return False

    # A failure to read the state is not treated as an absent unit. The stop
    # and the escalation below are attempted anyway, because they are
    # harmless when the unit really is gone and essential when it is not.
    if settled(0.0):
        return

    attempt("stop", unit)
    if settled():
        return

    # `systemctl stop` can fail, time out, or report success while the
    # control group is still alive.
    # `--kill-who`, not `--kill-whom`: the older spelling is accepted by
    # every supported systemd release, while the newer one is rejected
    # before systemd 252 and would silently disarm this escalation there.
    attempt("kill", "--kill-who=all", "--signal=KILL", unit)
    if settled():
        return

    problems.append(f"transient review unit did not stop: {unit}")
    raise RuntimeError("; ".join(problems))


def terminate_group(process: subprocess.Popen[bytes]) -> None:
    """Signal the whole process group, even after its leader has exited.

    In the fallback mode the group is the only containment there is, so a
    descendant must not survive merely because the leader finished first.
    The group identifier cannot be reused while any member lives; the
    window after the last member dies is unavoidable without procfs and is
    kept minimal by signalling immediately.
    """
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return

    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        try:
            os.killpg(process.pid, 0)
        except ProcessLookupError:
            return
        time.sleep(0.1)

    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        return


def terminate_client(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is not None:
        return

    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return

    try:
        process.wait(timeout=5.0)
        return
    except subprocess.TimeoutExpired:
        pass

    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        return

    try:
        process.wait(timeout=5.0)
    except subprocess.TimeoutExpired:
        pass


def write_service_launcher(
    run_dir: Path,
    tmp_dir: Path,
    provider: str,
    role_id: str = "",
    endpoint: Any = None,
    receipts: Path | None = None,
) -> tuple[Path, Path]:
    environment_path = run_dir / "service-environment.json"
    environment_fd = os.open(
        environment_path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL,
        0o600,
    )
    with os.fdopen(environment_fd, "w", encoding="utf-8") as handle:
        json.dump(
            provider_environment(provider, tmp_dir, role_id, endpoint),
            handle,
            ensure_ascii=False,
        )
        handle.flush()
        os.fsync(handle.fileno())

    launcher_path = run_dir / "service-launcher.py"
    launcher = (
        "#!/usr/bin/env python3\n"
        "import json\n"
        "import os\n"
        "import sys\n"
        "from pathlib import Path\n"
        "environment_path = Path(sys.argv[1])\n"
        "environment = json.loads(environment_path.read_text())\n"
        "environment_path.unlink(missing_ok=True)\n"
    )
    if receipts is None:
        launcher += "os.execvpe(sys.argv[2], sys.argv[2:], environment)\n"
    else:
        launcher += (
            "import threading\n"
            "from datetime import datetime, timezone\n"
            f"receipts = Path({str(receipts)!r})\n"
            "started = datetime.now(timezone.utc).isoformat()\n"
            "try:\n"
            "    stdout_log = os.open(receipts / 'stdout.log', os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)\n"
            "    stderr_log = os.open(receipts / 'stderr.log', os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)\n"
            "except OSError as exc:\n"
            "    print(f'orrery-review: could not write receipts: {exc}', file=sys.stderr)\n"
            "    raise SystemExit(1)\n"
            "child = __import__('subprocess').Popen(sys.argv[2:], env=environment, stdout=__import__('subprocess').PIPE, stderr=__import__('subprocess').PIPE)\n"
            "counts = [0, 0]\n"
            "def write_all(fd, chunk):\n"
            "    while chunk:\n"
            "        written = os.write(fd, chunk)\n"
            "        chunk = chunk[written:]\n"
            "def copy(source, log_fd, output_fd, index):\n"
            "    while True:\n"
            "        chunk = source.read(65536)\n"
            "        if not chunk:\n"
            "            return\n"
            "        counts[index] += len(chunk)\n"
            "        write_all(log_fd, chunk)\n"
            "        os.fsync(log_fd)\n"
            "        write_all(output_fd, chunk)\n"
            "threads = [threading.Thread(target=copy, args=(child.stdout, stdout_log, 1, 0)), threading.Thread(target=copy, args=(child.stderr, stderr_log, 2, 1))]\n"
            "[thread.start() for thread in threads]\n"
            "status = child.wait()\n"
            "[thread.join() for thread in threads]\n"
            "os.close(stdout_log)\n"
            "os.close(stderr_log)\n"
            "receipt = {'v': 1, 'exit_status': status, 'started': started, 'ended': datetime.now(timezone.utc).isoformat(), 'stdout_bytes': counts[0], 'stderr_bytes': counts[1]}\n"
            "try:\n"
            "    fd = os.open(receipts / 'receipt.json', os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)\n"
            "    with os.fdopen(fd, 'w', encoding='utf-8') as handle:\n"
            "        json.dump(receipt, handle, separators=(',', ':'))\n"
            "        handle.flush()\n"
            "        os.fsync(handle.fileno())\n"
            "except OSError as exc:\n"
            "    print(f'orrery-review: could not write receipt: {exc}', file=sys.stderr)\n"
            "    raise SystemExit(1)\n"
            "raise SystemExit(status)\n"
        )
    launcher_path.write_text(launcher)
    launcher_path.chmod(0o700)
    return launcher_path, environment_path


def provider_state_paths(provider: str) -> list[Path]:
    """Directories a provider CLI must write to start at all.

    Measured, not assumed: a live Codex delegate fails at app-server
    initialisation when its own home is read-only. Only the running
    provider's own directory is granted, so a delegate cannot write the
    other provider's configuration, the adoption or standing stores, or
    anything on PATH.

    The grant is wide, and it is a persistence channel rather than only a
    credential one: this directory holds the settings that define hooks
    for the operator's next interactive session, and the configuration
    that names MCP servers and notify commands. A read-only role can
    write it. Narrowing that to the individual files is possible, since a
    read-only mapping nested inside a grant is honoured, but it changes
    what a live provider CLI may do at startup and has not been measured
    against one.
    """
    paths: list[Path] = []
    if provider == "openai":
        candidate = codex_home()
    else:
        raw = os.environ.get("CLAUDE_CONFIG_DIR")
        candidate = Path(raw).expanduser() if raw else Path.home() / ".claude"
    try:
        resolved = candidate.resolve(strict=False)
    except (OSError, RuntimeError):
        return paths
    if resolved.is_dir():
        paths.append(resolved)
    return paths


def write_receipt_unit(receipts: Path, unit: str | None, pgid: int | None = None) -> None:
    payload: dict[str, Any] = {
        "v": 1,
        "unit": unit,
        "owner_pid": os.getpid(),
        "owner_start": process_start_time(os.getpid()),
    }
    if pgid is not None:
        payload["pgid"] = pgid
    path = receipts / "unit.json"
    fd = receipt_open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, separators=(",", ":"))
        handle.flush()
        os.fsync(handle.fileno())


def process_start_time(pid: int) -> int | None:
    """Start time of a live process, or None if it cannot do any more work.

    A zombie counts as gone: it has already exited, so it will never run
    cleanup, even though /proc still lists it.
    """
    try:
        text = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None

    fields = text[text.rfind(")") + 2 :].split()
    try:
        if fields[0] == "Z":
            return None
        return int(fields[19])
    except (IndexError, ValueError):
        return None


def process_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def record_runtime_owner(run_dir: Path, unit: str = "", task_owned: bool = False) -> None:
    # No numeric sentinel for an unknown start time. It has to read back as
    # unattributable rather than as a match for any owner.
    start = process_start_time(os.getpid())
    (run_dir / "owner").write_text(
        f"{os.getpid()} {start if start is not None else 'unknown'} {unit or ('-' if task_owned else '')}"
        f"{' task' if task_owned else ''}\n"
    )


def read_runtime_owner(run_dir: Path) -> tuple[int | None, str, bool]:
    """The recorded start time and unit name, parsed independently.

    An unparseable start time must not also discard the unit name, or an
    orphaned unit would be left running while its state was reclaimed.
    """
    try:
        fields = (run_dir / "owner").read_text().split()
    except OSError:
        return None, "", False

    start: int | None = None
    if len(fields) > 1:
        try:
            start = int(fields[1])
        except ValueError:
            start = None

    return start, fields[2] if len(fields) > 2 else "", len(fields) > 3 and fields[3] == "task"


def force_remove(path: Path) -> bool:
    """Remove a tree, clearing permissions that would block the removal.

    Codex or one of its descendants can leave an unreadable directory in
    the run directory. Without restoring access first, every later sweep
    would silently skip it and the state would never be reclaimed.
    """
    if path.is_symlink():
        # rmtree refuses to remove a symlink, so it is unlinked directly.
        # Its referent is left entirely alone.
        try:
            path.unlink()
        except OSError:
            pass
        return not os.path.lexists(path)

    try:
        os.chmod(path, 0o700)
    except OSError:
        pass

    for directory, names, _files in os.walk(
        path,
        topdown=True,
        onerror=lambda _error: None,
    ):
        for name in names:
            entry = os.path.join(directory, name)

            # os.walk lists directory symlinks without descending into them,
            # and os.chmod follows symlinks by default. Changing the mode of
            # whatever a reviewed process linked to would reach outside the
            # runtime tree entirely.
            if os.path.islink(entry):
                continue

            try:
                os.chmod(entry, 0o700)
            except OSError:
                continue

    shutil.rmtree(path, ignore_errors=True)
    return not os.path.lexists(path)


def sweep_stale_runtime(root: Path) -> None:
    """Reclaim run directories owned by wrappers that no longer exist.

    An uncatchable death cannot run this wrapper's own cleanup, so the next
    run reclaims what was left behind. The directory can hold the prompt,
    the Codex log, the verdict, and, if the wrapper died before the service
    started, the serialised environment. The recorded start time also makes
    a reused process identifier fail to protect a dead owner's directory.

    The orphaned unit is stopped before its state is removed, and the state
    is kept if the stop cannot be confirmed, so files are never pulled out
    from under a Codex run that may still be going. A later sweep retries,
    and the unit's own RuntimeMaxSec bounds it regardless.
    """
    for entry in root.glob("run.*"):
        parts = entry.name.split(".")
        if len(parts) < 3 or not parts[1].isdigit():
            continue

        owner = int(parts[1])
        recorded, unit, task_owned = read_runtime_owner(entry)
        if task_owned or unit.startswith("orrery-task-"):
            continue
        live_start = process_start_time(owner)

        if (
            live_start is None
            and not Path("/proc").is_dir()
            and process_alive(owner)
        ):
            # Without procfs a live owner has no readable start time. Never
            # reclaim state from under a process that is demonstrably alive.
            continue

        if live_start is not None:
            # Only a recorded start time that matches proves the directory
            # belongs to the process that is currently alive. Matching on
            # the identifier alone would let a reused identifier, including
            # one reused by this very process, protect a dead owner's state.
            if recorded == live_start:
                continue

            if recorded is None and owner != os.getpid():
                # Alive but unattributable, so not safely abandoned. A
                # directory naming this process cannot be its own, because
                # this sweep runs before this process creates one.
                continue

        if unit:
            try:
                stop_unit(unit)
            except RuntimeError:
                # The unit could not be confirmed stopped, so its files stay.
                incident_log.record(
                    "runtime-reclaim-failed",
                    program=PROGRAM_NAME,
                    detail=(
                        f"orphaned unit {unit} could not be confirmed "
                        "stopped; state kept for a later sweep"
                    ),
                )
                continue

        if not force_remove(entry):
            print(
                f"orrery-review: could not reclaim {entry}",
                file=sys.stderr,
            )
            incident_log.record(
                "runtime-reclaim-failed",
                program=PROGRAM_NAME,
                detail=f"could not reclaim {entry.name}",
            )
        else:
            # A reclaimed directory means an earlier wrapper died
            # uncatchably; nothing else can have recorded that.
            incident_log.record(
                "runtime-reclaimed",
                program=PROGRAM_NAME,
                detail=f"reclaimed {entry.name}"
                + (f" and stopped {unit}" if unit else ""),
            )


def claude_verdict(log_path: Path) -> str:
    """The final result string from a delegated Claude JSON log.

    The provider's stderr is merged into the log, and the CLI can prepend
    diagnostics there (for example the subprocess-scrub hardening
    warning), so when the whole text is not pure JSON the result object
    is recovered from the last parseable JSON line instead.
    """
    text = log_path.read_text(errors="replace")
    candidates = [text]
    candidates.extend(
        line
        for line in reversed(text.splitlines())
        if line.lstrip().startswith("{")
    )
    for candidate in candidates:
        try:
            payload = json.loads(candidate)
        except json.JSONDecodeError:
            continue
        if isinstance(payload, dict):
            verdict = payload.get("result")
            if isinstance(verdict, str) and verdict.strip():
                return verdict
            # Under --json-schema the result is the structured document
            # itself rather than prose. Accepting only a string here would
            # classify a perfectly good structured reply as a provider
            # failure, and the retry would then record missing-result for
            # a fault no retry can fix.
            if isinstance(verdict, (dict, list)):
                return json.dumps(verdict, sort_keys=True)
    raise ValueError("the log holds no JSON result object")


def bounded_prefix(destination: Path, reserve: int = 8) -> str:
    """A same-directory temporary prefix that leaves room within NAME_MAX.

    `tempfile` appends random characters to the prefix, so a destination
    whose own name is near the limit would otherwise make publication fail
    after the review has already succeeded. NAME_MAX bounds bytes, and
    whole characters are dropped so a multi-byte sequence is never split.
    """
    try:
        limit = int(os.pathconf(destination.parent, "PC_NAME_MAX"))
    except (OSError, ValueError, AttributeError):
        limit = 255

    # Two more bytes for the leading and trailing dot.
    available = max(1, limit - reserve - 2)
    stem = destination.name
    while len(stem) > 1 and len(os.fsencode(stem)) > available:
        stem = stem[:-1]

    return f".{stem}."


def publish_atomically(source: Path, destination: Path) -> None:
    destination = destination.expanduser()
    destination.parent.mkdir(parents=True, exist_ok=True)

    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="wb",
            dir=destination.parent,
            prefix=bounded_prefix(destination),
            delete=False,
        ) as handle:
            temporary = Path(handle.name)
            with source.open("rb") as source_handle:
                shutil.copyfileobj(source_handle, handle)
            handle.flush()
            os.fsync(handle.fileno())

        temporary.chmod(0o600)
        os.replace(temporary, destination)
        temporary = None

        directory_fd = os.open(destination.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def record_standing(
    configured: Role,
    candidate: Role,
    decision: ConsentDecision,
    *,
    reason: str,
    failure_scope: str,
) -> None:
    """Persist an approved standing scope, tolerating storage failure."""
    if decision.scope == RUN_SCOPE:
        return
    try:
        record = record_approval(
            configured=configured,
            candidate=candidate,
            scope=decision.scope,
            expires_at=decision.expires_at,
            reason=reason,
            failure_scope=failure_scope,
        )
    except (RuntimeConfigError, OSError) as exc:
        print(
            f"{PROGRAM_NAME}: the standing approval could not be recorded "
            f"({exc}); it applies to this run only.",
            file=sys.stderr,
        )
        incident_log.record(
            "standing-record-failed",
            program=PROGRAM_NAME,
            role=configured,
            detail=str(exc),
        )
        return
    print(
        f"{PROGRAM_NAME}: standing fallback recorded · {describe(record)}",
        file=sys.stderr,
    )
    incident_log.record(
        "standing-recorded",
        program=PROGRAM_NAME,
        role=configured,
        candidate=f"{candidate.provider}:{candidate.model}",
        approval_scope=decision.scope,
    )


def adopt_standing_approval(state: DelegationState) -> dict | None:
    """Adopt a live standing approval, or leave the state untouched.

    The recorded candidate is started exactly as approved, never
    re-ranked. An unavailable candidate keeps the record and lets the
    configured role be attempted normally.
    """
    record = match(state.configured)
    if record is None:
        return None
    candidate = candidate_role(state.configured, record)
    availability = provider_status(candidate.provider)
    if availability.state is Availability.UNAVAILABLE:
        print(
            f"{PROGRAM_NAME}: the standing fallback candidate is "
            f"unavailable ({availability.reason}); the configured role "
            "will be attempted.",
            file=sys.stderr,
        )
        incident_log.record(
            "standing-unavailable",
            program=PROGRAM_NAME,
            role=state.configured,
            detail=availability.reason,
            candidate=f"{candidate.provider}:{candidate.model}",
        )
        return None
    if record["failure_scope"] == "model":
        state.excluded_models.add(
            (record["failed_provider"], record["failed_model"])
        )
    elif record["failure_scope"] == "provider":
        state.excluded_providers.add(record["failed_provider"])
    state.role = candidate
    state.is_fallback = True
    print(
        f"{PROGRAM_NAME}: standing fallback active · {describe(record)}",
        file=sys.stderr,
    )
    incident_log.record(
        "standing-adopted",
        program=PROGRAM_NAME,
        role=state.configured,
        candidate=f"{candidate.provider}:{candidate.model}",
    )
    return record


def handle_failed_attempt(
    invocation: Invocation,
    state: DelegationState,
    *,
    reason: str,
    status: int,
    scope: FailureScope,
    context_warning: bool,
    require_rerun_after_inspection: bool = False,
    approval_required_status: int | None = None,
    diagnostics: str = "",
    kind: str = "provider-failure",
    incident_fields: dict[str, Any] | None = None,
) -> int:
    """Retry one transient failure or request exact fallback consent."""
    failed = state.role
    # Reserved names are filtered so a future caller's field can never
    # collide with an explicit parameter and abort the failure handler
    # with a TypeError before record()'s own never-raise guard applies.
    extra_fields = {
        "scope": scope.value,
        "fallback": state.is_fallback,
        **{
            name: value
            for name, value in (incident_fields or {}).items()
            if name not in {"kind", "program", "role", "detail", "status"}
        },
    }
    incident_log.record(
        kind,
        program=PROGRAM_NAME,
        role=failed,
        detail=reason,
        status=status,
        **extra_fields,
    )
    identity = (failed.provider, failed.model)
    if (
        scope is FailureScope.TRANSIENT
        and identity not in state.transient_retries
        and not require_rerun_after_inspection
    ):
        state.transient_retries.add(identity)
        print(
            f"{PROGRAM_NAME}: transient failure detected for "
            f"{failed.provider}/{failed.model}; retrying it once.",
            file=sys.stderr,
            flush=True,
        )
        incident_log.record(
            "transient-retry",
            program=PROGRAM_NAME,
            role=failed,
            detail=reason,
        )
        raise NextAttempt(invocation, state)
    if (
        scope is FailureScope.TRANSIENT
        and identity not in state.transient_retries
        and require_rerun_after_inspection
    ):
        print(
            f"{PROGRAM_NAME}: transient retry skipped because the failed "
            "write-capable attempt changed the workspace or its unchanged "
            "state could not be verified.",
            file=sys.stderr,
            flush=True,
        )

    if scope is FailureScope.MODEL:
        state.excluded_models.add(identity)
    else:
        state.excluded_providers.add(failed.provider)

    proposal = nearest_fallback(
        state.configured,
        reason,
        excluded_providers=state.excluded_providers,
        excluded_models=state.excluded_models,
    )
    if proposal is None:
        print(
            f"{PROGRAM_NAME}: no authenticated or potentially authenticated "
            "fallback candidate remains; no substitution was made.",
            file=sys.stderr,
        )
        incident_log.record(
            "fallback-unavailable",
            program=PROGRAM_NAME,
            role=failed,
            detail=reason,
            status=status,
        )
        return status

    disclosures: tuple[str, ...] = ()
    if state.configured.read_only:
        try:
            principal = load_role("orchestrator")
        except RuntimeConfigError:
            principal = None
        if principal is not None and (
            principal.provider == proposal.candidate.provider
            or principal.model == proposal.candidate.model
        ):
            disclosures = (
                "The candidate shares the configured principal's provider "
                "or model; this review would be session-independent, not "
                "cross-provider.",
            )
    decision = request_fallback_decision(
        proposal,
        approval=invocation.approval,
        no_fallback=invocation.no_fallback,
        program_name=PROGRAM_NAME,
        original_status=status,
        context_warning=context_warning,
        require_rerun_after_inspection=require_rerun_after_inspection,
        reset_time=parse_reset_time(diagnostics),
        approval_scope=invocation.approval_scope,
        extra_disclosures=disclosures,
    )
    if decision.consent is Consent.APPROVED:
        incident_log.record(
            "fallback-approved",
            program=PROGRAM_NAME,
            role=failed,
            candidate=proposal.approval_key,
            approval_scope=decision.scope,
            crosses_provider=proposal.crosses_provider,
        )
        record_standing(
            state.configured,
            proposal.candidate,
            decision,
            reason=reason,
            failure_scope=scope.value,
        )
        state.role = proposal.candidate
        state.is_fallback = True
        raise NextAttempt(invocation, state)
    if decision.consent is Consent.REQUIRED:
        incident_log.record(
            "fallback-approval-required",
            program=PROGRAM_NAME,
            role=failed,
            candidate=proposal.approval_key,
            inspection_required=require_rerun_after_inspection,
            status=status,
        )
        return (
            APPROVAL_REQUIRED
            if approval_required_status is None
            else approval_required_status
        )
    incident_log.record(
        "fallback-declined",
        program=PROGRAM_NAME,
        role=failed,
        candidate=proposal.approval_key,
        status=status,
    )
    return status


def main(
    invocation: Invocation | None = None,
    state: DelegationState | None = None,
) -> int:
    # Everything this wrapper creates is private session state that it also
    # reads back. A umask can only remove bits, so setting it here makes
    # that private without a restrictive inherited umask being able to make
    # the log, the verdict, or the service environment unreadable. The
    # delegated provider process inherits it too.
    os.umask(0o077)

    try:
        if invocation is None:
            invocation = parse_args(sys.argv[1:])
    except PlainUsageError as exc:
        print(f"{PROGRAM_NAME}: {exc}", file=sys.stderr)
        return 2
    except UsageError as exc:
        print(f"{PROGRAM_NAME}: {exc}", file=sys.stderr)
        print(usage(), file=sys.stderr, end="")
        return 2

    if invocation.revoke:
        try:
            removed = revoke_all()
        except OSError as exc:
            print(
                f"{PROGRAM_NAME}: the standing-approval store could not be "
                f"cleared: {exc}",
                file=sys.stderr,
            )
            return 1
        if removed:
            for record in removed:
                print(f"revoked standing fallback · {describe(record)}")
        else:
            print("No standing fallback approvals.")
        return 0

    try:
        if state is None:
            configured = load_role(invocation.role_id)
            state = DelegationState(configured=configured, role=configured)
            # Budgets are validated before any consent handling or
            # provider preflight, so an invalid pair can never trigger
            # a fallback proposal or record a standing approval on its
            # way to rejection.
            base_budget, hard_budget = effective_budgets(
                invocation, configured
            )
            if hard_budget < base_budget:
                print(
                    f"{PROGRAM_NAME}: --hard-timeout must not be smaller "
                    f"than the effective timeout ({base_budget}s)",
                    file=sys.stderr,
                )
                return 2
            if invocation.approval is not None:
                (
                    proposal,
                    state.excluded_providers,
                    state.excluded_models,
                ) = proposal_for_approval(
                    configured,
                    invocation.approval,
                )
                if proposal is None:
                    print(
                        f"{PROGRAM_NAME}: the approved fallback is no longer "
                        "a potentially available candidate; no process was "
                        "started.",
                        file=sys.stderr,
                    )
                    incident_log.record(
                        "fallback-unavailable",
                        program=PROGRAM_NAME,
                        role=configured,
                        detail=(
                            "the approved fallback is no longer a "
                            "potentially available candidate"
                        ),
                        candidate=f"{invocation.approval[0]}:"
                        f"{invocation.approval[1]}",
                    )
                    return APPROVAL_REQUIRED
                decision = request_fallback_decision(
                    proposal,
                    approval=invocation.approval,
                    no_fallback=False,
                    program_name=PROGRAM_NAME,
                    approval_scope=invocation.approval_scope,
                )
                if decision.consent is not Consent.APPROVED:
                    incident_log.record(
                        "fallback-approval-required"
                        if decision.consent is Consent.REQUIRED
                        else "fallback-declined",
                        program=PROGRAM_NAME,
                        role=configured,
                        candidate=proposal.approval_key,
                    )
                    return (
                        APPROVAL_REQUIRED
                        if decision.consent is Consent.REQUIRED
                        else 2
                    )
                incident_log.record(
                    "fallback-approved",
                    program=PROGRAM_NAME,
                    role=configured,
                    candidate=proposal.approval_key,
                    approval_scope=decision.scope,
                    crosses_provider=proposal.crosses_provider,
                )
                record_standing(
                    configured,
                    proposal.candidate,
                    decision,
                    reason=proposal.reason,
                    failure_scope=(
                        "model"
                        if invocation.approval[0] == configured.provider
                        else "provider"
                    ),
                )
                state.role = proposal.candidate
                state.is_fallback = True
            elif invocation.no_fallback:
                if match(configured) is not None:
                    print(
                        f"{PROGRAM_NAME}: standing fallback approvals are "
                        "ignored under --no-fallback.",
                        file=sys.stderr,
                    )
            else:
                adopt_standing_approval(state)
        role_config = state.role
        verbosity = load_verbosity()
        if role_config.provider == "openai":
            codex_home()
    except RuntimeConfigError as exc:
        print(f"{PROGRAM_NAME}: {exc}", file=sys.stderr)
        incident_log.record(
            "config-error",
            program=PROGRAM_NAME,
            role=state.role if state is not None else None,
            detail=str(exc),
            status=2,
        )
        return 2

    try:
        availability = role_availability(role_config)
    except RuntimeConfigError as exc:
        print(f"{PROGRAM_NAME}: {exc}", file=sys.stderr)
        return 2
    if availability.state is Availability.UNAVAILABLE:
        return handle_failed_attempt(
            invocation,
            state,
            reason=availability.reason,
            status=2,
            scope=FailureScope.PROVIDER,
            context_warning=False,
            approval_required_status=APPROVAL_REQUIRED,
            kind="provider-unavailable",
        )
    if availability.state is Availability.UNKNOWN:
        print(
            f"{PROGRAM_NAME}: warning: {availability.reason}; attempting the "
            "configured process.",
            file=sys.stderr,
        )
        incident_log.record(
            "provider-unknown",
            program=PROGRAM_NAME,
            role=role_config,
            detail=availability.reason,
        )
    elif availability.state is Availability.READY and role_config.endpoint is None:
        visibility, visibility_reason = model_status(role_config, availability)
        if visibility is Availability.UNAVAILABLE:
            return handle_failed_attempt(
                invocation,
                state,
                reason=visibility_reason,
                status=2,
                scope=FailureScope.MODEL,
                context_warning=False,
                approval_required_status=APPROVAL_REQUIRED,
                kind="model-unavailable",
            )

    timeout_seconds, hard_timeout_seconds = effective_budgets(
        invocation, state.configured
    )
    output_path = invocation.output_path
    prompt = invocation.prompt
    role_id = invocation.role_id
    workspace = (invocation.workspace or Path.cwd()).resolve(strict=True)
    receipts = invocation.receipts

    runtime_base = Path(
        os.environ.get("XDG_RUNTIME_DIR", str(Path.home() / ".cache"))
    )
    # Keep the established internal runtime namespace so interrupted runs
    # from older Orrery versions are reclaimed by the same sweeper.
    runtime_root = runtime_base / "orrery-review"
    runtime_root.mkdir(parents=True, exist_ok=True)
    runtime_root.chmod(0o700)
    trusted_paths = {
        "real home": Path.home(),
        "CODEX_HOME": codex_home(),
        "Claude configuration directory": Path(
            os.environ.get("CLAUDE_CONFIG_DIR", str(Path.home() / ".claude"))
        ),
        "XDG state root": Path(
            os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local" / "state"))
        ),
        "run directory root": runtime_root,
    }
    overlap = workspace_overlap(workspace, trusted_paths)
    if overlap is not None:
        print(f"{PROGRAM_NAME}: refusing overlapping {overlap}", file=sys.stderr)
        return 2

    # systemd gives the run control-group containment and a RuntimeMaxSec
    # backstop. Where it does not exist, such as on macOS, the run degrades
    # to a plain process group: timeout and interruption still kill the
    # group, but a descendant that detaches from it can only be caught by
    # the surrounding Leave No Trace sweeps.
    use_systemd = all(
        shutil.which(tool) is not None for tool in ("systemd-run", "systemctl")
    )
    display, purpose = role_label(role_id)
    print(
        (
            f"↳ Fallback {display.lower()}"
            if state.is_fallback
            else f"↳ {display}"
        )
        + f" · {role_config.provider} · {role_config.model}"
        + (
            f" · thinking {role_config.thinking}"
            if role_config.thinking
            else ""
        )
        + (
            f" · via {role_config.endpoint.label}"
            if role_config.endpoint is not None
            else ""
        )
        + f" · {purpose}",
        file=sys.stderr,
        flush=True,
    )

    unit_prefix = "orrery-task" if receipts is not None else "orrery-review"
    unit_base = (
        f"{unit_prefix}-{os.getpid()}-"
        f"{uuid.uuid4().hex[:10]}"
    )
    unit = f"{unit_base}.service"
    process: subprocess.Popen[bytes] | None = None
    unit_may_exist = False
    control_returned = False
    canary_snapshot = None
    def return_control() -> None:
        nonlocal control_returned
        if not control_returned:
            print(
                "↳ Principal orchestrator · control resumed",
                file=sys.stderr,
                flush=True,
            )
            control_returned = True

    def handle_signal(signum: int, _frame: object) -> None:
        # Every other handled signal is blocked before the exception is
        # raised, so a second interruption cannot land inside the cleanup in
        # `finally` and abandon it part way through.
        signal.pthread_sigmask(signal.SIG_BLOCK, handled_signals)
        raise ReviewInterrupted(signum)

    # Deliberately not a TemporaryDirectory: its finaliser would remove the
    # state at garbage collection even when the unit could not be confirmed
    # stopped, which is exactly the case where the state has to survive.
    run_dir: Path | None = None
    # Held outside the try so the cleanup block can publish the log
    # even when the run failed before reaching its normal exit.
    published_log_path: Path | None = None
    unit_stopped = True
    handled_signals: set[signal.Signals] = set()

    try:
        for signal_number in sorted(interrupting_signals()):
            # An inherited SIG_IGN means the caller deliberately made this
            # signal harmless. Overriding it would introduce an interruption
            # that would not otherwise occur.
            try:
                if signal.getsignal(signal_number) is signal.SIG_IGN:
                    continue
                signal.signal(signal_number, handle_signal)
            except (OSError, ValueError, RuntimeError):
                continue
            handled_signals.add(signal_number)

        sweep_stale_runtime(runtime_root)
        run_dir = Path(
            tempfile.mkdtemp(
                prefix=f"run.{os.getpid()}.",
                dir=runtime_root,
            )
        )
        # mkdtemp's mode is masked by the umask, so it is set explicitly.
        run_dir.chmod(0o700)
        writable_paths = [run_dir]
        if not role_config.read_only:
            writable_paths.append(workspace)
        if receipts is not None:
            writable_paths.append(receipts)
        # The provider CLIs write working state of their own outside the
        # run directory and refuse to start without it: Codex 0.104 dies
        # in "failed to initialize in-process app-server client" when its
        # own home is read-only. The provider's own directory is therefore
        # writable; every other user path, including the launcher's PATH,
        # the adoption and standing stores, and the other provider's
        # configuration, stays read-only.
        writable_paths.extend(provider_state_paths(role_config.provider))
        # The provider CLIs build their own sandbox mount points under
        # /tmp and fail with "bwrap: Can't mkdir /tmp/.git: Read-only
        # file system" without it. A first live run missed this because
        # its workspace happened to sit under /tmp and was writable for
        # that reason alone. /tmp is world-writable scratch that holds no
        # Orrery control state, so granting it costs nothing the system
        # did not already allow.
        writable_paths.extend(
            path for path in (Path("/tmp"), Path("/var/tmp")) if path.is_dir()
        )
        # A read-only role's guarantee is that its workspace cannot be
        # written. Leaving the workspace out of the allowlist does not
        # give that, because /tmp, /var/tmp and the provider's own
        # directory are granted just above: a workspace inside any of
        # them was writable while the wrapper said nothing at all. An
        # explicit read-only mapping is honoured against those grants, so
        # the guarantee stops depending on where the workspace sits.
        protected_paths = (
            repository_read_only_paths(workspace) if role_config.read_only else []
        )
        pinned_paths, pin_conflict = ancestors_to_pin(
            protected_paths, writable_paths
        )
        read_only_paths = protected_paths + pinned_paths
        conflict = pin_conflict or grant_defeating(protected_paths, writable_paths)
        confinement_ok = use_systemd and confinement_enforced(
            writable_paths, run_dir
        )
        # Kept separate from the guarantee above so that a workspace the
        # host cannot protect stops read-only roles alone, and never a
        # worker whose workspace is meant to be writable. An empty set of
        # protected paths does not mean "guaranteed": for a read-only
        # role it means the workspace could not even be resolved.
        workspace_guaranteed = not role_config.read_only or (
            bool(protected_paths)
            and conflict is None
            and confinement_ok
            and confinement_enforced(writable_paths, run_dir, read_only_paths)
        )
        if not confinement_ok:
            detail = (
                "composed filesystem confinement unenforceable"
                if use_systemd
                else "systemd unavailable; composed filesystem confinement unenforceable"
            )
            incident_log.record(
                "containment-degraded",
                program=PROGRAM_NAME,
                role=role_config,
                detail=detail,
            )
            if os.environ.get("ORRERY_ALLOW_UNCONFINED") != "1":
                print(
                    f"{PROGRAM_NAME}: confinement is unavailable; set "
                    "ORRERY_ALLOW_UNCONFINED=1 to proceed.",
                    file=sys.stderr,
                )
                return 1
            print(
                f"{PROGRAM_NAME}: confinement is not enforced "
                "(ORRERY_ALLOW_UNCONFINED=1).",
                file=sys.stderr,
            )
        elif not workspace_guaranteed:
            # The allowlist holds but this workspace cannot be mapped
            # read-only, so the one guarantee a read-only role exists to
            # make is unavailable. Fail closed behind the same named
            # escape rather than claim it by staying silent.
            incident_log.record(
                "containment-degraded",
                program=PROGRAM_NAME,
                role=role_config,
                detail=(
                    f"workspace read-only mapping unenforceable: {workspace}"
                    + (f"; {conflict}" if conflict else "")
                ),
            )
            if os.environ.get("ORRERY_ALLOW_UNCONFINED") != "1":
                print(
                    f"{PROGRAM_NAME}: the workspace cannot be mapped "
                    "read-only for a read-only role"
                    + (f" ({conflict})" if conflict else "")
                    + "; set ORRERY_ALLOW_UNCONFINED=1 to proceed.",
                    file=sys.stderr,
                )
                return 1
            print(
                f"{PROGRAM_NAME}: the workspace is not read-only "
                "(ORRERY_ALLOW_UNCONFINED=1).",
                file=sys.stderr,
            )
        record_runtime_owner(run_dir, unit if use_systemd else "", receipts is not None)
        tmp_dir = run_dir / "tmp"
        tmp_dir.mkdir()
        tmp_dir.chmod(0o700)
        verdict_path = (
            receipts / "result.txt" if receipts is not None else run_dir / "verdict.txt"
        )
        if receipts is not None:
            try:
                descriptor = receipt_open(
                    verdict_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                )
                os.close(descriptor)
            except OSError as exc:
                print(f"{PROGRAM_NAME}: could not write receipt: {exc}", file=sys.stderr)
                return 1
        log_path = run_dir / "agent.log"
        published_log_path = log_path
        prompt_path = run_dir / "assignment.txt"
        prompt_path.write_text(role_handoff(role_config, prompt, verbosity))
        prompt_path.chmod(0o600)
        settings_path: Path | None = None
        if role_config.provider == "anthropic":
            settings_path = run_dir / "claude-settings.json"
            settings_path.write_text(
                json.dumps(
                    claude_sandbox_settings(role_config, workspace),
                    indent=2,
                )
                + "\n"
            )
            settings_path.chmod(0o600)
            if canary_snapshot is None:
                # First attempt only: a retried attempt must not mistake
                # the previous attempt's litter for pre-existing files.
                canary_snapshot = claude_canary_snapshot(workspace)
        try:
            provider_arguments = delegated_command(
                role_config,
                verdict_path,
                settings_path,
                invocation.schema_path,
            )
        except RuntimeConfigError as exc:
            print(f"{PROGRAM_NAME}: {exc}", file=sys.stderr)
            return handle_failed_attempt(
                invocation,
                state,
                reason=str(exc),
                status=127,
                scope=FailureScope.PROVIDER,
                context_warning=False,
                approval_required_status=APPROVAL_REQUIRED,
                kind="config-error",
            )

        if use_systemd:
            launcher_path, environment_path = write_service_launcher(
                run_dir,
                tmp_dir,
                role_config.provider,
                role_config.id,
                role_config.endpoint,
                receipts,
            )
            command = [
                "systemd-run",
                "--user",
                "--quiet",
                "--wait",
                "--collect",
                "--pipe",
                f"--unit={unit_base}",
                "--property=Type=exec",
                "--property=KillMode=control-group",
                "--property=TimeoutStopSec=10s",
                # The service is started by the user manager, not forked
                # from this process, so it does not inherit the umask set
                # in main().
                "--property=UMask=0077",
                # Backstop owned by systemd rather than by this process, so
                # an uncatchable death of the wrapper (SIGKILL, power loss
                # of the controlling terminal) still cannot leave Codex
                # running forever. The wrapper's own deadline, extended
                # at most to the hard cap, fires first and reports
                # diagnostics.
                f"--property=RuntimeMaxSec={hard_timeout_seconds + 60}s",
                *containment_properties(writable_paths, read_only_paths),
                f"--working-directory={workspace}",
                sys.executable,
                str(launcher_path),
                str(environment_path),
                *provider_arguments,
            ]
        else:
            # The provider runs as a direct child in its own session, with the
            # same scrubbed environment the launcher would have applied.
            if receipts is not None:
                launcher_path, environment_path = write_service_launcher(
                    run_dir,
                    tmp_dir,
                    role_config.provider,
                    role_config.id,
                    role_config.endpoint,
                    receipts,
                )
                command = [
                    sys.executable,
                    str(launcher_path),
                    str(environment_path),
                    *provider_arguments,
                ]
            else:
                command = provider_arguments

        started = time.monotonic()
        deadline = started + timeout_seconds
        hard_deadline = started + hard_timeout_seconds
        # A read-only role is exempt from inspection because its
        # workspace cannot have changed. Where that guarantee could not
        # be established, the exemption would rest on the role's name
        # rather than on anything enforced, and a tampering delegate
        # would be retried automatically, so it is fingerprinted exactly
        # as a writer is.
        workspace_inspectable = not role_config.read_only or not workspace_guaranteed
        workspace_before = (
            git_workspace_fingerprint(workspace) if workspace_inspectable else None
        )

        def workspace_requires_inspection() -> bool:
            if not workspace_inspectable:
                return False
            workspace_after = git_workspace_fingerprint(workspace)
            return (
                workspace_before is None
                or workspace_after is None
                or workspace_before != workspace_after
            )

        with (
            log_path.open("wb") as log_handle,
            prompt_path.open("rb") as prompt_handle,
        ):
            previous_mask = signal.pthread_sigmask(
                signal.SIG_BLOCK,
                handled_signals,
            )
            try:
                if use_systemd:
                    unit_may_exist = True
                    process = subprocess.Popen(
                        command,
                        stdin=prompt_handle,
                        stdout=log_handle,
                        stderr=subprocess.STDOUT,
                        start_new_session=True,
                        cwd=workspace,
                    )
                    registered = wait_for_unit_registration(process, unit)
                    if receipts is not None and registered:
                        try:
                            write_receipt_unit(receipts, unit)
                        except OSError as exc:
                            terminate_group(process)
                            print(f"{PROGRAM_NAME}: could not write receipt: {exc}", file=sys.stderr)
                            return 1
                else:
                    process = subprocess.Popen(
                        command,
                        stdin=prompt_handle,
                        stdout=log_handle,
                        stderr=subprocess.STDOUT,
                        start_new_session=True,
                        cwd=workspace,
                        env=(
                            None
                            if receipts is not None
                            else provider_environment(
                                role_config.provider,
                                tmp_dir,
                                role_config.id,
                                role_config.endpoint,
                            )
                        ),
                    )
                    if receipts is not None:
                        try:
                            write_receipt_unit(receipts, None, process.pid)
                        except OSError as exc:
                            terminate_group(process)
                            print(
                                f"{PROGRAM_NAME}: could not write receipt: {exc}",
                                file=sys.stderr,
                            )
                            return 1
            finally:
                signal.pthread_sigmask(
                    signal.SIG_SETMASK,
                    previous_mask,
                )

            timed_out = False
            final_growth_age: float | None = None
            last_size = 0
            stream_offset = 0
            extension_recorded = False
            while True:
                now = time.monotonic()
                if now >= deadline:
                    # The growth age is read from the file itself at the
                    # decision moment, so a poll noticing an old write
                    # late can never make stale output look recent.
                    final_growth_age = log_growth_age(log_path)
                    extended = next_deadline(
                        now, deadline, hard_deadline, final_growth_age
                    )
                    if extended is None:
                        timed_out = True
                        break
                    deadline = extended
                    if not extension_recorded:
                        extension_recorded = True
                        incident_log.record(
                            "budget-extended",
                            program=PROGRAM_NAME,
                            role=role_config,
                            timeout_seconds=timeout_seconds,
                            hard_timeout_seconds=hard_timeout_seconds,
                        )
                    print(
                        "  budget extended · output is still growing · "
                        f"up to {int(deadline - started)}s of "
                        f"{hard_timeout_seconds}s",
                        file=sys.stderr,
                        flush=True,
                    )
                    continue

                try:
                    return_code = process.wait(
                        timeout=min(30.0, deadline - now)
                    )
                    break
                except subprocess.TimeoutExpired:
                    try:
                        size = log_path.stat().st_size
                    except OSError:
                        size = last_size
                    grew = size > last_size
                    elapsed = int(time.monotonic() - started)
                    line = f"  still running · {elapsed}s elapsed"
                    if grew:
                        line += f" · +{size - last_size} B output"
                        last_size = size
                    print(line, file=sys.stderr, flush=True)
                    if grew and invocation.stream_mode != "off":
                        stream_offset = stream_new_lines(
                            log_path,
                            stream_offset,
                            invocation.stream_mode,
                        )

            # A run that finishes inside the first poll never reaches
            # the streaming branch above, and every run has a tail
            # written after its last poll, so the remainder is flushed
            # once the process is done. A timed-out run is excluded:
            # its diagnostics tail already prints the same bytes.
            if not timed_out and invocation.stream_mode != "off":
                stream_offset = stream_new_lines(
                    log_path, stream_offset, invocation.stream_mode
                )

            if timed_out:
                # Reported before the stop, so a wedged user bus or an
                # unstoppable unit cannot swallow the timeout message and
                # the Codex diagnostics along with the 124 status.
                elapsed_total = int(time.monotonic() - started)
                stalled_seconds = int(
                    final_growth_age
                    if final_growth_age is not None
                    else elapsed_total
                )
                print(
                    f"{display} timed out after {elapsed_total}s.",
                    file=sys.stderr,
                )
                diagnostics = tail_text(log_path)
                if diagnostics:
                    print(
                        "--- provider diagnostic output ---",
                        file=sys.stderr,
                    )
                    print(diagnostics, file=sys.stderr)

                # A stop that fails here must not turn the documented
                # timeout status into a generic failure: the `finally`
                # block retries the stop and reports a genuine cleanup
                # failure, so a transient one still exits 124.
                if use_systemd:
                    try:
                        stop_unit(unit)
                    except RuntimeError as exc:
                        print(f"{PROGRAM_NAME}: {exc}", file=sys.stderr)
                terminate_client(process)
                return handle_failed_attempt(
                    invocation,
                    state,
                    reason=(
                        f"{role_config.provider}/{role_config.model} timed out "
                        f"after {elapsed_total}s"
                    ),
                    status=124,
                    # A model that cannot finish inside the budget says
                    # nothing about the provider account, so only this
                    # model is excluded and the proposal ladder walks
                    # the same provider's nearest models first.
                    scope=FailureScope.MODEL,
                    diagnostics=diagnostics,
                    context_warning=not role_config.read_only,
                    require_rerun_after_inspection=(
                        workspace_requires_inspection()
                    ),
                    approval_required_status=124,
                    kind="timeout",
                    incident_fields={
                        "timeout_seconds": timeout_seconds,
                        "hard_timeout_seconds": hard_timeout_seconds,
                        "stalled_seconds": stalled_seconds,
                    },
                )

        if return_code != 0:
            print(
                f"{display} failed with exit status {return_code}.",
                file=sys.stderr,
            )
            diagnostics = tail_text(log_path)
            if diagnostics:
                print(
                    "--- provider diagnostic output ---",
                    file=sys.stderr,
                )
                print(diagnostics, file=sys.stderr)
            return handle_failed_attempt(
                invocation,
                state,
                reason=(
                    f"{role_config.provider}/{role_config.model} exited with "
                    f"status {return_code}"
                ),
                status=return_code,
                scope=classify_failure(diagnostics),
                diagnostics=diagnostics,
                context_warning=not role_config.read_only,
                require_rerun_after_inspection=(
                    workspace_requires_inspection()
                ),
                approval_required_status=return_code,
            )

        if role_config.provider == "anthropic":
            try:
                verdict = claude_verdict(log_path)
                verdict_path.write_text(verdict)
                verdict_path.chmod(0o600)
            except (OSError, ValueError) as exc:
                print(
                    "Claude exited successfully but produced no valid final "
                    f"result: {exc}",
                    file=sys.stderr,
                )
                diagnostics = tail_text(log_path)
                if diagnostics:
                    print(
                        "--- provider diagnostic output ---",
                        file=sys.stderr,
                    )
                    print(diagnostics, file=sys.stderr)
                return handle_failed_attempt(
                    invocation,
                    state,
                    reason=(
                        f"{role_config.provider}/{role_config.model} produced "
                        "no valid final result"
                    ),
                    status=1,
                    scope=classify_failure(diagnostics),
                    diagnostics=diagnostics,
                    context_warning=not role_config.read_only,
                    require_rerun_after_inspection=(
                        workspace_requires_inspection()
                    ),
                    approval_required_status=1,
                    kind="no-result",
                )

        if (
            not verdict_path.exists()
            or verdict_path.stat().st_size == 0
        ):
            print(
                f"{display} exited successfully but produced no final result.",
                file=sys.stderr,
            )
            diagnostics = tail_text(log_path)
            if diagnostics:
                print(
                    "--- provider diagnostic output ---",
                    file=sys.stderr,
                )
                print(diagnostics, file=sys.stderr)
            return handle_failed_attempt(
                invocation,
                state,
                reason=(
                    f"{role_config.provider}/{role_config.model} produced no "
                    "final result"
                ),
                status=1,
                scope=classify_failure(diagnostics),
                diagnostics=diagnostics,
                context_warning=not role_config.read_only,
                require_rerun_after_inspection=(
                    workspace_requires_inspection()
                ),
                approval_required_status=1,
                kind="no-result",
            )

        verdict = verdict_path.read_text(errors="replace")

        # A completed review is expensive and unrepeatable, so every
        # destination is attempted independently and a failure of one never
        # skips another. The run directory is removed in `finally`, so a
        # verdict that reached nowhere would be lost for good.
        printed = True
        try:
            if sys.stdout is None:
                # Python leaves sys.stdout as None when the descriptor was
                # closed before the process started, so this is an ordinary
                # invocation to survive rather than an internal error.
                raise OSError("stdout is closed")
            sys.stdout.write(verdict)
            if not verdict.endswith("\n"):
                sys.stdout.write("\n")
            sys.stdout.flush()
        except (OSError, ValueError, AttributeError) as exc:
            printed = False
            report(f"the verdict could not be printed: {exc}")
            incident_log.record(
                "output-failure",
                program=PROGRAM_NAME,
                role=state.role,
                detail=f"the verdict could not be printed: {exc}",
            )

        published: bool | None = None
        if output_path is not None:
            try:
                publish_atomically(verdict_path, output_path)
                published = True
            except OSError as exc:
                published = False
                report(
                    f"the verdict could not be written to {output_path}: {exc}"
                )
                incident_log.record(
                    "output-failure",
                    program=PROGRAM_NAME,
                    role=state.role,
                    detail=(
                        f"the verdict could not be written to "
                        f"{output_path}: {exc}"
                    ),
                )

        if not printed and not published:
            # Last resort, so that a review that reached neither stdout nor
            # its destination is still recoverable from the transcript.
            # Sanitised: this is provider text landing on stderr.
            report("--- recovered agent result ---")
            report(sanitise_provider_text(verdict))

        return 0 if printed and published is not False else 1
    except ReviewInterrupted as exc:
        print(
            f"{display} interrupted by signal {exc.signum}.",
            file=sys.stderr,
        )
        incident_log.record(
            "interrupted",
            program=PROGRAM_NAME,
            role=state.role,
            signal=exc.signum,
            status=128 + exc.signum,
        )
        return 128 + exc.signum
    except RuntimeError as exc:
        print(f"{PROGRAM_NAME}: {exc}", file=sys.stderr)
        incident_log.record(
            "runtime-error",
            program=PROGRAM_NAME,
            role=state.role,
            detail=str(exc),
            status=1,
        )
        return 1
    finally:
        signal.pthread_sigmask(signal.SIG_BLOCK, handled_signals)
        cleanup_errors: list[str] = []

        if unit_may_exist:
            try:
                stop_unit(unit)
            except RuntimeError as exc:
                unit_stopped = False
                cleanup_errors.append(str(exc))

        if process is not None:
            terminate_client(process)
            if not use_systemd:
                terminate_group(process)

        # Only once the provider tree is provably stopped; sweeping under
        # a live CLI would race its own graceful cleanup.
        # Published before the run directory is reclaimed, on every
        # path: a timed out or interrupted run is exactly when the
        # delegate's own working output is most worth keeping. A
        # failure here is reported, never fatal, because the log is a
        # diagnostic and not the run's product.
        if invocation.log_path is not None and published_log_path is not None:
            try:
                publish_atomically(published_log_path, invocation.log_path)
            except OSError as exc:
                report(
                    "the delegate log could not be written to "
                    f"{invocation.log_path}: {exc}"
                )
                incident_log.record(
                    "output-failure",
                    program=PROGRAM_NAME,
                    role=state.role if state is not None else None,
                    detail=f"the delegate log could not be published: {exc}",
                )

        if canary_snapshot is not None and unit_stopped:
            swept = sweep_claude_canaries(canary_snapshot)
            if swept:
                report(
                    "Removed Claude sandbox residue: " + ", ".join(swept)
                )
                incident_log.record(
                    "residue-swept",
                    program=PROGRAM_NAME,
                    role=state.role if state is not None else None,
                    detail=", ".join(swept),
                )

        if run_dir is not None:
            if unit_stopped:
                if not force_remove(run_dir):
                    cleanup_errors.append(
                        f"Could not remove agent runtime state: {run_dir}"
                    )
            else:
                # The service is detached under systemd, so the client
                # exiting does not prove the unit stopped. Removing its
                # temporary directory, log, and verdict path now could pull
                # them out from under a provider process that is still going. A
                # later sweep retries the stop and reclaims the state.
                cleanup_errors.append(
                    f"Agent runtime state kept for a later sweep: {run_dir}"
                )

        return_control()

        if cleanup_errors:
            incident_log.record(
                "cleanup-failure",
                program=PROGRAM_NAME,
                role=state.role if state is not None else None,
                detail="; ".join(cleanup_errors),
            )
            raise CleanupError("; ".join(cleanup_errors))


def entrypoint() -> int:
    invocation: Invocation | None = None
    state: DelegationState | None = None
    while True:
        try:
            return main(invocation, state)
        except NextAttempt as next_attempt:
            invocation = next_attempt.invocation
            state = next_attempt.state
            continue
        except CleanupError as exc:
            print(
                f"{PROGRAM_NAME} cleanup failed: {exc}",
                file=sys.stderr,
            )
            return 1


if __name__ == "__main__":
    raise SystemExit(entrypoint())
