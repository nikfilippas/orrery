  .arrow { text-align: center; color: var(--soft); font-size: 13px; }
  .step {
    background: var(--panel); border: 1px solid var(--edge);
    border-top: 3px solid var(--role, var(--accent)); padding: 14px 16px;
  }
  .workers { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; }
  .step h2 { font-size: 15.5px; margin: 0; display: flex; gap: 8px; align-items: baseline; }
  .badge {
    font-family: ui-monospace, monospace; font-size: 10.5px;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--role, var(--accent));
  }
  .summary { font-size: 13px; color: var(--soft); margin: 6px 0 10px; }
  .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  label { font-size: 12.5px; color: var(--soft); }
  select, input[type=text] {
    background: var(--ground); color: var(--ink);
    border: 1px solid var(--edge); padding: 5px 8px; font-size: 13.5px;
    font-family: ui-monospace, monospace; min-width: 200px;
  }
  .fixed { font-family: ui-monospace, monospace; font-size: 13px; }
  .note { font-size: 12px; color: var(--soft); margin-top: 8px; }
  .live { font-size: 12px; color: var(--soft); }
  .actions { margin: 26px 0 12px; display: flex; gap: 10px; }
  button {
    background: var(--accent); color: #fff; border: none;
    padding: 9px 18px; font-size: 14px; cursor: pointer;
  }
  button:disabled { opacity: 0.45; cursor: default; }
  button.secondary { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
  pre {
    background: var(--code); color: var(--code-ink); padding: 12px 14px;
    overflow-x: auto; font-size: 12.5px; line-height: 1.55;
  }
  .ok { color: var(--good); } .err { color: var(--bad); }
  #result h3 { font-size: 14px; margin: 18px 0 6px; }
  .scopenote {
    border-left: 3px solid var(--accent); padding: 8px 12px;
    font-size: 13px; color: var(--soft); margin: 20px 0;
  }
</style>
</head>
<body>
<div class="wrap">
  <h1>Órrery configuration</h1>
  <p class="sub">Generated from the live files under __KIT_DIR__. The page holds no knowledge of its own.</p>
  <div class="flow" id="flow"></div>
  <div class="scopenote">
    Saving changes the system-wide default for <strong>new sessions</strong>.
    Repositories pinned with <code>claude-codex-init &lt;alias&gt;</code> keep
    their pins, and running sessions are unaffected. Worker reasoning efforts
    define the roles and are shown, not editable.
  </div>
  <div class="actions">
    <button id="preview">Preview changes</button>
    <button id="apply" disabled>Apply</button>
    <button id="revert" class="secondary">Revert edits</button>
  </div>
  <div id="result"></div>
</div>
<script>
const STATE = __STATE__;
const TOKEN_PATH = __TOKEN_PATH__;
const original = {};
const flow = document.getElementById("flow");
const result = document.getElementById("result");
const applyButton = document.getElementById("apply");

function roleColour(id) {
  return { luna: "var(--luna)", terra: "var(--terra)", sol: "var(--sol)" }[id] || "var(--accent)";
}

function esc(text) {
  return String(text).replace(/&/g, "&amp;").replace(/</g, "&lt;")
    .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function stepBox(step) {
  const box = document.createElement("div");
  box.className = "step";
  box.style.setProperty("--role", roleColour(step.id));
  original[step.id] = step.model;
  const id = esc(step.id);
  let picker;
  if (step.choices) {
    const options = step.choices
      .map(c => `<option value="${esc(c.value)}" ${c.value === step.model ? "selected" : ""}>${esc(c.alias)} → ${esc(c.value)}</option>`)
      .join("");
    const custom = step.choices.some(c => c.value === step.model) ? "" : "selected";
    picker = `<select data-step="${id}" data-kind="select">${options}
      <option value="__custom__" ${custom}>custom…</option></select>
      <input type="text" data-step="${id}" data-kind="custom"
        value="${custom ? esc(step.model) : ""}" style="display:${custom ? "inline-block" : "none"}"
        placeholder="exact model identifier">`;
  } else {
    picker = `<input type="text" data-step="${id}" data-kind="model" value="${esc(step.model)}">`;
  }
  const effort = step.effort
    ? `<span class="fixed" title="Defined by the role">effort: ${esc(step.effort)} (fixed)</span>` : "";
  const live = step.live_model !== undefined
    ? `<div class="live">live default now: <code>${esc(step.live_model || "unset")}</code></div>` : "";
  box.innerHTML = `
    <h2>${esc(step.title)} <span class="badge">${esc(step.provider)}</span></h2>
    <p class="summary">${esc(step.summary)}</p>
    <div class="row"><label>model</label> ${picker} ${effort}</div>
    ${live}
    <p class="note">${esc(step.selects)} <code>${esc(step.file)}</code></p>`;
  return box;
}

function render() {
  const byId = Object.fromEntries(STATE.map(s => [s.id, s]));
  flow.appendChild(stepBox(byId.orchestrator));
  flow.insertAdjacentHTML("beforeend",
    '<div class="arrow">↓ classifies, plans, delegates bounded work ↓</div>');
  const workers = document.createElement("div");
  workers.className = "workers";
  ["luna", "terra", "sol"].forEach(id => byId[id] && workers.appendChild(stepBox(byId[id])));
  flow.appendChild(workers);
  STATE.filter(s => !["orchestrator", "luna", "terra", "sol"].includes(s.id))
    .forEach(s => flow.appendChild(stepBox(s)));
  flow.insertAdjacentHTML("beforeend",
    '<div class="arrow">↓ diff inspection · verification · independent review · nothing committed without approval ↓</div>');
}

function currentModel(id) {
  const select = document.querySelector(`select[data-step="${id}"]`);
  if (select) {
    if (select.value !== "__custom__") return select.value;
    return document.querySelector(`input[data-step="${id}"][data-kind="custom"]`).value.trim();
  }
  return document.querySelector(`input[data-step="${id}"]`).value.trim();
}

function changes() {
  const out = {};
  for (const id of Object.keys(original)) {
    const value = currentModel(id);
    if (value && value !== original[id]) out[id] = { model: value };
  }
  return out;
}

async function post(endpoint, body) {
  const response = await fetch(TOKEN_PATH + endpoint, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  return response.json();
}

document.addEventListener("change", event => {
  if (event.target.dataset && event.target.dataset.kind === "select") {
    const custom = document.querySelector(
      `input[data-step="${event.target.dataset.step}"][data-kind="custom"]`);
    if (custom) custom.style.display =
      event.target.value === "__custom__" ? "inline-block" : "none";
  }
  applyButton.disabled = true;
});

document.getElementById("preview").addEventListener("click", async () => {
  const body = changes();
  if (!Object.keys(body).length) {
    result.innerHTML = "<p>No changes to preview.</p>"; return;
  }
  const reply = await post("preview", body);
  if (reply.error) {
    result.innerHTML = `<p class="err">${esc(reply.error)}</p>`; return;
  }
  if (!reply.edits.length) {
    result.innerHTML = "<p>Everything already matches.</p>"; return;
  }
  result.innerHTML = "<h3>Exactly this will change:</h3>" +
    reply.edits.map(e => `<pre>${esc(e.diff)}</pre>`).join("");
  applyButton.disabled = false;
});

applyButton.addEventListener("click", async () => {
  applyButton.disabled = true;
  const reply = await post("apply", changes());
  if (reply.error) {
    result.innerHTML = `<p class="err">${esc(reply.error)}</p>`; return;
  }
  const doctor = reply.doctor_pass === null ? "" :
    `<h3>Doctor: <span class="${reply.doctor_pass ? "ok" : "err"}">` +
    `${reply.doctor_pass ? "READY" : "attention needed"}</span></h3>` +
    `<pre>${esc(reply.doctor_tail)}</pre>`;
  const propagated = reply.propagated ?
    `<h3>Propagated to live settings</h3><pre>${esc(reply.propagated.output)}</pre>` : "";
  result.innerHTML = `<h3 class="ok">Applied: ${esc(reply.applied.join(", "))}</h3>` +
    propagated + doctor +
    '<p class="note">Reload the page to edit further; the kit repository now holds these values, ready to commit.</p>';
});

document.getElementById("revert").addEventListener("click", () => location.reload());
render();
</script>
</body>
</html>
"""


def script_json(value: Any) -> str:
    """JSON safe to embed in a <script> element.

    JSON encoding alone does not escape `</script>`, so a value containing
    one would end the element and let the rest execute as markup. The
    characters that can start a tag or a comment are escaped instead.
    """
    return (
        json.dumps(value)
        .replace("<", "\\u003c")
        .replace(">", "\\u003e")
        .replace("&", "\\u0026")
        .replace(" ", "\\u2028")
        .replace(" ", "\\u2029")
    )


def escape_html(text: str) -> str:
    return (
        text.replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )


def render_page(token: str) -> str:
    return (
        PAGE_TEMPLATE
        .replace("__STATE__", script_json(snapshot()))
        .replace("__TOKEN_PATH__", script_json(f"/t/{token}/"))
        .replace("__KIT_DIR__", escape_html(str(KIT_DIR)))
    )


def print_state() -> int:
    for state in snapshot():
        effort = f" · effort {state['effort']}" if state.get("effort") else ""
        print(f"{state['title']:24} {state['provider']:10} "
              f"{state['model']}{effort}   [{state['file']}]")
    return 0


class Handler(BaseHTTPRequestHandler):
    token = ""
    lock = threading.Lock()
    last_activity = time.time()
    # The exact edit each file was last previewed with. An apply is only
    # honoured for the change its operator actually saw.
    previewed: dict[str, dict[str, str]] = {}

    def log_message(self, *arguments: Any) -> None:
        pass

    def touch(self) -> bool:
        # Authenticate first: unauthenticated traffic must never keep the
        # server alive past its idle timeout.
        prefix = f"/t/{Handler.token}/"
        if not secrets.compare_digest(self.path[: len(prefix)], prefix):
            self.send_error(404)
            return False
        Handler.last_activity = time.time()
        return True

    def endpoint(self) -> str:
        return self.path[len(f"/t/{Handler.token}/") :]

    def reply(self, payload: dict[str, Any], status: int = 200) -> None:
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        if not self.touch():
            return
        if self.endpoint() not in ("", "/"):
            self.send_error(404)
            return
        body = render_page(Handler.token).encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:
        if not self.touch():
            return
        try:
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                raise ConfigError("invalid Content-Length")
            # A request only ever carries a handful of short model names.
            if length < 0 or length > MAX_BODY_BYTES:
                raise ConfigError(
                    f"the request body may not exceed {MAX_BODY_BYTES} bytes"
                )
            changes = json.loads(self.rfile.read(length) or b"{}")
            if not isinstance(changes, dict):
                raise ConfigError("the request body must be a JSON object")

            if self.endpoint() == "preview":
                with Handler.lock:
                    edits = plan(changes)
                    for edit in edits:
                        Handler.previewed[edit["file"]] = {
                            "before": edit["before"],
                            "after": edit["after"],
                        }
                # The previous content is internal bookkeeping for the
                # apply-time check, not something the page needs.
                self.reply(
                    {
                        "edits": [
                            {key: value for key, value in edit.items()
                             if key != "before"}
                            for edit in edits
                        ]
                    }
                )
            elif self.endpoint() == "apply":
                with Handler.lock:
                    self.reply(apply_edits(plan(changes), Handler.previewed))
            else:
                self.send_error(404)
        except (ConfigError, json.JSONDecodeError, OSError) as exc:
            self.reply({"error": str(exc)}, status=400)


def serve(port: int, timeout: float, open_browser: bool) -> int:
    Handler.token = secrets.token_hex(12)
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{server.server_address[1]}/t/{Handler.token}/"

    def watch_idle() -> None:
        while True:
            time.sleep(1)
            if time.time() - Handler.last_activity > timeout:
                print("Idle timeout reached; exiting.", flush=True)
                server.shutdown()
                return

    threading.Thread(target=watch_idle, daemon=True).start()

    print(f"CONFIG_URL={url}", flush=True)
    print(
        f"Serving the configuration page at {url}\n"
        f"Bound to 127.0.0.1 only; exits after {int(timeout)}s idle "
        "or on Ctrl-C.",
        flush=True,
    )
    if open_browser:
        webbrowser.open(url)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("Interrupted; exiting.", flush=True)
    finally:
        server.server_close()
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Configure the Órrery orchestration visually."
    )
    parser.add_argument("--print", action="store_true", dest="print_state")
    parser.add_argument("--port", type=int, default=0)
    parser.add_argument("--timeout", type=float, default=600)
    parser.add_argument("--no-browser", action="store_true")
    arguments = parser.parse_args()

    try:
        if arguments.print_state:
            return print_state()
        return serve(
            arguments.port,
            arguments.timeout,
            open_browser=not arguments.no_browser,
        )
    except ConfigError as exc:
        print(f"claude-codex-config: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
