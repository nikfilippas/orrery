<script>
const STATE = __STATE__;
const CHART = __CHART__;
const TOKEN_PATH = __TOKEN_PATH__;
const roles = Object.fromEntries(STATE.map(s => [s.id, s]));
const original = Object.fromEntries(STATE.map(s => [s.id, s.model]));
const host = document.getElementById("chart");
const result = document.getElementById("result");
const applyButton = document.getElementById("apply");
const SVGNS = "http://www.w3.org/2000/svg";

const FILL = {
  orchestrator: ["#38617f", "#ffffff"], mechanic: ["#8891a8", "#ffffff"],
  implementer: ["#4f7047", "#ffffff"], "plan-reviewer": ["#7d5d90", "#ffffff"],
  reviewer: ["#a2711d", "#ffffff"], none: ["#e4e8eb", "#1b2226"],
};

function esc(text) {
  return String(text).replace(/&/g, "&amp;").replace(/</g, "&lt;")
    .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function element(name, attributes) {
  const node = document.createElementNS(SVGNS, name);
  for (const [key, value] of Object.entries(attributes)) node.setAttribute(key, value);
  return node;
}

function nodeInk(node) {
  const role = node.roles.length ? node.roles[node.roles.length - 1] : "none";
  return FILL[role] || FILL.none;
}

function stepsUsing(roleId) {
  return CHART.nodes.filter(n => n.roles.includes(roleId)).length;
}

function picker(step) {
  const id = esc(step.id);
  const options = (step.choices || []).map(c =>
    `<option value="${esc(c.id)}" ${c.id === step.model ? "selected" : ""}>` +
    `${esc(c.label)}</option>`).join("");
  const known = (step.choices || []).some(c => c.id === step.model);
  return `<div class="pick"><label>${esc(step.title)}</label>` +
    `<select data-step="${id}" data-kind="select">${options}` +
    `<option value="__custom__" ${known ? "" : "selected"}>custom…</option></select>` +
    `<input type="text" data-step="${id}" data-kind="custom" ` +
    `value="${known ? "" : esc(step.model)}" ` +
    `style="display:${known ? "none" : "block"}" ` +
    `placeholder="exact model identifier"></div>`;
}

function tip(node) {
  if (!node.roles.length) {
    return `<b>No model runs here.</b>${esc(node.note || "")}`;
  }
  return node.roles.map(id => {
    const step = roles[id];
    const count = stepsUsing(id);
    const shared = count > 1
      ? `Shared with ${count - 1} other step${count === 2 ? "" : "s"}: ` +
        `changing it here changes them too.`
      : "Used at this step only.";
    return `<b>${esc(step.title)}</b>${esc(step.summary)} ${shared}` +
      `<div class="meta">${step.profile ? "codex profile: " + esc(step.profile)
        : "claude code session model"}` +
      (step.effort ? ` · effort ${esc(step.effort)}, fixed` : "") +
      `<br>${esc(step.file)}</div>`;
  }).join('<div style="height:8px"></div>');
}

function render() {
  const canvas = document.createElement("div");
  canvas.className = "canvas";
  canvas.style.width = CHART.width + "px";
  canvas.style.height = CHART.height + "px";

  const svg = element("svg", {
    class: "wires", viewBox: `0 0 ${CHART.width} ${CHART.height}`,
    width: CHART.width, height: CHART.height,
  });
  const defs = element("defs", {});
  const marker = element("marker", {
    id: "arrow", viewBox: "0 0 8 8", refX: "7", refY: "4",
    markerWidth: "6", markerHeight: "6", orient: "auto-start-reverse",
  });
  marker.appendChild(element("path", { d: "M0,0 L8,4 L0,8 z", fill: "context-stroke" }));
  defs.appendChild(marker);
  svg.appendChild(defs);
  canvas.appendChild(svg);

  const marks = element("svg", {
    class: "marks", viewBox: `0 0 ${CHART.width} ${CHART.height}`,
    width: CHART.width, height: CHART.height,
  });
  canvas.appendChild(marks);

  for (const node of CHART.nodes) {
    const [fill, ink] = nodeInk(node);
    const box = document.createElement("div");
    box.className = "cnode" + (node.shape === "diamond" ? " diamond" : "");
    box.dataset.node = node.id;
    box.style.cssText =
      `left:${node.x - node.w / 2}px;top:${node.y - node.h / 2}px;` +
      `width:${node.w}px;min-height:${node.h}px;background:${fill};color:${ink}`;
    box.innerHTML =
      `<div class="title">${esc(node.label)}</div>` +
      (node.shape === "diamond" ? "" :
        `<button class="info" type="button" aria-label="About this step">&#128712;</button>` +
        `<div class="tip">${tip(node)}</div>`) +
      node.roles.map(id => picker(roles[id])).join("");
    box.addEventListener("mouseenter", () => highlight(node.id, node.roles));
    box.addEventListener("mouseleave", () => highlight(null, null));
    canvas.appendChild(box);
  }

  host.appendChild(canvas);
  drawWires(svg, marks, canvas);
  window.addEventListener("resize", () => drawWires(svg, marks, canvas));
}

function drawWires(svg, marks, canvas) {
  svg.querySelectorAll("path.edge").forEach(old => old.remove());
  marks.querySelectorAll("text").forEach(old => old.remove());
  const frame = canvas.getBoundingClientRect();
  const rect = id => {
    const element = canvas.querySelector(`[data-node="${id}"]`);
    if (!element) return null;
    const box = element.getBoundingClientRect();
    return {
      x: box.left + box.width / 2 - frame.left,
      y: box.top + box.height / 2 - frame.top,
      w: box.width, h: box.height,
      diamond: element.classList.contains("diamond"),
    };
  };

  const edge = (node, towards) => {
    const dx = towards.x - node.x;
    const dy = towards.y - node.y;
    if (!dx && !dy) return { x: node.x, y: node.y };
    const a = node.w / 2;
    const b = node.h / 2;
    const scale = node.diamond
      ? 1 / (Math.abs(dx) / a + Math.abs(dy) / b)
      : Math.min(Math.abs(dx) > 1e-6 ? a / Math.abs(dx) : Infinity,
                 Math.abs(dy) > 1e-6 ? b / Math.abs(dy) : Infinity);
    return { x: node.x + dx * scale, y: node.y + dy * scale };
  };

  const labels = [];
  for (const link of CHART.edges) {
    const a = rect(link.from);
    const b = rect(link.to);
    if (!a || !b) continue;
    const start = edge(a, b);
    const end = edge(b, a);
    const lift = Math.max(26, Math.abs(end.y - start.y) * 0.4);
    const way = end.y >= start.y ? 1 : -1;
    const c1 = { x: start.x, y: start.y + lift * way };
    const c2 = { x: end.x, y: end.y - lift * way };
    svg.appendChild(element("path", {
      class: "edge", "marker-end": "url(#arrow)",
      d: `M ${start.x} ${start.y} C ${c1.x} ${c1.y}, ${c2.x} ${c2.y}, ${end.x} ${end.y}`,
    }));
    if (link.label) {
      const t = 0.45;
      const at = (p0, p1, p2, p3) =>
        (1 - t) ** 3 * p0 + 3 * (1 - t) ** 2 * t * p1 +
        3 * (1 - t) * t ** 2 * p2 + t ** 3 * p3;
      const text = element("text", {
        x: at(start.x, c1.x, c2.x, end.x), y: at(start.y, c1.y, c2.y, end.y),
      });
      text.textContent = link.label;
      labels.push(text);
    }
  }
  labels.forEach(label => marks.appendChild(label));
}

function highlight(sourceId, active) {
  // An empty list of roles is still truthy, so a step that runs no model
  // must not be read as a request to highlight nothing at all.
  const chosen = active && active.length ? active : null;
  document.querySelectorAll(".cnode").forEach(box => {
    const node = CHART.nodes.find(n => n.id === box.dataset.node);
    const self = sourceId === node.id;
    const kin = Boolean(chosen && !self && node.roles.some(r => chosen.includes(r)));
    box.classList.toggle("self", self);
    box.classList.toggle("kin", kin);
    box.classList.toggle("dim", Boolean(chosen) && !self && !kin);
  });
}

// Several steps run one role, so every control for that role moves
// together; the change is visible rather than hidden.
function syncRole(roleId, value, source) {
  document.querySelectorAll(`select[data-step="${roleId}"]`).forEach(select => {
    if (select === source) return;
    const known = Array.from(select.options).some(o => o.value === value);
    select.value = known ? value : "__custom__";
    const custom = select.parentNode.querySelector('input[data-kind="custom"]');
    if (custom) {
      custom.style.display = known ? "none" : "block";
      if (!known) custom.value = value;
    }
  });
  document.querySelectorAll(`input[data-step="${roleId}"][data-kind="custom"]`)
    .forEach(input => { if (input !== source) input.value = value; });
}

function currentModel(id) {
  const select = document.querySelector(`select[data-step="${id}"]`);
  if (!select) return "";
  if (select.value !== "__custom__") return select.value;
  const custom = select.parentNode.querySelector('input[data-kind="custom"]');
  return custom ? custom.value.trim() : "";
}

function changes() {
  const out = {};
  for (const id of Object.keys(original)) {
    const value = currentModel(id);
    if (value && value !== original[id]) out[id] = { model: value };
  }
  return out;
}

async function post(endpoint, body) {
  const response = await fetch(TOKEN_PATH + endpoint, {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  return response.json();
}

document.addEventListener("input", event => {
  const step = event.target.dataset && event.target.dataset.step;
  if (step) syncRole(step, currentModel(step), event.target);
  applyButton.disabled = true;
});

document.addEventListener("change", event => {
  const data = event.target.dataset || {};
  if (data.kind === "select") {
    const custom = event.target.parentNode.querySelector('input[data-kind="custom"]');
    if (custom) custom.style.display = event.target.value === "__custom__" ? "block" : "none";
  }
  if (data.step) syncRole(data.step, currentModel(data.step), event.target);
  applyButton.disabled = true;
});

document.getElementById("preview").addEventListener("click", async () => {
  const body = changes();
  if (!Object.keys(body).length) {
    result.innerHTML = "<p>No changes to preview.</p>"; return;
  }
  const reply = await post("preview", body);
  if (reply.error) {
    result.innerHTML = `<p class="err">${esc(reply.error)}</p>`; return;
  }
  if (!reply.edits.length) {
    result.innerHTML = "<p>Everything already matches.</p>"; return;
  }
  result.innerHTML = "<h3>Exactly this will change:</h3>" +
    reply.edits.map(e => `<pre>${esc(e.diff)}</pre>`).join("");
  applyButton.disabled = false;
});

applyButton.addEventListener("click", async () => {
  applyButton.disabled = true;
  const reply = await post("apply", changes());
  if (reply.error) {
    result.innerHTML = `<p class="err">${esc(reply.error)}</p>`; return;
  }
  const doctor = reply.doctor_pass === null ? "" :
    `<h3>Doctor: <span class="${reply.doctor_pass ? "ok" : "err"}">` +
    `${reply.doctor_pass ? "READY" : "attention needed"}</span></h3>` +
    `<pre>${esc(reply.doctor_tail)}</pre>`;
  const propagated = reply.propagated ?
    `<h3>Propagated to live settings</h3><pre>${esc(reply.propagated.output)}</pre>` : "";
  result.innerHTML = `<h3 class="ok">Applied: ${esc(reply.applied.join(", "))}</h3>` +
    propagated + doctor +
    '<p class="note">Reload to edit further; the kit repository now holds these values, ready to commit.</p>';
});

document.getElementById("revert").addEventListener("click", () => location.reload());

render();
</script>
</body>
</html>
"""


def script_json(value: Any) -> str:
    """JSON safe to embed in a <script> element.

    JSON encoding alone does not escape `</script>`, so a value containing
    one would end the element and let the rest execute as markup. The
    characters that can start a tag or a comment are escaped instead.
    """
    return (
        json.dumps(value)
        .replace("<", "\\u003c")
        .replace(">", "\\u003e")
        .replace("&", "\\u0026")
        .replace(" ", "\\u2028")
        .replace(" ", "\\u2029")
    )


def escape_html(text: str) -> str:
    return (
        text.replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )


def display_path(path: Path) -> str:
    """A path as its owner would write it, home abbreviated."""
    try:
        return "~/" + str(path.relative_to(Path.home()))
    except ValueError:
        return str(path)


def render_page(token: str) -> str:
    return (
        PAGE_TEMPLATE
        .replace("__STATE__", script_json(snapshot()))
        .replace("__FLOW__", script_json(load_manifest().get("flow", [])))
        .replace("__CHART__", script_json(load_manifest().get("chart", {})))
        .replace("__TOKEN_PATH__", script_json(f"/t/{token}/"))
        .replace("__KIT_DIR__", escape_html(display_path(KIT_DIR)))
    )


def print_state() -> int:
    for state in snapshot():
        effort = f" · effort {state['effort']}" if state.get("effort") else ""
        print(f"{state['title']:24} {state['provider']:10} "
              f"{state['model']}{effort}   [{state['file']}]")
    return 0


class Handler(BaseHTTPRequestHandler):
    token = ""
    lock = threading.Lock()
    last_activity = time.time()
    # The exact edit each file was last previewed with. An apply is only
    # honoured for the change its operator actually saw.
    previewed: dict[str, dict[str, str]] = {}

    def log_message(self, *arguments: Any) -> None:
        pass

    def touch(self) -> bool:
        # Authenticate first: unauthenticated traffic must never keep the
        # server alive past its idle timeout.
        prefix = f"/t/{Handler.token}/"
        if not secrets.compare_digest(self.path[: len(prefix)], prefix):
            self.send_error(404)
            return False
        Handler.last_activity = time.time()
        return True

    def endpoint(self) -> str:
        return self.path[len(f"/t/{Handler.token}/") :]

    def reply(self, payload: dict[str, Any], status: int = 200) -> None:
        body = json.dumps(payload).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        if not self.touch():
            return
        if self.endpoint() not in ("", "/"):
            self.send_error(404)
            return
        body = render_page(Handler.token).encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self) -> None:
        if not self.touch():
            return
        try:
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                raise ConfigError("invalid Content-Length")
            # A request only ever carries a handful of short model names.
            if length < 0 or length > MAX_BODY_BYTES:
                raise ConfigError(
                    f"the request body may not exceed {MAX_BODY_BYTES} bytes"
                )
            changes = json.loads(self.rfile.read(length) or b"{}")
            if not isinstance(changes, dict):
                raise ConfigError("the request body must be a JSON object")

            if self.endpoint() == "preview":
                with Handler.lock:
                    edits = plan(changes)
                    for edit in edits:
                        Handler.previewed[edit["file"]] = {
                            "before": edit["before"],
                            "after": edit["after"],
                        }
                # The previous content is internal bookkeeping for the
                # apply-time check, not something the page needs.
                self.reply(
                    {
                        "edits": [
                            {key: value for key, value in edit.items()
                             if key != "before"}
                            for edit in edits
                        ]
                    }
                )
            elif self.endpoint() == "apply":
                with Handler.lock:
                    self.reply(apply_edits(plan(changes), Handler.previewed))
            else:
                self.send_error(404)
        except (ConfigError, json.JSONDecodeError, OSError) as exc:
            self.reply({"error": str(exc)}, status=400)


def serve(port: int, timeout: float, open_browser: bool) -> int:
    Handler.token = secrets.token_hex(12)
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{server.server_address[1]}/t/{Handler.token}/"

    def watch_idle() -> None:
        while True:
            time.sleep(1)
            if time.time() - Handler.last_activity > timeout:
                print("Idle timeout reached; exiting.", flush=True)
                server.shutdown()
                return

    threading.Thread(target=watch_idle, daemon=True).start()

    print(f"CONFIG_URL={url}", flush=True)
    print(
        f"Serving the configuration page at {url}\n"
        f"Bound to 127.0.0.1 only; exits after {int(timeout)}s idle "
        "or on Ctrl-C.",
        flush=True,
    )
    if open_browser:
        webbrowser.open(url)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("Interrupted; exiting.", flush=True)
    finally:
        server.server_close()
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Configure the Órrery orchestration visually."
    )
    parser.add_argument("--print", action="store_true", dest="print_state")
    parser.add_argument("--port", type=int, default=0)
    parser.add_argument("--timeout", type=float, default=600)
    parser.add_argument("--no-browser", action="store_true")
    arguments = parser.parse_args()

    try:
        if arguments.print_state:
            return print_state()
        return serve(
            arguments.port,
            arguments.timeout,
            open_browser=not arguments.no_browser,
        )
    except ConfigError as exc:
        print(f"claude-codex-config: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
