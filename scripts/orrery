#!/usr/bin/env python3
"""Start and supervise Orrery's configured principal orchestrator."""

from __future__ import annotations

import os
import signal
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


sys.path.insert(0, str(Path(__file__).resolve().parent))

from orrery_fallback import (  # noqa: E402
    APPROVAL_REQUIRED,
    Availability,
    Consent,
    ConsentDecision,
    git_workspace_fingerprint,
    model_status,
    nearest_fallback,
    parse_approval,
    proposal_for_approval,
    provider_status,
    request_fallback_decision,
)
from orrery_runtime import (  # noqa: E402
    Role,
    RuntimeConfigError,
    endpoint_environment,
    load_role,
    principal_command,
)
from orrery_standing import (  # noqa: E402
    RUN_SCOPE,
    candidate_role,
    describe,
    match,
    parse_approval_scope,
    record_approval,
    revoke_all,
)


@dataclass(frozen=True)
class Invocation:
    approval: tuple[str, str] | None
    no_fallback: bool
    provider_arguments: tuple[str, ...]
    approval_scope: tuple[str, float | None] | None = None
    revoke: bool = False


def usage() -> str:
    return (
        "Usage:\n"
        "  orrery [--approve-fallback PROVIDER:MODEL]\n"
        "          [--approval-scope run|session|until:ISO8601]\n"
        "          [--no-fallback] [-- PROVIDER-CLI-ARGUMENTS...]\n"
        "  orrery --revoke-fallbacks\n\n"
        "Starts and supervises the configured principal. If that provider or "
        "model cannot run, Orrery proposes the nearest potentially available "
        "model and requires explicit approval before substitution. "
        "Provider-specific arguments are not carried across providers.\n"
    )


def parse_args(argv: list[str]) -> Invocation:
    approval: tuple[str, str] | None = None
    no_fallback = False
    provider_arguments: list[str] = []
    approval_scope_raw: str | None = None
    revoke = False
    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument in ("--help", "-h"):
            print(usage(), end="")
            raise SystemExit(0)
        if argument == "--":
            provider_arguments = argv[index + 1 :]
            break
        if argument == "--approve-fallback":
            if index + 1 >= len(argv):
                raise RuntimeConfigError(
                    "missing value for --approve-fallback"
                )
            index += 1
            approval = parse_approval(argv[index])
        elif argument.startswith("--approve-fallback="):
            approval = parse_approval(argument.split("=", 1)[1])
        elif argument == "--approval-scope":
            if index + 1 >= len(argv):
                raise RuntimeConfigError(
                    "missing value for --approval-scope"
                )
            index += 1
            approval_scope_raw = argv[index]
        elif argument.startswith("--approval-scope="):
            approval_scope_raw = argument.split("=", 1)[1]
        elif argument == "--revoke-fallbacks":
            revoke = True
        elif argument == "--no-fallback":
            no_fallback = True
        else:
            # Backward compatibility: historically every unrecognised argument
            # belonged to the selected provider, without a `--` separator.
            provider_arguments = argv[index:]
            break
        index += 1
    if revoke:
        if (
            approval is not None
            or approval_scope_raw is not None
            or no_fallback
            or provider_arguments
        ):
            raise RuntimeConfigError(
                "--revoke-fallbacks stands alone and cannot be combined "
                "with other options"
            )
        return Invocation(
            approval=None,
            no_fallback=False,
            provider_arguments=(),
            revoke=True,
        )
    if no_fallback and approval is not None:
        raise RuntimeConfigError(
            "--no-fallback and --approve-fallback cannot be combined"
        )
    approval_scope: tuple[str, float | None] | None = None
    if approval_scope_raw is not None:
        if approval is None:
            raise RuntimeConfigError(
                "--approval-scope requires --approve-fallback"
            )
        approval_scope = parse_approval_scope(approval_scope_raw)
    return Invocation(
        approval=approval,
        no_fallback=no_fallback,
        provider_arguments=tuple(provider_arguments),
        approval_scope=approval_scope,
    )


def _record_standing(
    configured: Role,
    candidate: Role,
    decision: ConsentDecision,
    *,
    reason: str,
    failure_scope: str,
) -> None:
    if decision.scope == RUN_SCOPE:
        return
    try:
        record = record_approval(
            configured=configured,
            candidate=candidate,
            scope=decision.scope,
            expires_at=decision.expires_at,
            reason=reason,
            failure_scope=failure_scope,
        )
    except (RuntimeConfigError, OSError) as exc:
        print(
            f"orrery: the standing approval could not be recorded ({exc}); "
            "it applies to this run only.",
            file=sys.stderr,
        )
        return
    print(
        f"orrery: standing fallback recorded · {describe(record)}",
        file=sys.stderr,
    )


def _proposal_status(
    configured: Role,
    *,
    reason: str,
    excluded_providers: set[str],
    excluded_models: set[tuple[str, str]],
    invocation: Invocation,
    status: int,
    context_warning: bool,
    require_rerun_after_inspection: bool = False,
    approval_required_status: int | None = None,
    failure_scope: str = "provider",
) -> tuple[Role | None, int]:
    proposal = nearest_fallback(
        configured,
        reason,
        excluded_providers=excluded_providers,
        excluded_models=excluded_models,
    )
    if proposal is None:
        print(
            "orrery: no authenticated or potentially authenticated fallback "
            "candidate remains; no substitution was made.",
            file=sys.stderr,
        )
        return None, status
    decision = request_fallback_decision(
        proposal,
        approval=invocation.approval,
        no_fallback=invocation.no_fallback,
        program_name="orrery",
        original_status=status,
        context_warning=context_warning,
        require_rerun_after_inspection=require_rerun_after_inspection,
        approval_scope=invocation.approval_scope,
    )
    if decision.consent is Consent.APPROVED:
        _record_standing(
            configured,
            proposal.candidate,
            decision,
            reason=reason,
            failure_scope=failure_scope,
        )
        return proposal.candidate, status
    if decision.consent is Consent.REQUIRED:
        return None, (
            APPROVAL_REQUIRED
            if approval_required_status is None
            else approval_required_status
        )
    return None, status


def main() -> int:
    try:
        invocation = parse_args(sys.argv[1:])
    except RuntimeConfigError as exc:
        print(f"orrery: {exc}", file=sys.stderr)
        return 2

    if invocation.revoke:
        try:
            removed = revoke_all()
        except OSError as exc:
            print(
                "orrery: the standing-approval store could not be "
                f"cleared: {exc}",
                file=sys.stderr,
            )
            return 1
        if removed:
            for record in removed:
                print(f"revoked standing fallback · {describe(record)}")
        else:
            print("No standing fallback approvals.")
        return 0

    try:
        configured = load_role("orchestrator")
    except RuntimeConfigError as exc:
        print(f"orrery: {exc}", file=sys.stderr)
        return 2

    role = configured
    excluded_providers: set[str] = set()
    excluded_models: set[tuple[str, str]] = set()
    is_fallback = False

    if invocation.approval is not None:
        proposal, excluded_providers, excluded_models = proposal_for_approval(
            configured,
            invocation.approval,
        )
        if proposal is None:
            print(
                "orrery: the approved fallback is no longer a potentially "
                "available candidate; no process was started.",
                file=sys.stderr,
            )
            return APPROVAL_REQUIRED
        decision = request_fallback_decision(
            proposal,
            approval=invocation.approval,
            no_fallback=False,
            program_name="orrery",
            approval_scope=invocation.approval_scope,
        )
        if decision.consent is not Consent.APPROVED:
            return (
                APPROVAL_REQUIRED
                if decision.consent is Consent.REQUIRED
                else 2
            )
        _record_standing(
            configured,
            proposal.candidate,
            decision,
            reason=proposal.reason,
            failure_scope=(
                "model"
                if invocation.approval[0] == configured.provider
                else "provider"
            ),
        )
        role = proposal.candidate
        is_fallback = True
    elif invocation.no_fallback:
        if match(configured) is not None:
            print(
                "orrery: standing fallback approvals are ignored under "
                "--no-fallback.",
                file=sys.stderr,
            )
    else:
        record = match(configured)
        if record is not None:
            candidate = candidate_role(configured, record)
            availability = provider_status(candidate.provider)
            if availability.state is Availability.UNAVAILABLE:
                print(
                    "orrery: the standing fallback candidate is unavailable "
                    f"({availability.reason}); the configured principal "
                    "will be attempted.",
                    file=sys.stderr,
                )
            else:
                if record["failure_scope"] == "model":
                    excluded_models.add(
                        (record["failed_provider"], record["failed_model"])
                    )
                elif record["failure_scope"] == "provider":
                    excluded_providers.add(record["failed_provider"])
                role = candidate
                is_fallback = True
                print(
                    f"orrery: standing fallback active · {describe(record)}",
                    file=sys.stderr,
                )

    while True:
        availability = provider_status(role.provider)
        if availability.state is Availability.UNAVAILABLE:
            excluded_providers.add(role.provider)
            candidate, status = _proposal_status(
                configured,
                reason=availability.reason,
                excluded_providers=excluded_providers,
                excluded_models=excluded_models,
                invocation=invocation,
                status=2,
                context_warning=False,
                approval_required_status=APPROVAL_REQUIRED,
            )
            if candidate is None:
                return status
            role = candidate
            is_fallback = True
            continue
        if availability.state is Availability.UNKNOWN:
            print(
                f"orrery: warning: {availability.reason}; attempting the "
                "configured process.",
                file=sys.stderr,
            )
        elif availability.state is Availability.READY:
            visibility, visibility_reason = model_status(role, availability)
            if visibility is Availability.UNAVAILABLE:
                excluded_models.add((role.provider, role.model))
                candidate, status = _proposal_status(
                    configured,
                    reason=visibility_reason,
                    excluded_providers=excluded_providers,
                    excluded_models=excluded_models,
                    invocation=invocation,
                    status=2,
                    context_warning=False,
                    approval_required_status=APPROVAL_REQUIRED,
                    failure_scope="model",
                )
                if candidate is None:
                    return status
                role = candidate
                is_fallback = True
                continue

        extra = (
            list(invocation.provider_arguments)
            if role.provider == configured.provider
            else []
        )
        if (
            is_fallback
            and role.provider != configured.provider
            and invocation.provider_arguments
        ):
            print(
                "orrery: provider-specific arguments were omitted from the "
                "cross-provider fallback.",
                file=sys.stderr,
            )
        try:
            command = principal_command(role, extra)
        except RuntimeConfigError as exc:
            excluded_providers.add(role.provider)
            candidate, status = _proposal_status(
                configured,
                reason=str(exc),
                excluded_providers=excluded_providers,
                excluded_models=excluded_models,
                invocation=invocation,
                status=2,
                context_warning=False,
                approval_required_status=APPROVAL_REQUIRED,
            )
            if candidate is None:
                return status
            role = candidate
            is_fallback = True
            continue

        print(
            ("↳ Fallback principal" if is_fallback else "↳ Principal orchestrator")
            + f" · {role.provider} · {role.model}"
            + (f" · thinking {role.thinking}" if role.thinking else "")
            + (f" · via {role.endpoint.label}" if role.endpoint else ""),
            file=sys.stderr,
            flush=True,
        )
        # Marks the session as deliberately started through the launcher,
        # so the SessionStart hook applies the orchestration layer even in
        # a repository that has not been adopted with orrery-init.
        principal_environment = {**os.environ, "ORRERY_SESSION": "principal"}
        if role.endpoint is not None:
            try:
                principal_environment.update(
                    endpoint_environment(role.endpoint)
                )
            except RuntimeConfigError as exc:
                print(f"orrery: {exc}", file=sys.stderr)
                return 2
        workspace_before = git_workspace_fingerprint()
        try:
            result = subprocess.run(
                command,
                check=False,
                env=principal_environment,
            )
            return_code = result.returncode
        except KeyboardInterrupt:
            return 128 + signal.SIGINT
        except OSError as exc:
            print(f"orrery: principal process could not start: {exc}", file=sys.stderr)
            return_code = 127

        if return_code == 0:
            return 0
        if return_code < 0:
            signum = -return_code
            if signum in {signal.SIGINT, signal.SIGTERM, signal.SIGHUP}:
                return 128 + signum
        if return_code in {128 + signal.SIGINT, 128 + signal.SIGTERM}:
            return return_code

        excluded_providers.add(role.provider)
        workspace_after = git_workspace_fingerprint()
        candidate, status = _proposal_status(
            configured,
            reason=(
                f"{role.provider}/{role.model} exited with status "
                f"{return_code}; hidden quota, entitlement, model, or service "
                "failure is possible"
            ),
            excluded_providers=excluded_providers,
            excluded_models=excluded_models,
            invocation=invocation,
            status=return_code,
            context_warning=True,
            require_rerun_after_inspection=(
                workspace_before is None
                or workspace_after is None
                or workspace_before != workspace_after
            ),
            approval_required_status=return_code,
        )
        if candidate is None:
            return status
        role = candidate
        is_fallback = True


if __name__ == "__main__":
    raise SystemExit(main())
