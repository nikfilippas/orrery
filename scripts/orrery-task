LATER = frozenset()


def usage() -> int:
    print(
        "usage: orrery-task create|list|show|status|amend|run|verify|review|resume|merge|cancel|close", file=sys.stderr
    )
    return 2


def read_contract(path: str) -> dict:
    try:
        value = json.loads(Path(path).read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise LedgerError(f"contract file is unreadable: {path}") from exc
    if not isinstance(value, dict):
        raise LedgerError("$: must be an object")
    return value


# Git here is local plumbing, but it still blocks indefinitely on a held
# index.lock or a wedged filesystem, and a runner that waits forever is
# the failure mode the wrapper already refuses to have: it bounds every
# systemctl call and turns a hang into an error rather than a stall.
PLUMBING_TIMEOUT_SECONDS = 120
# A diff or a log that runs away must not become the whole prompt.
PACKET_TEXT_LIMIT = 200_000


def git(root: Path, *arguments: str, text: bool = True) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            ["git", "-C", str(root), *arguments],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=text,
            check=False,
            timeout=PLUMBING_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired as exc:
        raise LedgerError(
            f"git {' '.join(arguments)} did not finish within "
            f"{PLUMBING_TIMEOUT_SECONDS}s; the repository may be locked"
        ) from exc


def rel(root: Path, path: Path) -> str:
    return os.path.relpath(path, root)


def worktree_git_identity(worktree: Path, branch: str) -> str:
    """What must still be true before the runner runs git in a worktree.

    Not the common directory alone. A delegate can write a git directory
    of its own whose `commondir` names the expected one and whose HEAD
    names another branch, passing a common-directory check while
    redirecting commits and selecting its own hooks through
    `extensions.worktreeConfig`. The gitdir's own identity and the
    branch HEAD points at are therefore both part of the fingerprint,
    and an unanswerable git is an empty one rather than a pass.
    """
    parts = []
    for arguments in (
        ("rev-parse", "--path-format=absolute", "--git-common-dir"),
        ("rev-parse", "--path-format=absolute", "--absolute-git-dir"),
        ("symbolic-ref", "--quiet", "HEAD"),
    ):
        result = git(worktree, *arguments)
        if result.returncode:
            return ""
        parts.append(result.stdout.strip())
    if parts[-1] != f"refs/heads/{branch}":
        return ""
    return "|".join(parts)


def role_data(role: object) -> dict:
    endpoint = getattr(role, "endpoint", None)
    return {
        "id": role.id,
        "provider": role.provider,
        "model": role.model,
        "thinking": role.thinking,
        "endpoint": endpoint.id if endpoint else None,
    }


def handoff(contract: dict, facts: list[dict] | None = None) -> str:
    """The assignment a delegate is given.

    Facts are appended only when the caller has already selected them
    under the control lock. Absent them the text is byte-identical to
    what it was before memory existed, which is what makes a repository
    with no store behave exactly as it did.
    """
    scope = contract["scope"]
    criteria = "\n".join(
        f"- {entry['id']}: {entry['statement']}\n  Verify: {entry['verification']['command']}"
        for entry in contract["acceptance_criteria"]
    )
    text = (
        f"Goal:\n{contract['goal']}\n\nInclude: {scope['include']}\nExclude: {scope['exclude']}\n"
        "Changes outside the include set, or within the exclude set, will be rejected at merge.\n\n"
        f"Acceptance criteria:\n{criteria}\n\nDo not run git commit. Stop and report instead of improvising if judgement beyond the specification is required.\n"
    )
    block = orrery_memory.facts_block(facts or [])
    return f"{text}\n{block}\n" if block else text


def process_start_time(pid: int) -> int | None:
    try:
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        return int(fields[19])
    except (OSError, IndexError, ValueError):
        return None


def launch_alive(attempt: Path) -> bool:
    try:
        launch = json.loads((attempt.parent / "launch.json").read_text())
        pid, start = launch["controller_pid"], launch["controller_start"]
    except (OSError, KeyError, TypeError, json.JSONDecodeError):
        return False
    return isinstance(pid, int) and process_start_time(pid) == start


def parse_run_flags(flags: list[str]) -> tuple[bool, bool, list[str]]:
    local = {"--allow-dirty-baseline", "--accept-changed-worktree"}
    forwarded: list[str] = []
    index = 0
    while index < len(flags):
        flag = flags[index]
        if flag in local:
            index += 1
            continue
        if flag == "--no-fallback":
            forwarded.append(flag)
            index += 1
            continue
        if flag in {"--timeout", "--hard-timeout", "--approve-fallback", "--approval-scope"}:
            if index + 1 >= len(flags):
                raise LedgerError(f"invalid run argument: {flag}")
            forwarded.extend((flag, flags[index + 1]))
            index += 2
            continue
        if any(flag.startswith(prefix + "=") for prefix in ("--timeout", "--hard-timeout", "--approve-fallback", "--approval-scope")):
            forwarded.append(flag)
            index += 1
            continue
        raise LedgerError(f"invalid run argument: {flag}")
    return "--allow-dirty-baseline" in flags, "--accept-changed-worktree" in flags, forwarded


def current(store: Path, task_id: str) -> tuple[list[dict], str]:
    records, torn, _ = read_ledger(store, task_id)
    if torn:
        raise LedgerError("ledger has a torn tail; run status --repair")
    return records, records[-1]["to"]


def evidence_path(root: Path, task_id: str, sequence: int) -> Path:
    path = root / ".orrery" / "evidence"
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path, 0o700)
    return path / task_id / f"{sequence}.json"


def write_evidence(root: Path, task_id: str, sequence: int, data: dict) -> str:
    path = evidence_path(root, task_id, sequence)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    _atomic_write(
        path, (json.dumps(data, ensure_ascii=False, indent=2) + "\n").encode(), 0o600
    )
    return rel(root, path)


def evidence_digest(root: Path, proof: str) -> str:
    return hashlib.sha256((root / proof).read_bytes()).hexdigest()


def dispatch_alive(attempt: Path) -> bool:
    """Return whether the unit or process group recorded for an attempt lives."""
    try:
        unit = json.loads((attempt / "unit.json").read_text())
    except (OSError, json.JSONDecodeError):
        return False
    name = unit.get("unit")
    if name:
        return subprocess.run(
            ["systemctl", "--user", "is-active", str(name)], stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, check=False, timeout=20,
        ).returncode == 0
    pgid = unit.get("pgid")
    if not isinstance(pgid, int) or pgid <= 0:
        return False
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def receipt_failure(attempt: Path, returncode: int | None = None) -> str | None:
    receipt_path = attempt / "receipt.json"
    if not receipt_path.exists():
        # A timed-out attempt is a timeout even when the wrapper also
        # proposed a fallback on the way down: the reason carries the
        # attempt's terminal fact, and the proposal survives as
        # consent.txt beside it rather than by renaming the failure.
        if returncode == 124:
            return "timeout"
        # Written by the wrapper at its consent stop, into the receipts
        # directory's PARENT: the receipts dir is the delegate's own
        # writable grant, so a marker inside it could be forged by the
        # very process being classified. The exit code alone is
        # ambiguous, a post-attempt stop reuses the failed provider's
        # status and --no-fallback passes a provider's own 75 through,
        # so the marker decides, but only while no receipt exists. A
        # receipt means an attempt actually ran and failed, which is the
        # fact the reason must carry.
        if (attempt.parent / "consent-stop.json").exists():
            return "approval-required"
        # A marker-less 75 without a receipt is a consent stop whose
        # marker write failed. A provider's own 75 cannot land here,
        # because the launcher writes a receipt before propagating any
        # provider status.
        if returncode == 75:
            return "approval-required"
        if not (attempt / "unit.json").exists():
            return "spawn-failure"
        # The unit registered but no receipt landed: the launcher died
        # between spawn and write. Not the provider's own exit, which a
        # receipt would report below.
        return "receipt-missing"
    try:
        receipt = json.loads(receipt_path.read_text())
    except (OSError, ValueError):
        # The launcher writes the receipt to a temporary name and renames
        # it into place, so an unreadable receipt is a disk fault or
        # tampering, never a torn write.
        return "receipt-corrupt"
    if not isinstance(receipt, dict) or not isinstance(
        receipt.get("exit_status"), int
    ):
        return "receipt-corrupt"
    if receipt["exit_status"] != 0:
        return "provider-exit"
    result = attempt / "result.txt"
    if not result.exists() or not result.read_text().strip():
        try:
            for line in reversed((attempt / "stdout.log").read_text().splitlines()):
                value = json.loads(line)
                if isinstance(value, dict) and isinstance(value.get("result"), str):
                    _atomic_write(result, (value["result"] + "\n").encode(), 0o600)
                    return None
        except (OSError, json.JSONDecodeError):
            pass
        return "missing-result"
    return None


def verify(
    root: Path,
    store: Path,
    task_id: str,
    contract: dict,
    sequence: int,
    worktree: Path,
    base: str,
    commit: str,
    packet: dict,
    no_change: bool,
) -> int:
    outcomes = []
    failed = None
    for criterion in contract["acceptance_criteria"]:
        workdir = (worktree / criterion["verification"].get("workdir", "")).resolve()
        if workdir != worktree.resolve() and worktree.resolve() not in workdir.parents:
            failed = f"workdir {workdir} is outside the task worktree"
            outcomes.append({"criterion": criterion["id"], "command": criterion["verification"]["command"], "exit_status": 1, "duration_seconds": 0, "log": ""})
            break
        log = (
            root
            / ".orrery"
            / "evidence"
            / task_id
            / f"{sequence}-{criterion['id']}.log"
        )
        log.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        started = time.monotonic()
        command = criterion["verification"]["command"]
        status, output = run_verification(command, workdir)
        _atomic_write(
            log, output.encode() if isinstance(output, str) else output, 0o600
        )
        outcome = {
            "criterion": criterion["id"],
            "command": command,
            "exit_status": status,
            "duration_seconds": round(time.monotonic() - started, 3),
            "log": rel(root, log),
        }
        outcomes.append(outcome)
        clean = git(worktree, "status", "--porcelain").stdout == ""
        unchanged = git(worktree, "rev-parse", "HEAD").stdout.strip() == commit
        if not clean or not unchanged:
            failed = "verifier-mutated-tree"
            break
        if status != 0:
            failed = f"criterion {criterion['id']}"
            break
    packet["verification"] = outcomes
    proof = write_evidence(root, task_id, sequence, packet)
    proof_digest = evidence_digest(root, proof)
    with control_lock(root) as locked:
        records, state = current(locked, task_id)
        digest = records[-1]["contract_digest"]
        if no_change:
            append_record(locked, task_id, {
                "from": state, "to": "NO_CHANGE", "actor": "runner",
                "reason": "verification-passed" if not failed else f"verification-failed: {failed}",
                "contract_digest": digest, "evidence": proof,
                "evidence_sha256": proof_digest,
            })
            return 1 if failed else 0
        if failed:
            append_record(
                locked,
                task_id,
                {
                    "from": state,
                    "to": "VERIFICATION_FAILED",
                    "actor": "runner",
                    "reason": failed,
                    "contract_digest": digest,
                    "evidence": proof,
                    "evidence_sha256": proof_digest,
                },
            )
            return 1
        append_record(
            locked,
            task_id,
            {
                "from": state,
                "to": "VERIFICATION_PASSED",
                "actor": "runner",
                "contract_digest": digest,
                "evidence": proof,
                "evidence_sha256": proof_digest,
            },
        )
        # A contract that asked for review does not walk to the gate on
        # its own. Absent the key, Phase 1 behaviour is untouched.
        append_record(
            locked,
            task_id,
            {
                "from": "VERIFICATION_PASSED",
                "to": "IN_REVIEW" if contract.get("review") else "AWAITING_MERGE",
                "actor": "runner",
                "contract_digest": digest,
                "evidence": proof,
                "evidence_sha256": proof_digest,
            },
        )
    return 0


def complete_dispatch(
    root: Path, task_id: str, contract: dict, dispatch_record: dict,
    attempt: Path, worktree: Path, role: object, returncode: int,
    stderr_tail: list[str] | None = None,
) -> int:
    """Classify a completed receipt and record its commit and verification path."""
    store = root / ".orrery"
    # Before any git command runs here. A linked worktree's `.git` is a
    # file naming the git directory, the delegate can write it, and
    # containment cannot protect it: pinning it read-only would require
    # pinning the workspace, which the writer must be able to write. A
    # swapped indirection would make every command below use a git
    # directory of the delegate's choosing, and run its hooks as the
    # user. So the indirection is checked at the point of use, which
    # depends on no sandbox at all.
    expected = next(
        (
            record["git_identity"]
            for record in reversed(current(store, task_id)[0])
            if record.get("git_identity")
        ),
        None,
    )
    if expected:
        actual = worktree_git_identity(worktree, dispatch_record["dispatch"]["branch"])
        if actual != expected:
            raise LedgerError(
                f"task {task_id} worktree no longer matches the git "
                f"directory it was dispatched against ({actual} rather than "
                f"{expected}); its .git was replaced and no git command will "
                "be run there"
            )
    elif any(
        "git_identity" in record for record in current(store, task_id)[0]
    ):
        # Recorded but empty means the capture failed at dispatch. That
        # is not a licence to skip the check: a git that could not
        # answer then cannot vouch for the worktree now.
        raise LedgerError(
            f"task {task_id} recorded no git identity at dispatch, so its "
            "worktree cannot be shown to be the one that ran; re-dispatch it"
        )
    sequence = dispatch_record["dispatch"]["seq"]
    digest = dispatch_record["contract_digest"]
    base = dispatch_record["gate"]["base_head"]
    gate = dispatch_record["gate"]
    # Every provider-started attempt, not just the one that succeeded: a
    # transient retry and an approved fallback both spend, and counting
    # one would price the run at a fraction of its cost. Written into the
    # ledger too, so a ceiling can be enforced under the control lock
    # without re-reading receipts, and so a dispatch whose artefacts are
    # later reclaimed still says what it cost.
    attempt_records = orrery_spend.read_attempts(attempt)
    spend = orrery_spend.spend_of(attempt_records)
    reason = receipt_failure(attempt, returncode)
    if reason:
        partial = None
        if git(worktree, "status", "--porcelain").stdout:
            partial_path = attempt.parent / "partial.patch"
            _atomic_write(partial_path, git(worktree, "diff").stdout.encode(), 0o600)
            partial = rel(root, partial_path)
        consent = None
        awaiting_approval = (
            reason == "approval-required"
            or (attempt.parent / "consent-stop.json").exists()
        )
        if awaiting_approval and stderr_tail is not None:
            consent_path = attempt.parent / "consent.txt"
            _atomic_write(consent_path, "".join(stderr_tail).encode(), 0o600)
            consent = rel(root, consent_path)
        with control_lock(root) as locked:
            state = current(locked, task_id)[1]
            append_record(locked, task_id, {"from": state, "to": "DISPATCH_FAILED", "actor": "runner", "reason": reason, "attempt": 1, "contract_digest": digest, "worktree_fingerprint": git_workspace_fingerprint(worktree), "partial": partial, "consent": consent, "spend": spend})
        return returncode or 1
    changed = git(worktree, "status", "--porcelain").stdout != ""
    if changed:
        git(worktree, "add", "-A")
        # No role trailer: a reviewer runs `git log` unprompted, and the
        # implementer's identity is exactly what a blind review must not
        # have. The ledger records role_data for the dispatch, which is
        # where an audit should look.
        message = f"{task_id} {contract['title']} (dispatch {sequence})"
        committed = git(worktree, "-c", "user.name=Orrery", "-c", "user.email=orrery@localhost", "commit", "-m", message)
        if committed.returncode:
            raise LedgerError(committed.stderr.strip())
        commit, next_state = git(worktree, "rev-parse", "HEAD").stdout.strip(), "IMPLEMENTED"
    else:
        commit = git(worktree, "rev-parse", "HEAD").stdout.strip()
        next_state = "IMPLEMENTED" if commit != base else "NO_CHANGE"
    with control_lock(root) as locked:
        state = current(locked, task_id)[1]
        record = {"from": state, "to": next_state, "actor": "runner", "contract_digest": digest, "spend": spend}
        if next_state == "IMPLEMENTED":
            record["commit"] = commit
        implemented = next((entry for entry in reversed(current(locked, task_id)[0]) if entry.get("commit") == commit), None)
        if next_state != "IMPLEMENTED" or implemented is None:
            append_record(locked, task_id, record)
    receipt = json.loads((attempt / "receipt.json").read_text())
    diff = None
    if next_state == "IMPLEMENTED":
        patch = attempt.parent / "change.patch"
        _atomic_write(patch, git(worktree, "diff", f"{base}..{commit}").stdout.encode(), 0o600)
        lines = git(worktree, "diff", "--name-status", f"{base}..{commit}").stdout.splitlines()
        files = [{"path": x.split("\t", 1)[-1], "status": x.split("\t", 1)[0]} for x in lines]
        include, exclude = contract["scope"]["include"], contract["scope"]["exclude"]
        out = [x["path"] for x in files if not any(x["path"] == p or x["path"].startswith(p + "/") for p in include) or any(x["path"] == p or x["path"].startswith(p + "/") for p in exclude)]
        diff = {"files": files, "stat": git(worktree, "diff", "--stat", f"{base}..{commit}").stdout, "patch": rel(root, patch)}
    else:
        out = []
    packet = {"v": 1, "task_id": task_id, "dispatch_seq": sequence, "contract_digest": digest, "role": role_data(role), "gate": gate, "base_head": base, "commit": commit, "no_change": next_state == "NO_CHANGE", "attempts": attempt_entries(attempt, receipt), "diff": diff, "out_of_scope": out, "usage": spend, "worker_claim": (attempt / "result.txt").read_text()}
    return verify(root, store, task_id, contract, sequence, worktree, base, commit, packet, next_state == "NO_CHANGE")



class NamedEndpoint:
    def __init__(self, identifier: str) -> None:
        self.id = identifier


class RanRole:
    """The provider and model a completed attempt actually used.

    Resumption used to reload the contract's configured role, which is
    the wrong answer for any run that fell over to another provider: the
    ledger would name the model that was supposed to run rather than the
    one that did, and its spend would be priced against the wrong rate.
    Only the fields `role_data` reads are carried, because that is the
    only thing a completed dispatch does with a role.
    """

    def __init__(self, record: dict, role_id: str) -> None:
        self.id = role_id
        self.provider = record["provider"]
        self.model = record["model"]
        self.thinking = record.get("thinking")
        endpoint = record.get("endpoint")
        self.endpoint = NamedEndpoint(endpoint) if endpoint else None


def ran_role(attempt: Path, contract: dict, root: Path) -> object:
    records = orrery_spend.read_attempts(attempt)
    final = records[-1] if records else None
    if final and final.get("provider") and final.get("model"):
        return RanRole(final, final.get("role") or contract["assigned_role"])
    # A dispatch that predates the accounting has no record to read, so
    # the configured role remains the only available answer.
    return load_role(contract["assigned_role"], cwd=root)


def attempt_entries(attempt: Path, final_receipt: dict) -> list[dict]:
    """One packet entry per attempt directory, oldest first.

    The receipt carries the timings and stream sizes, the attempt record
    carries the identity and the usage, and they live in different files
    because one is written by the launcher inside the unit and the other
    by the wrapper outside it. Both are read from the same directory:
    scanning records and receipts separately and pairing them by
    position put one attempt's receipt against another attempt's run the
    moment either scan was short.
    """
    entries: list[dict] = []
    for index, directory in enumerate(orrery_spend.attempt_directories(attempt), 1):
        entry: dict = {"attempt": index}
        record = orrery_spend.read_attempt(directory)
        if record is not None:
            entry["run"] = record
        if directory == attempt:
            entry["receipt"] = final_receipt
        else:
            try:
                entry["receipt"] = json.loads((directory / "receipt.json").read_text())
            except (OSError, json.JSONDecodeError):
                pass
        entries.append(entry)
    return entries


def review_rounds_spend(attempt: Path) -> dict:
    """Both validation rounds of one review.

    An invalid first review is a paid run, and reading only the round
    that parsed would lose it. A review that produced nothing at all is
    the same case: it started a provider, so its record exists and its
    cost is unknown rather than absent.
    """
    return orrery_spend.spend_of(
        [
            record
            for directory in (attempt, attempt.with_name(f"{attempt.name}r"))
            for record in orrery_spend.read_attempts(directory)
        ]
    )


def take_override(flags: list[str]) -> str | None:
    """Remove `--override <reason>` from the forwarded flags, if present."""
    for index, flag in enumerate(list(flags)):
        if flag == "--override":
            if index + 1 >= len(flags) or flags[index + 1].startswith("-"):
                raise LedgerError('--override needs a reason: --override "<why>"')
            reason = flags[index + 1]
            del flags[index : index + 2]
            return reason
        if flag.startswith("--override="):
            reason = flag.split("=", 1)[1]
            if not reason.strip():
                raise LedgerError('--override needs a reason: --override "<why>"')
            del flags[index]
            return reason
    return None


def repeated_review(records: list[dict]) -> dict | None:
    """Two valid reviews of one commit that changed nothing.

    Keyed on the review records themselves, so a reviewer's reply that
    the schema refused is not a review and cannot count towards a stop,
    and advisory findings never do either. Any new commit gives the two
    reviews different anchors and clears the condition by construction.
    Reviews recorded before this phase carry no `unresolved` field and so
    can never trigger it.
    """
    reviews = [record["review"] for record in records if record.get("review")]
    if len(reviews) < 2:
        return None
    last, previous = reviews[-1], reviews[-2]
    unresolved = last.get("unresolved")
    if not unresolved or previous.get("unresolved") != unresolved:
        return None
    if not last.get("commit") or last.get("commit") != previous.get("commit"):
        return None
    return {"commit": last["commit"], "unresolved": list(unresolved)}


def blocking_ledger(records: list[dict]) -> tuple[dict[str, dict], set[str]]:
    """Every finding ever recorded blocking, and those since resolved.

    The gate reads this rather than a review's verdict. Anchoring on the
    latest verdict would let one rework round shed a finding: a blind
    second reviewer is never told the first objection existed, returns
    clean, and the task merges with nothing resolved.
    """
    raised: dict[str, dict] = {}
    resolved: set[str] = set()
    for record in records:
        review = record.get("review")
        if review:
            for finding in review.get("blocking", []):
                raised.setdefault(finding["id"], finding)
        for entry in record.get("resolutions", []):
            resolved.add(entry["id"])
    return raised, resolved


def unresolved_blocking(records: list[dict]) -> list[dict]:
    raised, resolved = blocking_ledger(records)
    return [finding for key, finding in raised.items() if key not in resolved]


def review_packet(root: Path, records: list[dict], contract: dict, carried: list[dict]) -> dict:
    """What the reviewer is given, and nothing else.

    The evidence packet holds `worker_claim`, the delegate's own account
    of what it did. That is precisely what a blind review must not read,
    so the packet is rebuilt rather than forwarded, and the reviewer runs
    in the task worktree where `.orrery` is not present at all.
    """
    verified = next(r for r in reversed(records) if r.get("to") == "VERIFICATION_PASSED")
    # The ledger stores the evidence as a repository-relative path, and
    # the packet is the file it names, exactly as the merge gate reads it.
    evidence = json.loads((root / verified["evidence"]).read_text())

    def inlined(relative: str | None) -> str:
        """Content, not a path.

        The reviewer works in the task worktree, where `.orrery` does not
        exist, so a packet that referenced these files would point at
        nothing. Inlining also keeps the reviewer from having to reach
        outside its workspace to do its job at all.
        """
        if not relative:
            return ""
        try:
            text = (root / relative).read_text(errors="replace")
        except OSError:
            return ""
        if len(text) > PACKET_TEXT_LIMIT:
            return (
                text[:PACKET_TEXT_LIMIT]
                + f"\n[truncated at {PACKET_TEXT_LIMIT} characters]\n"
            )
        return text

    diff = dict(evidence["diff"])
    diff["patch"] = inlined(diff.pop("patch", None))
    verification = [
        {**entry, "log": inlined(entry.get("log"))}
        for entry in evidence.get("verification", [])
    ]
    return {
        "v": 1,
        "task_id": contract["task_id"],
        "title": contract["title"],
        "goal": contract["goal"],
        "acceptance_criteria": contract["acceptance_criteria"],
        "scope": contract["scope"],
        "commit": evidence["commit"],
        "base_head": evidence["base_head"],
        "diff": diff,
        "verification": verification,
        "out_of_scope": evidence.get("out_of_scope", []),
        "carried_findings": carried,
    }


def reviewable_path(worktree: Path, candidate: str) -> bool:
    """Whether evidence names a regular file inside the reviewed tree.

    Path.exists alone accepted directories, absolute paths (an absolute
    right-hand side wins the join outright) and `..` escapes, so "." or
    "/etc/passwd" satisfied the blocking-evidence discipline. Anything
    that is not a regular file under the worktree is a claim about
    something the reviewer did not read there.
    """
    if Path(candidate).is_absolute():
        return False
    resolved = (worktree / candidate).resolve()
    anchor = worktree.resolve()
    if anchor not in resolved.parents:
        return False
    return resolved.is_file()


def review_receipts_dir(root: Path, task_id: str, name: str) -> Path:
    """A delegate-writable receipts home outside every read-only mapping.

    A read-only review maps the workspace, the common git dir and every
    worktree of the repository read-only, and the composition refuses a
    writable grant nested inside any of them, so receipts cannot live
    under `.orrery` in the repository root. They live beside the task
    worktrees under the state home instead, and the runner copies the
    durable artefacts into `.orrery/reviews` after the run.
    """
    state_home = Path(
        os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))
    )
    return (
        state_home / "orrery" / "review-receipts"
        / repo_identity(root) / task_id / name
    )


def harvest_receipts(storage: Path, receipts: Path) -> None:
    """Copy a review run's artefacts into durable storage, then drop the
    state-home directory. A crash between the run and this copy leaves
    the receipts at the state home rather than losing them.

    The receipts directory is delegate-writable by design, so the
    harvest takes only the wrapper's own artefact names and never
    overwrites a file the runner already wrote: a reviewer that plants
    schema.json or packet.json in its receipts must not falsify the
    durable packet or steer its own retry.
    """
    if not receipts.exists():
        return
    for name in orrery_spend.ATTEMPT_ARTEFACTS:
        entry = receipts / name
        target = storage / name
        if not entry.is_file() or entry.is_symlink() or target.exists():
            continue
        _atomic_write(target, entry.read_bytes(), 0o600)
    # Superseded attempts travel too, or a retry's cost would be lost at
    # exactly the moment the run that spent it is being accounted for.
    prior = receipts / "prior"
    if prior.is_dir() and not prior.is_symlink():
        for round_dir in sorted(prior.iterdir()):
            if not round_dir.is_dir() or round_dir.is_symlink():
                continue
            for name in orrery_spend.ATTEMPT_ARTEFACTS:
                entry = round_dir / name
                target = storage / "prior" / round_dir.name / name
                if not entry.is_file() or entry.is_symlink() or target.exists():
                    continue
                target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                _atomic_write(target, entry.read_bytes(), 0o600)
    shutil.rmtree(receipts, ignore_errors=True)
    if receipts.exists():
        print(
            f"orrery-task: review receipts not fully removed: {receipts}",
            file=sys.stderr,
        )



# A task owns its declared scope from admission until it reaches a
# terminal state. Reusing the old busy set would leak it: successful work
# leaves DISPATCHED/IN_PROGRESS/IN_REVIEW immediately, while an unmerged
# branch still touches every path in its scope, so an overlapping task
# admitted then is forced into exactly the conflict admission exists to
# prevent, discovered only at its merge.
TERMINAL = frozenset({"MERGED", "CLOSED", "CANCELLED"})


def holds_scope(records: list[dict], state: str) -> bool:
    """Whether this task still claims its files.

    Read from history rather than from the current state: a retry moves an
    already-dispatched task back to READY, and a state-based rule would
    drop its reservation there while its branch still touches every path
    it declared.
    """
    if state in TERMINAL:
        return False
    return any(record.get("to") == "DISPATCHED" for record in records)


def normalise_scope(path: str) -> str:
    """A scope entry reduced to the form the overlap test compares."""
    cleaned = os.path.normpath(path.strip())
    return "" if cleaned in {".", "/", ""} else cleaned.lstrip("./")


def paths_overlap(one: str, other: str) -> bool:
    """Whether two repository-relative paths claim any file in common.

    The empty string is the repository root, which normalisation produces
    from "." and which overlaps everything: a scope declared over the
    whole tree must not silently overlap nothing.
    """
    first, second = normalise_scope(one), normalise_scope(other)
    if first == "" or second == "":
        return True
    return (
        first == second
        or first.startswith(second + "/")
        or second.startswith(first + "/")
    )


def scope_holders(store: Path, task_id: str) -> list[tuple[str, str, list[str]]]:
    """Every other task holding scope, with its state and include set."""
    holders: list[tuple[str, str, list[str]]] = []
    for other in task_ids(store):
        if other == task_id:
            continue
        try:
            records, state = current(store, other)
        except LedgerError as exc:
            raise LedgerError(
                f"cannot tell whether {other} holds scope: {exc}"
            ) from exc
        if not holds_scope(records, state):
            continue
        try:
            contract = load_contract(store, other)
        except LedgerError as exc:
            raise LedgerError(
                f"cannot read {other}'s scope while it still holds one: {exc}"
            ) from exc
        holders.append((other, state, list(contract["scope"]["include"])))
    return holders


def scope_conflict(store: Path, task_id: str, include: list[str]) -> str | None:
    """The first overlap with a scope-holding task, described, or None."""
    for other, state, held in scope_holders(store, task_id):
        for mine in include:
            for theirs in held:
                if paths_overlap(mine, theirs):
                    return (
                        f"scope {mine} overlaps {theirs}, held by {other} "
                        f"which is {state}"
                    )
    return None


def dependency_conflict(
    root: Path, store: Path, contract: dict, base: str
) -> str | None:
    """Why a declared dependency is not yet satisfied, or None.

    A dependency is a code dependency, not a status. Its merge commit must
    already be an ancestor of the base this task will branch from, on the
    same target: a dependency MERGED onto another ref proves nothing about
    this task's code.
    """
    for dependency in contract.get("depends_on", []):
        try:
            records, state = current(store, dependency)
        except LedgerError:
            return f"dependency {dependency} has no readable ledger"
        if state == "CANCELLED":
            return f"dependency {dependency} was cancelled"
        if state not in {"MERGED", "CLOSED"}:
            return f"dependency {dependency} is {state}, not merged"
        try:
            theirs = load_contract(store, dependency)
        except LedgerError:
            return f"dependency {dependency} has no readable contract"
        if theirs.get("target_ref") != contract.get("target_ref"):
            return (
                f"dependency {dependency} targets {theirs.get('target_ref')}, "
                f"not {contract.get('target_ref')}"
            )
        merged = next(
            (r.get("merge_commit") for r in reversed(records) if r.get("to") == "MERGED"),
            None,
        )
        if not merged:
            return f"dependency {dependency} records no merge commit"
        if not is_ancestor(root, merged, base):
            return (
                f"dependency {dependency} merged as {merged[:12]}, which is not "
                f"an ancestor of the base {base[:12]}"
            )
    return None

def review_task(root: Path, task_id: str, flags: list[str]) -> int:
    """Dispatch one blind review and record what it found.

    The reviewer runs in the task worktree, so `.orrery` is simply not
    there: it is kept untracked, and an untracked path does not exist in
    a linked worktree. That is the mechanism, and it works for either
    provider; the Claude deny list is only defence in depth.
    """
    store = root / ".orrery"
    records, state = current(store, task_id)
    if state not in {"IN_REVIEW", "REVIEW_BLOCKED", "INTERRUPTED"}:
        raise LedgerError(f"task {task_id} is {state}")
    if state == "INTERRUPTED":
        # A review that failed recorded INTERRUPTED, and this command
        # then refused the state it had just created, so the task was
        # stranded: `run` sends the operator here and here sent them
        # nowhere. Resuming a review as a review is what the transition
        # exists for.
        interrupted = next(
            (record for record in reversed(records) if record.get("to") == "INTERRUPTED"),
            None,
        )
        if (interrupted or {}).get("phase") != "review":
            raise LedgerError(
                f"task {task_id} was interrupted outside review; use resume"
            )
        with control_lock(root) as locked:
            append_record(locked, task_id, {
                "from": "INTERRUPTED", "to": "IN_REVIEW", "actor": "user",
                "reason": "review-retry",
                "contract_digest": records[-1]["contract_digest"],
            })
        records, state = current(store, task_id)
    contract = load_contract(store, task_id)
    digest = records[-1]["contract_digest"]
    worktree = worktree_path(root, task_id)
    if not worktree.exists():
        raise LedgerError("task worktree is missing; resume or re-run the task")
    carried = unresolved_blocking(records)
    carried_ids = [finding["id"] for finding in carried]
    # Taken out of the forwarded flags: everything left in `flags` goes
    # to the wrapper, which knows nothing about this option.
    override = take_override(flags)
    stuck = repeated_review(records)
    if stuck and override is None:
        detail = (
            f"two reviews of commit {stuck['commit'][:12]} left the same "
            "findings open (" + ", ".join(stuck["unresolved"]) + ")"
        )
        # Recorded before it is raised, like every other guard: a refusal
        # that exists only on stderr is invisible to the next reader of
        # the ledger, which is the only durable account of the task.
        with control_lock(root) as locked:
            state_now = current(locked, task_id)[1]
            append_record(locked, task_id, {
                "from": state_now, "to": state_now, "actor": "user",
                "reason": "REFUSED", "contract_digest": digest,
                "decision": {
                    "guard": "repeated-review",
                    "detail": detail,
                    "counters": {
                        "commit": stuck["commit"],
                        "unresolved": stuck["unresolved"],
                        "reviews": sum(1 for r in records if r.get("review")),
                    },
                    "blocked_by": None,
                },
            })
        raise LedgerError(
            f"task {task_id} is not making progress: {detail}; rework the "
            'task, or repeat with --override "<reason>"'
        )
    if stuck:
        reason = override
        with control_lock(root) as locked:
            append_record(locked, task_id, {
                "from": current(locked, task_id)[1],
                "to": current(locked, task_id)[1],
                "actor": "user",
                "reason": "LOOP_OVERRIDE",
                "contract_digest": digest,
                "override": {
                    "commit": stuck["commit"],
                    "unresolved": stuck["unresolved"],
                    "detail": orrery_findings.sanitise_provider_text(reason),
                },
            })
        records, state = current(store, task_id)
    role = load_role("reviewer")
    sequence = 1 + sum(1 for record in records if record.get("review"))
    # A review whose record never landed would otherwise collide with its
    # own leftover directory, and the wrapper's O_EXCL receipt turns that
    # into a confusing "File exists" rather than a fresh attempt.
    while (store / "reviews" / task_id / str(sequence)).exists():
        sequence += 1

    reviews = store / "reviews" / task_id
    reviews.mkdir(parents=True, exist_ok=True)
    attempt = reviews / f"{sequence}"
    attempt.mkdir(exist_ok=True)
    schema_path = attempt / "schema.json"
    _atomic_write(
        schema_path,
        (json.dumps(orrery_findings.review_schema(carried_ids), indent=2) + "\n").encode(),
        0o600,
    )
    packet = review_packet(root, records, contract, carried)
    packet_path = attempt / "packet.json"
    _atomic_write(packet_path, (json.dumps(packet, indent=2) + "\n").encode(), 0o600)

    def command_for(attempt_dir: Path) -> list[str]:
        return [
            sys.executable,
            str(Path(__file__).with_name("orrery-review")),
            "--role", role.id,
            "--workspace", str(worktree),
            "--receipts", str(attempt_dir),
            "--schema", str(schema_path),
        ]
    prompt = REVIEW_PROMPT.format(
        task_id=task_id, packet=packet_path.read_text(),
    )
    # No timeout here on purpose, matching the implementation dispatch: the
    # wrapper owns the budget. It applies the reviewer role's manifest
    # timeouts, extends them only while the delegate is still producing
    # output, and backs the whole thing with RuntimeMaxSec on the unit, so
    # a second deadline here would either duplicate that or cut a live
    # review short.
    def dispatch_review(receipts_dir: Path, assignment: str) -> Path | None:
        """Run one reviewer and return its document, or None if it gave none."""
        process = subprocess.run(
            command_for(receipts_dir) + flags + ["--", assignment],
            cwd=worktree, check=False,
        )
        produced = receipts_dir / "result.txt"
        if process.returncode != 0 or not produced.exists():
            return None
        return produced if produced.read_text().strip() else None


    # A crashed review leaves its receipts at the state home; reclaim
    # them before dispatching so a paid run's artefacts are not lost and
    # nothing readable lingers. Reclamation follows the harvest rules;
    # an orphan with no matching storage directory is removed.
    orphans_root = review_receipts_dir(root, task_id, "orphan").parent
    if orphans_root.exists():
        for orphan in sorted(orphans_root.iterdir()):
            if not orphan.is_dir():
                continue
            storage_dir = reviews / orphan.name
            if storage_dir.is_dir():
                harvest_receipts(storage_dir, orphan)
            else:
                shutil.rmtree(orphan, ignore_errors=True)

    accepted = None
    validation_error = None
    # One retry, carrying the exact validation error back. A reviewer that
    # returned a real judgement in a shape the schema refuses should get
    # the chance to say the same thing correctly, rather than the whole
    # review being thrown away and the operator left to notice. A second
    # failure is reported rather than retried again: repeating it costs
    # another delegated run and the fault is unlikely to be transient.
    for round_number in (1, 2):
        this_attempt = attempt if round_number == 1 else attempt.with_name(
            f"{attempt.name}r"
        )
        this_attempt.mkdir(exist_ok=True)
        this_receipts = review_receipts_dir(root, task_id, this_attempt.name)
        this_receipts.mkdir(mode=0o700, parents=True, exist_ok=True)
        assignment = prompt if validation_error is None else (
            prompt
            + "\n\nYour previous reply was refused by the schema validator:\n"
            + validation_error
            + "\nReturn the same judgement in a document that conforms.\n"
        )
        produced = dispatch_review(this_receipts, assignment)
        harvest_receipts(this_attempt, this_receipts)
        if produced is None:
            with control_lock(root) as locked:
                append_record(locked, task_id, {
                    "from": current(locked, task_id)[1], "to": "INTERRUPTED",
                    "actor": "runner", "reason": "review-missing-result",
                    "phase": "review", "contract_digest": digest,
                    "spend": review_rounds_spend(attempt),
                    # Named, so the spend is attributed to the reviewer
                    # rather than to whichever implementer ran last.
                    "review": {"seq": sequence, "verdict": "no-result",
                               **role_data(role)},
                })
            raise LedgerError("the reviewer returned no usable document")
        try:
            document = orrery_findings.parse_review(
                (this_attempt / "result.txt").read_text()
            )
            accepted = orrery_findings.validate_review(
                document, task_id=task_id, carried_ids=carried_ids,
                path_exists=lambda candidate: reviewable_path(worktree, candidate),
            )
            break
        except orrery_findings.FindingsError as exc:
            validation_error = str(exc)
            if round_number == 2:
                with control_lock(root) as locked:
                    append_record(locked, task_id, {
                        "from": current(locked, task_id)[1], "to": "INTERRUPTED",
                        "actor": "runner", "reason": "review-invalid",
                        "phase": "review", "contract_digest": digest,
                        "spend": review_rounds_spend(attempt),
                        "review": {"seq": sequence, "verdict": "invalid",
                                   **role_data(role)},
                    })
                raise LedgerError(
                    f"the review did not validate after one retry: {exc}"
                ) from exc

    stored = accepted["document"]
    _atomic_write(
        attempt / "review.json",
        (json.dumps(stored, indent=2, sort_keys=True) + "\n").encode(),
        0o600,
    )
    review_sha = hashlib.sha256(
        json.dumps(stored, sort_keys=True).encode()
    ).hexdigest()
    blocking = [
        {"id": f["id"], "statement": f["statement"], "category": f["category"]}
        for f in stored["findings"] if f["severity"] == "blocking"
    ]
    resolutions = [
        {"id": entry["id"],
         "disposition": "fixed" if entry["disposition"] == "resolved" else "withdrawn"}
        for entry in stored.get("carried", [])
        if entry["disposition"] in {"resolved", "withdrawn"}
    ]
    # Still-present carried findings count as much as new ones. Reading
    # only this review's findings would pass a task whose earlier
    # objection the reviewer had just confirmed was still there.
    still_present = [
        entry["id"] for entry in stored.get("carried", [])
        if entry["disposition"] == "still_present"
    ]
    # What is still open once this review is counted, stored so the
    # unproductive-loop stop can compare two reviews directly instead of
    # replaying the ledger prefix that produced each of them.
    projected = sorted(
        (
            {finding["id"] for finding in unresolved_blocking(records)}
            | {finding["id"] for finding in blocking}
        )
        - {entry["id"] for entry in resolutions}
    )
    review_spend = review_rounds_spend(attempt)
    with control_lock(root) as locked:
        append_record(locked, task_id, {
            "from": current(locked, task_id)[1],
            "to": "REVIEW_BLOCKED" if blocking or still_present else "REVIEW_PASSED",
            "actor": "runner",
            "contract_digest": digest,
            "spend": review_spend,
            "review": {
                "seq": sequence, "sha256": review_sha,
                "verdict": stored["verdict"], "blocking": blocking,
                "advisory": sum(
                    1 for f in stored["findings"] if f["severity"] == "advisory"
                ),
                "downgrades": accepted["downgrades"],
                "commit": packet["commit"],
                "unresolved": projected,
                **role_data(role),
            },
            "resolutions": resolutions,
        })
    print(orrery_findings.render_review(stored))
    remaining = unresolved_blocking(current(store, task_id)[0])
    return 1 if remaining else 0


REVIEW_PROMPT = """You are reviewing one bounded change. You have the contract, the diff, and
the repository at the reviewed commit. You do not have, and must not seek,
the implementer's account of its own work.

Return only a JSON document conforming to the schema you were given.
Every blocking finding needs evidence: a file and line range in this
worktree, or a command that reproduces the defect. A finding you cannot
evidence is advisory. Record anything you could not check in
unable_to_verify rather than leaving it unsaid.

Review packet for {task_id}:
{packet}
"""

def dispatch(root: Path, task_id: str, flags: list[str]) -> int:
    allow_dirty, accept_changed, forwarded = parse_run_flags(flags)
    store = root / ".orrery"
    tracked = git(root, "ls-files", ".orrery").stdout.strip()
    if tracked:
        raise LedgerError("the .orrery ledger must not be tracked")
    records, state = current(store, task_id)
    if state == "INTERRUPTED":
        # Which phase was interrupted decides how it resumes. Without
        # this the retry below sends an interrupted REVIEW to READY, and
        # dispatch re-runs contract["assigned_role"], which is
        # write-capable: a dead reviewer would implement a second time
        # over already verified work.
        interrupted = next(
            (r for r in reversed(records) if r.get("to") == "INTERRUPTED"), None
        )
        if interrupted and interrupted.get("phase") == "review":
            raise LedgerError(
                f"task {task_id} was interrupted during review; "
                f"run orrery-task review {task_id}"
            )
    if state in {"DISPATCH_FAILED", "INTERRUPTED", "VERIFICATION_FAILED", "REVIEW_BLOCKED"}:
        previous = next((r for r in reversed(records) if r.get("worktree_fingerprint")), None)
        candidate = worktree_path(root, task_id)
        if previous and candidate.exists() and git_workspace_fingerprint(candidate) != previous["worktree_fingerprint"] and not accept_changed:
            raise LedgerError("task worktree changed; use --accept-changed-worktree")
        with control_lock(root) as locked:
            state = current(locked, task_id)[1]
            append_record(locked, task_id, {"from": state, "to": "READY", "actor": "user", "reason": "retry", "contract_digest": records[-1]["contract_digest"]})
        records, state = current(store, task_id)
    if state != "READY":
        raise LedgerError(f"task {task_id} is {state}")
    previous = next(
        (r for r in reversed(records) if r.get("worktree_fingerprint")), None
    )
    candidate_worktree = worktree_path(root, task_id)
    if (
        previous
        and candidate_worktree.exists()
        and git_workspace_fingerprint(candidate_worktree)
        != previous["worktree_fingerprint"]
        and not accept_changed
    ):
        raise LedgerError("task worktree changed; use --accept-changed-worktree")
    dirty = git(root, "status", "--porcelain").stdout
    if dirty and not allow_dirty:
        raise LedgerError("baseline worktree is dirty; use --allow-dirty-baseline")
    grant = under_broad_grant(root)
    if grant and os.environ.get("ORRERY_ALLOW_TMP_REPOSITORY") != "1":
        raise LedgerError(
            f"this repository is under {grant}, which every contained run is "
            "granted so the provider CLIs can build their sandbox mount "
            "points. Its .orrery store is therefore writable by a delegate, "
            "which would let one forge the ledger, an evidence packet, or a "
            "memory fact that later runs are handed as verified. Move the "
            "repository outside " + grant + ", or set "
            "ORRERY_ALLOW_TMP_REPOSITORY=1 to accept that."
        )
    fingerprint = git_workspace_fingerprint(root)
    # Read, check, reserve, append: one control transaction. Splitting it
    # would let two overlapping candidates both pass an unlocked scan and
    # then append serially, admitting both.
    with control_lock(root) as locked:
        records, state = current(locked, task_id)
        if state != "READY":
            raise LedgerError(f"task {task_id} is {state}")
        digest = records[-1]["contract_digest"]
        contract_path = locked / "contracts" / f"{task_id}.json"
        try:
            contract_bytes = contract_path.read_bytes()
            contract = json.loads(contract_bytes)
        except (OSError, json.JSONDecodeError) as exc:
            raise LedgerError("task contract is unreadable") from exc
        if hashlib.sha256(contract_bytes).hexdigest() != digest:
            raise LedgerError("task contract digest differs from READY record; amend the task")
        from orrery_ledger import validate_contract  # noqa: E402
        contract = validate_contract(contract, task_id)

        # The base comes from the contract's own target, never from an
        # unqualified HEAD: a topic branch carrying a dependency plus
        # unrelated commits would otherwise satisfy both the same-target
        # and ancestry checks, and speculative integration would import
        # the unrelated commits with it.
        target = contract["target_ref"]
        symbolic = git(root, "symbolic-ref", "--quiet", "HEAD").stdout.strip() or "detached"
        if symbolic != target:
            raise LedgerError(
                f"checked-out ref is {symbolic}, not the contract's target {target}"
            )
        resolved = git(root, "rev-parse", "--verify", "--quiet", target)
        base = resolved.stdout.strip()
        if resolved.returncode != 0 or not base:
            raise LedgerError(f"target ref {target} does not resolve")

        # Every guard resolves to one refusal so the decision can be
        # recorded before it is raised. A ledger that keeps only the
        # dispatches that ran describes a selected sample, and no later
        # question about whether more agents would have helped can be
        # asked of it honestly.
        cap = concurrency_cap(root)
        running = active_dispatches(locked, task_id)
        spend = spend_so_far(records)
        counters = {
            "dispatches": dispatch_count(records),
            "spend_total": spend["total"],
            "spend_unknown": bool(spend["unknown"]),
            "active": [other for other, _state in running],
            "cap": cap,
        }
        refusal: tuple[str, str] | None = None
        blocked_by: str | None = None
        conflict = scope_conflict(locked, task_id, contract["scope"]["include"])
        if conflict:
            refusal = ("scope", conflict)
        elif waiting := dependency_conflict(root, locked, contract, base):
            refusal = ("dependency", waiting)
        elif len(running) >= cap:
            named = ", ".join(f"{other} ({state})" for other, state in running)
            refusal = (
                "concurrency",
                f"{len(running)} of {cap} dispatch slots are in use by {named}",
            )
        else:
            refusal = budget_conflict(contract, records)
        if refusal:
            guard, detail = refusal
            blocked_by = next(
                (other for other, _state in running if other in detail), None
            )
            append_record(
                locked,
                task_id,
                {
                    "from": "READY",
                    "to": "READY",
                    "actor": "user",
                    "reason": "REFUSED",
                    "contract_digest": digest,
                    "decision": {
                        "guard": guard,
                        "detail": detail,
                        "counters": counters,
                        "blocked_by": blocked_by,
                    },
                },
            )
            raise LedgerError(f"task {task_id} cannot start: {detail}")

        sequence = 1 + sum(r["to"] == "DISPATCHED" for r in records)
        dispatch_root = root / ".orrery" / "dispatch"
        sequence_dir = dispatch_root / task_id / str(sequence)
        for component in (root / ".orrery", dispatch_root, dispatch_root / task_id, sequence_dir):
            if component.is_symlink():
                raise LedgerError(f"dispatch path is a symlink: {component}")
        if sequence_dir.exists():
            raise LedgerError(f"dispatch attempt already exists: {sequence_dir}")
        sequence_dir.mkdir(mode=0o700, parents=True)
        attempt = sequence_dir / "attempt-1"
        try:
            attempt.mkdir(mode=0o700)
        except FileExistsError as exc:
            raise LedgerError(f"dispatch attempt already exists: {attempt}") from exc
        role = load_role(contract["assigned_role"], cwd=root)
        # Selected once, here, while the lock is held. Memory is mutable
        # and the prompt used to be generated twice, once for the file
        # and once for the child's stdin; an admission or a refutation
        # between the two would have made the run's real assignment
        # differ from the durable record of it.
        facts = orrery_memory.current_facts(root)
        prompt = attempt.parent / "prompt.txt"
        prompt_bytes = handoff(contract, facts).encode()
        _atomic_write(prompt, prompt_bytes, 0o600)
        _atomic_write(
            attempt.parent / "launch.json",
            (
                json.dumps(
                    {
                        "v": 1,
                        "controller_pid": os.getpid(),
                        "controller_start": process_start_time(os.getpid()),
                    }
                )
                + "\n"
            ).encode(),
            0o600,
        )
        branch = f"orrery/{task_id}"
        append_record(
            locked,
            task_id,
            {
                "from": "READY",
                "to": "DISPATCHED",
                "actor": "user",
                "reason": None,
                "gate": {
                    "base_head": base,
                    "symbolic_ref": symbolic,
                    "dirty_fingerprint": fingerprint,
                    "dirty_baseline": allow_dirty,
                },
                "dispatch": {
                    "seq": sequence,
                    "receipts": str(attempt),
                    "worktree": str(candidate_worktree),
                    "branch": branch,
                    "git_common_dir": "",
                },
                "decision": {
                    "guard": "admitted",
                    "detail": "every admission guard passed",
                    "counters": counters,
                    "blocked_by": None,
                },
                # What this run was actually told, recoverable rather
                # than inferred from a store that has since moved on.
                "memory": {
                    "facts": [
                        {"id": fact["id"], "digest": orrery_memory.fact_digest(fact)}
                        for fact in facts
                    ],
                    "prompt_sha256": hashlib.sha256(prompt_bytes).hexdigest(),
                },
                "contract_digest": digest,
            },
        )
    worktree = ensure_worktree(root, task_id, base)
    with control_lock(root) as locked:
        append_record(
            locked,
            task_id,
            {
                "from": "DISPATCHED",
                "to": "IN_PROGRESS",
                "actor": "runner",
                "reason": "attempt",
                "attempt": 1,
                # Taken here, where the worktree first exists, and
                # compared before the runner runs git in it again.
                "git_identity": worktree_git_identity(worktree, branch),
                **role_data(role),
                "contract_digest": digest,
            },
        )
    command = [
        sys.executable,
        str(Path(__file__).with_name("orrery-review")),
        "--role",
        role.id,
        "--workspace",
        str(worktree),
        "--receipts",
        str(attempt),
    ]
    if (
        "--timeout" not in forwarded
        and not any(x.startswith("--timeout=") for x in forwarded)
        and contract.get("budget", {}).get("timeout_seconds")
    ):
        command += ["--timeout", str(contract["budget"]["timeout_seconds"])]
    if (
        "--hard-timeout" not in forwarded
        and not any(x.startswith("--hard-timeout=") for x in forwarded)
        and contract.get("budget", {}).get("hard_timeout_seconds")
    ):
        command += ["--hard-timeout", str(contract["budget"]["hard_timeout_seconds"])]
    process = subprocess.Popen(
        command + forwarded,
        cwd=root,
        stdin=subprocess.PIPE,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    stderr_tail: list[str] = []

    def tee_stderr() -> None:
        # Prefixed with the task, because two dispatches may now interleave
        # on one terminal and an unattributed line is worse than no line.
        assert process.stderr is not None
        for line in process.stderr:
            sys.stderr.write(f"[{task_id}] {line}" if line.strip() else line)
            sys.stderr.flush()
            stderr_tail.append(line)
            if len(stderr_tail) > 80:
                del stderr_tail[0]

    reader = threading.Thread(target=tee_stderr)
    reader.start()
    try:
        assert process.stdin is not None
        # The snapshot itself, not a re-read of a file another process
        # could have replaced after its digest was recorded.
        process.stdin.write(prompt_bytes.decode())
        process.stdin.close()
    except OSError:
        pass
    returncode = process.wait()
    reader.join(timeout=10)
    dispatch_record = next(record for record in reversed(current(store, task_id)[0]) if "dispatch" in record)
    # The role that ran, which is not the configured one when the
    # wrapper fell over to another provider partway through.
    ran = ran_role(attempt, contract, root)
    if returncode == 2:
        return complete_dispatch(root, task_id, contract, dispatch_record, attempt, worktree, ran, 2, stderr_tail)
    return complete_dispatch(root, task_id, contract, dispatch_record, attempt, worktree, ran, returncode, stderr_tail)


def rerun_verify(root: Path, task_id: str) -> int:
    store = root / ".orrery"
    contract = load_contract(store, task_id)
    records, state = current(store, task_id)
    if state not in {"IMPLEMENTED", "VERIFICATION_FAILED", "NO_CHANGE"}:
        raise LedgerError(f"task {task_id} is {state}")
    dispatch = next(r["dispatch"] for r in reversed(records) if "dispatch" in r)
    sequence = dispatch["seq"]
    worktree = Path(dispatch["worktree"])
    base = next(
        (r["commit"] for r in reversed(records) if r.get("commit")),
        git(worktree, "rev-parse", "HEAD").stdout.strip(),
    )
    existing = evidence_path(root, task_id, sequence)
    try:
        packet = json.loads(existing.read_text())
    except (OSError, json.JSONDecodeError):
        packet = {
            "v": 1,
            "task_id": task_id,
            "dispatch_seq": sequence,
            "contract_digest": records[-1]["contract_digest"],
            "verification": [],
            "worker_claim": "",
        }
    return verify(
        root,
        store,
        task_id,
        contract,
        sequence,
        worktree,
        base,
        base,
        packet,
        state == "NO_CHANGE",
    )


def resume_task(root: Path, task_id: str) -> int:
    store = root / ".orrery"
    records, state = current(store, task_id)
    if state not in {"DISPATCHED", "IN_PROGRESS", "IN_REVIEW"}:
        print(f"{task_id} {state}")
        return 0
    dispatch_record = next(record for record in reversed(records) if "dispatch" in record)
    dispatch = dispatch_record["dispatch"]
    attempt = Path(dispatch["receipts"])
    worktree = Path(dispatch["worktree"])
    if dispatch_alive(attempt):
        print(f"{task_id} still running")
        return 0
    if not (attempt / "unit.json").exists() and launch_alive(attempt):
        print(f"{task_id} still starting")
        return 0
    contract = load_contract(store, task_id)
    digest = dispatch_record["contract_digest"]
    if (attempt / "receipt.json").exists():
        role = ran_role(attempt, contract, root)
        if state == "DISPATCHED":
            with control_lock(root) as locked:
                append_record(locked, task_id, {"from": "DISPATCHED", "to": "IN_PROGRESS", "actor": "runner", "reason": "attempt", "attempt": 1, **role_data(role), "contract_digest": digest})
        result = complete_dispatch(root, task_id, contract, dispatch_record, attempt, worktree, role, 0)
        print(f"{task_id} {'completed' if result == 0 else 'dispatch failed'}")
        return result
    partial = None
    if worktree.exists() and git(worktree, "status", "--porcelain").stdout:
        path = attempt.parent / "partial.patch"
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        _atomic_write(path, git(worktree, "diff").stdout.encode(), 0o600)
        partial = rel(root, path)
    # An interruption is exactly the case a ceiling must not misread: the
    # attempt record exists because a provider was started, and the
    # receipt is missing because the run never finished. Without this the
    # ledger held no spend for it and the next dispatch passed a token
    # ceiling it had already crossed.
    interrupted_spend = orrery_spend.spend_of(orrery_spend.read_attempts(attempt))
    with control_lock(root) as locked:
        latest = current(locked, task_id)[1]
        append_record(locked, task_id, {"from": latest, "to": "INTERRUPTED", "actor": "runner", "contract_digest": digest, "worktree_fingerprint": git_workspace_fingerprint(worktree), "partial": partial, "spend": interrupted_spend})
    print(f"{task_id} interrupted")
    return 0




DISPATCH_ACTIVE_STATES = frozenset({"DISPATCHED", "IN_PROGRESS", "IN_REVIEW"})


def concurrency_cap(root: Path) -> int:
    """How many dispatches may run at once, from the manifest.

    A ceiling rather than a target: scopes must still be disjoint, and the
    binding constraint is usually the provider's rate limit rather than
    this machine. One restores the single-task behaviour of Phase 1.
    """
    default = 2
    # An override, as the verification budget has: without it the cap can
    # only be exercised by editing the shipped manifest, so the test that
    # was meant to prove it enforced proved nothing instead.
    override = os.environ.get("ORRERY_MAX_CONCURRENT_TASKS")
    if override:
        try:
            value = int(override)
        except ValueError as exc:
            raise LedgerError(
                "ORRERY_MAX_CONCURRENT_TASKS must be an integer"
            ) from exc
        if not 1 <= value <= 8:
            raise LedgerError(
                f"ORRERY_MAX_CONCURRENT_TASKS {value} is outside 1..8"
            )
        return value
    try:
        from orrery_runtime import MANIFEST_PATH  # noqa: E402
        manifest = json.loads(MANIFEST_PATH.read_text())
        value = manifest["max_concurrent_tasks"]
        low, high = 1, 8
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
        return default
    if isinstance(value, bool) or not isinstance(value, int):
        raise LedgerError("max_concurrent_tasks must be an integer")
    if not isinstance(low, int) or not isinstance(high, int) or not low <= value <= high:
        raise LedgerError(
            f"max_concurrent_tasks {value} is outside its bounds {low}..{high}"
        )
    return value


def active_dispatches(store: Path, exclude: str | None = None) -> list[tuple[str, str]]:
    active: list[tuple[str, str]] = []
    for other in task_ids(store):
        if other == exclude:
            continue
        try:
            state = current(store, other)[1]
        except LedgerError:
            continue
        if state in DISPATCH_ACTIVE_STATES:
            active.append((other, state))
    return active


def spend_so_far(records: list[dict]) -> dict:
    """Everything this task is known to have spent, and what is not known.

    Read from the ledger rather than from receipts, because the ceiling
    is enforced inside the control lock and a scan of the filesystem
    there would be both slower and racy against a reclaim.
    """
    tokens = orrery_spend.empty_tokens()
    unknown: list[str] = []
    for record in records:
        spend = record.get("spend")
        if not isinstance(spend, dict):
            continue
        for name, value in (spend.get("tokens") or {}).items():
            if name in tokens and isinstance(value, int) and not isinstance(value, bool):
                tokens[name] += max(0, value)
        if spend.get("unknown"):
            unknown.extend(spend.get("gaps") or ["usage was not recorded"])
    return {"tokens": tokens, "total": sum(tokens.values()), "unknown": unknown}


def dispatch_count(records: list[dict]) -> int:
    return sum(1 for record in records if record.get("to") == "DISPATCHED")


def budget_conflict(contract: dict, records: list[dict]) -> tuple[str, str] | None:
    """Which ceiling refuses this dispatch, and why, or nothing.

    Only the ceilings this contract actually sets are consulted, so a
    contract written before this phase decides exactly as it did before.
    The token ceiling bounds new dispatches: a run already in flight
    cannot be truncated, so one dispatch may cross it, and the refusal
    says so rather than implying a hard cap.
    """
    budget = contract.get("budget") or {}
    ceiling = budget.get("dispatches")
    used = dispatch_count(records)
    if isinstance(ceiling, int) and used >= ceiling:
        return (
            "budget-dispatches",
            f"{used} of {ceiling} dispatches are already spent; "
            "amend budget.dispatches or close the task",
        )
    ceiling = budget.get("tokens")
    if isinstance(ceiling, int):
        spend = spend_so_far(records)
        if spend["unknown"]:
            return (
                "spend-unknown",
                "a previous attempt started a provider run whose usage was "
                f"not recovered ({spend['unknown'][0]}), so the remaining "
                "budget is unknown; reconcile the attempt records or amend "
                "budget.tokens",
            )
        if spend["total"] >= ceiling:
            return (
                "budget-tokens",
                f"{spend['total']} of {ceiling} tokens are already spent; "
                "the ceiling bounds new dispatches rather than truncating "
                "one in flight, so amend budget.tokens to continue",
            )
    return None


def waiting_reason(root: Path, store: Path, task_id: str, state: str) -> str:
    """What this task is waiting on, in one clause, or nothing.

    A stalled graph should be legible from `status` rather than by
    reading the ledger, which is the whole reason a graph is allowed to
    exist in this phase.
    """
    if state != "READY":
        lease = None
        try:
            lease = task_merge_lease(current(store, task_id)[0])
        except LedgerError:
            pass
        if lease and lease_holder_alive(lease):
            return "(merging)"
        if lease:
            return "(merge lease held by a dead process; it clears on the next merge)"
        return ""
    try:
        contract = load_contract(store, task_id)
    except LedgerError:
        return ""
    conflict = scope_conflict(store, task_id, contract["scope"]["include"])
    if conflict:
        return f"(waiting: {conflict})"
    head = git(root, "rev-parse", "--verify", "--quiet", contract["target_ref"]).stdout.strip()
    if head:
        waiting = dependency_conflict(root, store, contract, head)
        if waiting:
            return f"(waiting: {waiting})"
    running = active_dispatches(store, task_id)
    if len(running) >= concurrency_cap(root):
        return f"(waiting: {len(running)} dispatch slots in use)"
    try:
        records = current(store, task_id)[0]
    except LedgerError:
        return "(ready to run)"
    if refusal := budget_conflict(contract, records):
        return f"(stopped: {refusal[1]})"
    return "(ready to run)"


def unreconciled_promotions(root: Path, store: Path, exclude: str, head: str) -> list[str]:
    """Tasks whose verified result is already in the target but unrecorded.

    A process that died between moving the ref and recording MERGED leaves
    work in the target with no durable record of it. Another task must not
    integrate over that: the union is computed from MERGED records, so the
    landed task's checks would simply be skipped.
    """
    pending: list[str] = []
    for other in task_ids(store):
        if other == exclude:
            continue
        try:
            records, state = current(store, other)
        except LedgerError as exc:
            raise LedgerError(f"cannot inspect {other} before merging: {exc}") from exc
        if state in TERMINAL:
            continue
        promotion = next(
            (
                record["integration"]
                for record in reversed(records)
                if record.get("integration", {}).get("outcome") == "verified"
            ),
            None,
        )
        landed = promotion.get("result_commit") if promotion else None
        if not landed:
            continue
        if is_ancestor(root, landed, head):
            pending.append(other)
    return pending


def is_ancestor(root: Path, ancestor: str, descendant: str) -> bool:
    """Whether one commit is an ancestor of another, or an error.

    git answers 0 for yes and 1 for no, and anything else is a failure to
    answer: 128 for an unknown object, for instance. Reading every nonzero
    exit as "no" fails open in both places this gates, permitting a merge
    or a cancellation precisely when ancestry could not be established.
    """
    result = git(root, "merge-base", "--is-ancestor", ancestor, descendant)
    if result.returncode == 0:
        return True
    if result.returncode == 1:
        return False
    raise LedgerError(
        f"could not determine whether {ancestor[:12]} is an ancestor of "
        f"{descendant[:12]}: git exited {result.returncode} "
        f"({result.stderr.strip() or 'no detail'})"
    )

def task_merge_lease(records: list[dict]) -> dict | None:
    """The merge lease this task holds, live or stale, or None."""
    for record in reversed(records):
        if record.get("to") in {"MERGED", "CLOSED", "CANCELLED"}:
            return None
        if record.get("reason") == "lease-released":
            return None
        lease = record.get("lease")
        if lease:
            return lease
    return None


def lease_holder_alive(lease: dict) -> bool:
    return process_start_time(lease.get("pid", -1)) == lease.get("start")


def live_merge_leases(store: Path, exclude: str) -> list[tuple[str, dict]]:
    """Every other task holding a merge lease whose holder still lives."""
    live: list[tuple[str, dict]] = []
    for other in task_ids(store):
        if other == exclude:
            continue
        try:
            records, _state = current(store, other)
        except LedgerError:
            continue
        lease = task_merge_lease(records)
        if lease and lease_holder_alive(lease):
            live.append((other, lease))
    return live


def integration_commands(
    root: Path, store: Path, task_id: str, contract: dict, base: str, head: str
) -> list[tuple[str, str, str]]:
    """The union of verification commands the merged result must satisfy.

    Running only the incoming contract's commands would let a task that
    breaks an invariant covered solely by an already-merged task's checks
    merge anyway. The union is exactly the incoming commands plus those of
    every task whose merge landed on this target after this task's base:
    already recorded, already sealed, and bounded by what actually
    changed.
    """
    commands = [
        (task_id, entry["id"], entry["verification"])
        for entry in contract["acceptance_criteria"]
    ]
    for other in task_ids(store):
        if other == task_id:
            continue
        try:
            records, _state = current(store, other)
        except LedgerError as exc:
            raise LedgerError(
                f"cannot tell whether {other} merged into this target: {exc}"
            ) from exc
        merged = next(
            (r.get("merge_commit") for r in reversed(records) if r.get("to") == "MERGED"),
            None,
        )
        if not merged:
            continue
        # Landed on this target, and after our base.
        if not is_ancestor(root, merged, head):
            continue
        if is_ancestor(root, merged, base):
            continue
        try:
            theirs = load_contract(store, other)
        except LedgerError as exc:
            raise LedgerError(
                f"{other} merged into this target but its contract cannot be "
                f"read, so its checks cannot be honoured: {exc}"
            ) from exc
        commands.extend(
            (other, entry["id"], entry["verification"])
            for entry in theirs["acceptance_criteria"]
        )
    return commands


def integration_worktree(root: Path, task_id: str, head: str, attempt: int) -> Path:
    """A throwaway checkout of the target head to merge into.

    Named per attempt: a shared path let a second run of the same task
    remove the first's tree from under it.
    """
    path = worktree_path(root, task_id).with_name(f"{task_id}-integration-{attempt}")
    if path.exists():
        git(root, "worktree", "remove", "--force", str(path))
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    result = git(root, "worktree", "add", "--detach", "--quiet", str(path), head)
    if result.returncode != 0:
        raise LedgerError(f"could not prepare an integration worktree: {result.stderr.strip()}")
    return path


def conflicting_paths(scratch: Path) -> list[str]:
    status = git(scratch, "status", "--porcelain").stdout.splitlines()
    return sorted(
        line[3:].strip()
        for line in status
        if line[:2] in {"UU", "AA", "DU", "UD", "AU", "UA", "DD"}
    )

def sequence_of(records: list[dict]) -> int:
    return sum(1 for r in records if r.get("to") == "DISPATCHED") or 1


def merge_task(root: Path, task_id: str, flags: list[str], attempts: int = 3) -> int:
    """Merge, re-integrating against a moved target rather than giving up.

    A target that moves during integration is the ordinary case under
    parallelism, so the loser retries against the new head. Bounded,
    because an unbounded retry against a busy target is a spin.
    """
    for remaining in range(attempts - 1, -1, -1):
        try:
            return _merge_once(root, task_id, flags)
        except LedgerError as exc:
            retryable = "target moved during integration" in str(exc)
            if not retryable or remaining == 0:
                raise
            print(
                f"orrery-task: {task_id} lost the target head; re-integrating "
                f"against the new one ({remaining} attempt(s) left)",
                file=sys.stderr,
            )
    raise LedgerError("unreachable")


def _merge_once(root: Path, task_id: str, flags: list[str]) -> int:
    store = root / ".orrery"
    records, state = current(store, task_id)
    if state != "AWAITING_MERGE":
        raise LedgerError(f"task {task_id} is {state}; merge requires AWAITING_MERGE")
    substantive = next(
        (
            record
            for record in reversed(records)
            if record.get("reason") != "ledger-repaired"
        ),
        None,
    )
    # Reconciliation reads the durable order backwards. The order is:
    # write the integration packet, record INTEGRATION_VERIFIED naming the
    # result commit, promote the ref, record MERGED. So a target head that
    # equals a recorded result commit is a promotion whose record never
    # landed, and completing it is the only correct move. An
    # INTEGRATION_VERIFIED whose result never became the head, with a dead
    # lease, is a failed promotion: that task re-integrates.
    verified_integration = next(
        (
            record["integration"]
            for record in reversed(records)
            if record.get("integration", {}).get("outcome") == "verified"
        ),
        None,
    )
    if verified_integration:
        reconcile_contract = load_contract(store, task_id)
        reconcile_target = reconcile_contract["target_ref"]
        current_head = git(
            root, "rev-parse", "--verify", "--quiet", reconcile_target
        ).stdout.strip()
        # By ancestry, and recording the commit that was actually
        # promoted. Requiring equality with the current head meant that a
        # merge landing on top turned a completed promotion back into a
        # re-integration, which then recorded a newer head: a later target
        # containing the original result but not that newer commit would
        # have omitted this task's checks from its union.
        landed = verified_integration.get("result_commit")
        if current_head and landed and is_ancestor(root, landed, current_head):
            # The work is already in the target, so refusing here would
            # not undo it: it would leave a promotion no record accounts
            # for, which every later union computation then mis-reads.
            # A contract sealed before the risk rule can reach this, so
            # the breach is recorded and reported rather than swallowed,
            # and the reconciliation completes.
            breach = risk_review_refusal(reconcile_contract)
            record = {"from": "AWAITING_MERGE", "to": "MERGED", "actor": "user", "reason": "reconciled", "merge_commit": landed, "contract_digest": records[-1]["contract_digest"], "integration": verified_integration}
            if breach:
                record["risk_breach"] = breach
            with control_lock(root) as locked:
                state_now = current(locked, task_id)[1]
                if state_now == "AWAITING_MERGE":
                    append_record(locked, task_id, record)
            print(f"orrery-task: {task_id} was promoted before its record landed; completed it")
            if breach:
                print(
                    f"orrery-task: {task_id} landed without a review decision "
                    f"and cannot be un-landed: {breach}",
                    file=sys.stderr,
                )
            return 1 if breach else 0
    stale = task_merge_lease(records)
    if stale and not lease_holder_alive(stale):
        with control_lock(root) as locked:
            append_record(locked, task_id, {"from": "AWAITING_MERGE", "to": "AWAITING_MERGE", "actor": "user", "reason": "lease-released", "detail": "holder is gone", "contract_digest": records[-1]["contract_digest"]})
        records, _state = current(store, task_id)
    evidence = next((r.get("evidence") for r in reversed(records) if r.get("evidence")), None)
    if not evidence:
        raise LedgerError("latest evidence packet is missing")
    try:
        packet = json.loads((root / evidence).read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise LedgerError("latest evidence packet is unreadable") from exc
    contract = load_contract(store, task_id)
    digest = records[-1]["contract_digest"]
    if hashlib.sha256((store / "contracts" / f"{task_id}.json").read_bytes()).hexdigest() != digest:
        raise LedgerError("current contract does not match the ledger; amend the task")
    if packet.get("contract_digest") != digest:
        raise LedgerError("evidence contract digest does not match current contract")
    verified = next((record for record in reversed(records) if record.get("to") == "VERIFICATION_PASSED"), None)
    if not verified or verified.get("evidence") != evidence:
        raise LedgerError("latest evidence was not verified")
    if verified.get("evidence_sha256") != evidence_digest(root, evidence):
        raise LedgerError("evidence packet digest does not match verification record")
    # Anchored on the findings, never on a verdict. A finding raised
    # before a rework round is still unresolved after it, however clean a
    # later review looks, so this survives exactly the route that would
    # otherwise drop it.
    outstanding = unresolved_blocking(records)
    if outstanding:
        named = ", ".join(f"{f['id']} ({f['statement'][:60]})" for f in outstanding)
        raise LedgerError(f"unresolved blocking finding: {named}")
    # Also at the gate, not only at seal: a contract sealed before this
    # rule existed would otherwise merge declared high-risk work with no
    # review and no waiver.
    if refusal := risk_review_refusal(contract):
        raise LedgerError(refusal)
    dispatched = next(record for record in reversed(records) if "dispatch" in record)
    base = dispatched["gate"]["base_head"]
    implemented = next((record for record in reversed(records) if record.get("commit")), None)
    if not implemented:
        raise LedgerError("implemented commit is missing")
    commit = implemented["commit"]
    # -z, because a rename carries both its source and destination and the
    # tab-splitting form kept only one of them: a rename out of a held path
    # would have gone unnoticed.
    raw = git(root, "diff", "--name-status", "-z", f"{base}..{commit}").stdout
    fields = [field for field in raw.split("\0") if field]
    changed: list[str] = []
    index = 0
    while index < len(fields):
        status = fields[index]
        following = 2 if status[:1] in {"R", "C"} else 1
        changed.extend(fields[index + 1: index + 1 + following])
        index += 1 + following
    include, exclude = contract["scope"]["include"], contract["scope"]["exclude"]
    out = [
        path for path in changed
        if not any(paths_overlap(path, entry) for entry in include)
        or any(paths_overlap(path, entry) for entry in exclude)
    ]
    if out and "--accept-out-of-scope" not in flags:
        raise LedgerError("evidence has out-of-scope changes; use --accept-out-of-scope")
    if out:
        # The override is the operator's to give, but it cannot be given
        # over another live task's files: that would force a holder into
        # the conflict admission exists to prevent, discovered only at
        # its own merge.
        trespass = [
            (path, other, state)
            for path in out
            for other, state, held in scope_holders(store, task_id)
            for claimed in held
            if paths_overlap(path, claimed)
        ]
        if trespass:
            named = "; ".join(
                f"{path} is held by {other} ({state})"
                for path, other, state in trespass
            )
            raise LedgerError(
                f"--accept-out-of-scope cannot be given over another task's "
                f"files: {named}"
            )
    target = contract["target_ref"]
    if git(root, "symbolic-ref", "--quiet", "HEAD").stdout.strip() != target:
        raise LedgerError("target branch is not checked out")
    if git(root, "status", "--porcelain").stdout:
        raise LedgerError("target worktree is dirty")
    branch = f"orrery/{task_id}"
    if git(root, "rev-parse", branch).stdout.strip() != commit:
        raise LedgerError("task branch no longer matches evidence")

    # Take the lease. The target may have moved since this task branched,
    # which is the ordinary case under parallelism and no longer a reason
    # to refuse; what is refused is another live merge, and a target that
    # no longer descends from this task's base.
    with control_lock(root) as locked:
        state = current(locked, task_id)[1]
        if state != "AWAITING_MERGE":
            raise LedgerError(f"task {task_id} is {state}; merge requires AWAITING_MERGE")
        mine = task_merge_lease(current(locked, task_id)[0])
        if mine and lease_holder_alive(mine):
            raise LedgerError(
                f"task {task_id} is already being merged by pid {mine['pid']}"
            )
        others = live_merge_leases(locked, task_id)
        if others:
            held, _lease = others[0]
            raise LedgerError(f"task {held} holds a live merge lease; retry when it finishes")
        head = git(root, "rev-parse", "--verify", "--quiet", target).stdout.strip()
        if not head:
            raise LedgerError(f"target ref {target} does not resolve")
        # A rewound or rewritten target is an operator event, never
        # something to merge across silently.
        unrecorded = unreconciled_promotions(root, locked, task_id, head)
        if unrecorded:
            named = ", ".join(unrecorded)
            raise LedgerError(
                f"the target carries work from {named} whose merge was never "
                f"recorded; run orrery-task merge on {unrecorded[0]} to reconcile "
                "it first, or its checks will be missing from this integration"
            )
        if not is_ancestor(root, base, head):
            raise LedgerError(
                f"target {target} no longer descends from this task's base "
                f"{base[:12]}; it was rewound or rewritten, so rework is your call"
            )
        lease = {"pid": os.getpid(), "start": process_start_time(os.getpid()), "head": head}
        attempt = 1 + sum(
            1 for r in current(locked, task_id)[0] if r.get("integration")
        )
        append_record(locked, task_id, {"from": "AWAITING_MERGE", "to": "AWAITING_MERGE", "actor": "user", "reason": "merge-started", "expected": {"base": base, "commit": commit, "head": head}, "lease": lease, "attempt": attempt, "contract_digest": digest})

    scratch = None
    try:
        scratch = integration_worktree(root, task_id, head, attempt)
        merged = git(
            scratch,
            "-c", "user.email=orrery@invalid", "-c", "user.name=Orrery",
            "merge", "--no-ff", "--no-edit", commit,
        )
        if merged.returncode != 0:
            paths = conflicting_paths(scratch)
            holders = {
                other: [p for p in paths if any(paths_overlap(p, inc) for inc in held)]
                for other, _state, held in scope_holders(root / ".orrery", task_id)
            }
            # A task merged since our base is terminal and holds no scope,
            # yet it is the likeliest author of a conflict on the target
            # side, so it is named from its sealed contract instead.
            for owner in {o for o, _c, _v in integration_commands(root, root / ".orrery", task_id, contract, base, head) if o != task_id}:
                try:
                    theirs = load_contract(root / ".orrery", owner)
                except LedgerError:
                    continue
                claimed = [
                    path for path in paths
                    if any(paths_overlap(path, inc) for inc in theirs["scope"]["include"])
                ]
                if claimed:
                    holders.setdefault(owner, []).extend(claimed)
            named = ", ".join(paths) or "unknown paths"
            claims = "; ".join(
                f"{other} holds {', '.join(claimed)}"
                for other, claimed in holders.items() if claimed
            )
            detail = f"integration conflict on {named}" + (f" ({claims})" if claims else "")
            with control_lock(root) as locked:
                append_record(locked, task_id, {"from": "AWAITING_MERGE", "to": "AWAITING_MERGE", "actor": "user", "reason": "lease-released", "integration": {"attempt": attempt, "outcome": "conflict", "head": head, "paths": paths, "detail": detail}, "contract_digest": digest})
            raise LedgerError(detail)

        result_commit = git(scratch, "rev-parse", "HEAD").stdout.strip()
        union = integration_commands(root, root / ".orrery", task_id, contract, base, head)
        outcomes = []
        failed = None
        for owner, criterion, verification in union:
            command = verification["command"]
            workdir = scratch / verification.get("workdir", ".")
            before = git_workspace_fingerprint(scratch)
            status, log = run_verification(command, workdir)
            after = git_workspace_fingerprint(scratch)
            if before is None or after is None or after != before:
                status, log = 1, (
                    log + f"\n[{criterion} from {owner} modified the tree it "
                    "was verifying, or that could not be established; "
                    "refused]\n"
                )
            log_path = evidence_path(root, task_id, f"{sequence_of(records)}-integration-{attempt}-{owner}-{criterion}").with_suffix(".log")
            log_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            _atomic_write(log_path, log.encode(), 0o600)
            outcomes.append({"owner": owner, "criterion": criterion, "command": command, "workdir": verification.get("workdir", "."), "exit_status": status, "log": rel(root, log_path)})
            if status != 0 and failed is None:
                failed = f"{criterion} from {owner}"

        packet = {"v": 1, "task_id": task_id, "attempt": attempt, "target_ref": target, "target_head": head, "base": base, "branch_commit": commit, "result_commit": result_commit, "contract_digest": digest, "verification": outcomes}
        packet_path = evidence_path(root, task_id, f"{sequence_of(records)}-integration-{attempt}")
        packet_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        _atomic_write(packet_path, (json.dumps(packet, indent=2, sort_keys=True) + "\n").encode(), 0o600)
        packet_relative = rel(root, packet_path)
        integration = {"attempt": attempt, "head": head, "result_commit": result_commit, "evidence": packet_relative, "evidence_sha256": evidence_digest(root, packet_relative), "commands": sorted({owner for owner, _criterion, _v in union})}

        if failed is not None:
            with control_lock(root) as locked:
                append_record(locked, task_id, {"from": "AWAITING_MERGE", "to": "AWAITING_MERGE", "actor": "user", "reason": "lease-released", "integration": {**integration, "outcome": "failed", "failed": failed}, "contract_digest": digest})
            raise LedgerError(f"integration verification failed: {failed} (evidence {packet_relative})")

        with control_lock(root) as locked:
            append_record(locked, task_id, {"from": "AWAITING_MERGE", "to": "AWAITING_MERGE", "actor": "user", "reason": "integration-verified", "integration": {**integration, "outcome": "verified"}, "contract_digest": digest})
            # Promotion rechecks all three facts together: the task is
            # still awaiting merge, the lease is ours, and the target has
            # not moved under us. git's own compare-and-swap enforces the
            # last one even against a writer outside Orrery.
            fresh_records, fresh_state = current(locked, task_id)
            if fresh_state != "AWAITING_MERGE":
                raise LedgerError(f"task became {fresh_state} during integration; promotion abandoned")
            held = task_merge_lease(fresh_records)
            if not held or held.get("pid") != os.getpid():
                raise LedgerError("merge lease was lost during integration; promotion abandoned")
            # The root is rechecked here, not only before integration.
            # Integration can take minutes, and in that window the
            # operator may have checked out another branch or edited the
            # tree: promoting regardless would move their branch, and the
            # synchronising reset below would discard their work.
            checkout = git(root, "symbolic-ref", "--quiet", "HEAD").stdout.strip()
            if checkout != target:
                append_record(locked, task_id, {"from": "AWAITING_MERGE", "to": "AWAITING_MERGE", "actor": "user", "reason": "lease-released", "integration": {**integration, "outcome": "checkout-moved"}, "contract_digest": digest})
                raise LedgerError(
                    f"the checkout moved to {checkout or 'a detached head'} during "
                    f"integration; promotion abandoned, run merge again on {target}"
                )
            dirty = git(root, "status", "--porcelain")
            if dirty.returncode != 0 or dirty.stdout:
                append_record(locked, task_id, {"from": "AWAITING_MERGE", "to": "AWAITING_MERGE", "actor": "user", "reason": "lease-released", "integration": {**integration, "outcome": "worktree-dirty"}, "contract_digest": digest})
                raise LedgerError(
                    "the target worktree became dirty during integration, or its "
                    "state could not be read; promotion abandoned rather than "
                    "discarding your changes"
                )
            if out:
                # Rechecked here: a task may have acquired one of these
                # paths while this integration was running.
                trespass_now = [
                    (path, other)
                    for path in out
                    for other, _state, held in scope_holders(locked, task_id)
                    for claimed in held
                    if paths_overlap(path, claimed)
                ]
                if trespass_now:
                    append_record(locked, task_id, {"from": "AWAITING_MERGE", "to": "AWAITING_MERGE", "actor": "user", "reason": "lease-released", "integration": {**integration, "outcome": "out-of-scope-held"}, "contract_digest": digest})
                    named = "; ".join(f"{path} held by {other}" for path, other in trespass_now)
                    raise LedgerError(
                        f"another task acquired an out-of-scope path during "
                        f"integration: {named}"
                    )
            promoted = git(root, "update-ref", target, result_commit, head)
            if promoted.returncode != 0:
                append_record(locked, task_id, {"from": "AWAITING_MERGE", "to": "AWAITING_MERGE", "actor": "user", "reason": "lease-released", "integration": {**integration, "outcome": "target-moved"}, "contract_digest": digest})
                raise LedgerError("target moved during integration; run merge again to re-integrate")
            # The ref now names the verified commit while the worktree
            # still holds the pre-merge tree, so this is a real window:
            # synchronise and confirm it before recording the merge.
            synchronised = git(root, "reset", "--hard", "--quiet", result_commit)
            if synchronised.returncode != 0 or git(root, "rev-parse", "HEAD").stdout.strip() != result_commit:
                raise LedgerError(
                    f"the target ref advanced to {result_commit[:12]} but its "
                    f"worktree could not be synchronised: {synchronised.stderr.strip()}"
                )
            append_record(locked, task_id, {"from": "AWAITING_MERGE", "to": "MERGED", "actor": "user", "merge_commit": result_commit, "accepted_out_of_scope": "--accept-out-of-scope" in flags, "contract_digest": digest, "evidence": evidence, "integration": {**integration, "outcome": "verified"}})
        return 0
    finally:
        if scratch is not None and scratch.exists():
            git(root, "worktree", "remove", "--force", str(scratch))


def close_task(root: Path, task_id: str, flags: list[str]) -> int:
    with control_lock(root) as store:
        records, state = current(store, task_id)
        if state == "NO_CHANGE" and "--accept-no-change" not in flags:
            raise LedgerError("NO_CHANGE requires --accept-no-change")
        if state == "NO_CHANGE" and records[-1].get("reason") != "verification-passed":
            raise LedgerError("NO_CHANGE requires successful verification; run orrery-task verify")
        if state == "MERGED":
            record = {"from": state, "to": "CLOSED", "actor": "user", "contract_digest": records[-1]["contract_digest"]}
        elif state == "NO_CHANGE":
            record = {"from": state, "to": "CLOSED", "actor": "user", "reason": "accepted-no-change", "contract_digest": records[-1]["contract_digest"]}
        else:
            raise LedgerError(f"task {task_id} is {state}")
        append_record(store, task_id, record)
    return 0


def cancel_task(root: Path, task_id: str, flags: list[str]) -> int:
    store = root / ".orrery"
    records, state = current(store, task_id)
    if state in {"MERGED", "CLOSED"} or (state == "CANCELLED" and "--discard" not in flags):
        raise LedgerError(f"task {task_id} is {state}")
    if state in {"DISPATCHED", "IN_PROGRESS", "IN_REVIEW"}:
        attempt = Path(next(r["dispatch"]["receipts"] for r in reversed(records) if "dispatch" in r))
        if dispatch_alive(attempt):
            raise LedgerError("task is still running; resume first")
    # A merge lease is a live holder exactly as a dispatch is. Revoking one
    # out from under a running integration would leave a promoted target
    # with no legal transition left to record.
    with control_lock(root) as locked:
        records, state = current(locked, task_id)
        lease = task_merge_lease(records)
        if lease and lease_holder_alive(lease):
            raise LedgerError(
                f"task {task_id} holds a live merge lease (pid {lease['pid']}); "
                "wait for it to finish"
            )
        # A dead holder may have promoted before its record landed. The
        # target already carries this task, so cancelling over it would
        # record a lie; complete the merge instead and let the user close
        # or revert deliberately.
        promotion = next(
            (
                r["integration"]
                for r in reversed(records)
                if r.get("integration", {}).get("outcome") == "verified"
            ),
            None,
        )
        if promotion and state == "AWAITING_MERGE":
            try:
                target_ref = load_contract(locked, task_id)["target_ref"]
            except LedgerError:
                target_ref = None
            if target_ref:
                head_now = git(root, "rev-parse", "--verify", "--quiet", target_ref).stdout.strip()
                landed = promotion.get("result_commit")
                if head_now and landed and is_ancestor(root, landed, head_now):
                    append_record(locked, task_id, {"from": "AWAITING_MERGE", "to": "MERGED", "actor": "user", "reason": "reconciled", "merge_commit": landed, "contract_digest": records[-1]["contract_digest"], "integration": promotion})
                    raise LedgerError(
                        f"task {task_id} was already promoted as {landed[:12]}; "
                        "its merge has been recorded, so cancel is refused"
                    )
        if lease:
            append_record(locked, task_id, {"from": state, "to": state, "actor": "user", "reason": "lease-released", "detail": "holder is gone", "contract_digest": records[-1]["contract_digest"]})
        # The append happens in this same transaction. Inspecting under
        # one lock and cancelling under another leaves a window in which a
        # merge takes its lease between the two and is then cancelled
        # live, which is the state the liveness check exists to prevent.
        latest = current(locked, task_id)[1]
        if latest != "CANCELLED":
            append_record(locked, task_id, {"from": latest, "to": "CANCELLED", "actor": "user", "contract_digest": records[-1]["contract_digest"]})
    if "--discard" in flags:
        remaining = remove_worktree(root, task_id)
        if remaining:
            raise LedgerError("discard failed; remains: " + ", ".join(remaining))
    else:
        print(f"worktree remains at {worktree_path(root, task_id)}")
    return 0


def main(argv: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    if not arguments:
        return usage()
    command = arguments.pop(0)
    try:
        root = repository_root()
        if command == "create" and len(arguments) == 1:
            print(create_task(root, read_contract(arguments[0])))
            return 0
        if command == "amend" and len(arguments) == 2:
            amend_task(root, arguments[0], read_contract(arguments[1]))
            return 0
        if command == "run" and arguments:
            return dispatch(root, arguments.pop(0), arguments)
        if command == "verify" and len(arguments) == 1:
            return rerun_verify(root, arguments[0])
        if command == "review" and arguments:
            return review_task(root, arguments.pop(0), arguments)
        if command == "resume" and len(arguments) <= 1:
            store = root / ".orrery"
            identifiers = arguments or (task_ids(store) if store.exists() else [])
            result = 0
            for task_id in identifiers:
                result = max(result, resume_task(root, task_id))
            return result
        if command == "merge" and arguments:
            return merge_task(root, arguments.pop(0), arguments)
        if command == "close" and arguments:
            return close_task(root, arguments.pop(0), arguments)
        if command == "cancel" and arguments:
            return cancel_task(root, arguments.pop(0), arguments)
        store = root / ".orrery"
        if command == "list" and not arguments:
            if not store.exists():
                return 0
            for task_id in task_ids(store):
                contract = load_contract(store, task_id)
                records, torn, _ = read_ledger(store, task_id)
                print(
                    f"{task_id} {'TORN' if torn else records[-1]['to']} {contract['title']}"
                )
            return 0
        if command == "show" and len(arguments) == 1:
            contract = load_contract(store, arguments[0])
            records, torn, _ = read_ledger(store, arguments[0])
            print(json.dumps(contract, ensure_ascii=False, indent=2))
            print(
                json.dumps(
                    {"history": records, "torn_tail": torn},
                    ensure_ascii=False,
                    indent=2,
                )
            )
            # Why a merge is refused should be readable here rather than
            # only in .orrery/reviews. Every field is provider-derived
            # text reaching a person, so it goes through the same filter
            # the runner applies to delegate output.
            outstanding = unresolved_blocking(records)
            if outstanding:
                print("\nunresolved blocking findings:", file=sys.stderr)
                for finding in outstanding:
                    print(
                        "  "
                        + orrery_findings.sanitise_provider_text(
                            f"{finding['id']} ({finding.get('category', 'unknown')}) "
                            f"{finding['statement']}"
                        ),
                        file=sys.stderr,
                    )
            return 0
        if command == "status" and arguments in ([], ["--repair"]):
            if not store.exists():
                return 0
            if arguments:
                with control_lock(root) as locked:
                    for task_id in task_ids(locked):
                        if repair_ledger(locked, task_id):
                            print(f"{task_id} repaired")
                        print(f"{task_id} {read_ledger(locked, task_id)[0][-1]['to']}")
            else:
                for task_id in task_ids(store):
                    records, torn, _ = read_ledger(store, task_id)
                    state = records[-1]["to"]
                    print(f"{task_id} {state} {waiting_reason(root, store, task_id, state)}".rstrip())
                    if torn:
                        print(f"warning: {task_id} has a torn ledger tail")
                    # Declining review on declared high-risk work is
                    # allowed, but never quietly: it is the operator's
                    # decision and it stays visible for as long as the
                    # task does.
                    try:
                        contract = load_contract(store, task_id)
                    except LedgerError:
                        contract = None
                    if (
                        contract
                        and (contract.get("risk") or {}).get("level") == "high"
                        and contract.get("review") is False
                    ):
                        print(
                            f"  waiver: {task_id} declares high risk and "
                            "declines independent review"
                        )
                active = active_dispatches(store)
                cap = concurrency_cap(root)
                print(f"dispatches {len(active)}/{cap}")
            return 0
        return usage()
    except (LedgerError, RuntimeConfigError) as exc:
        print(f"orrery-task: {exc}", file=sys.stderr)
        return 2 if command == "run" and str(exc).startswith("invalid run argument:") else 1


if __name__ == "__main__":
    raise SystemExit(main())
